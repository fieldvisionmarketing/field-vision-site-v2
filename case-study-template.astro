---
/**
 * ══════════════════════════════════════════════════════════════════════════
 * CANONICAL CASE STUDY TEMPLATE — v2.1 (Animated)
 * ══════════════════════════════════════════════════════════════════════════
 * This is the single source of truth for the layout of every Field Vision
 * case study page. The reference implementation is Twitch Sells Out
 * (src/pages/case-studies/twitch-sells-out.astro). Arena, MONTREALITY, and
 * StreamU are also aligned to it.
 *
 * NOT A ROUTE: this file lives at the repo root (outside src/pages) so Astro
 * never builds it. To create a new case study, COPY this file into
 * src/pages/case-studies/<slug>.astro and replace every {{PLACEHOLDER}}.
 *
 * CANONICAL RULES (do not drift):
 * - Hero: .cs-hero-v2-wrapper > .cs-hero-v2-sticky#csHero > .cs-hero-v2-bg
 *   + .cs-hero-v2-content. The .cs-scroll-hint MUST live INSIDE
 *   .cs-hero-v2-content, directly after the .cs-hero-v2-summary <p>. Putting
 *   it outside the content div breaks hero alignment.
 * - Hero background: a real image via background-image:url(...) (shows on the
 *   right 50% at 0.2 opacity), OR the standard gradient fallback
 *   background:linear-gradient(135deg,#18271a,#2f4a2f) when no image exists.
 *   Never ship the literal placeholder URL.
 * - Feature video (optional): include the .cs-video-v2 section only when there
 *   is a video. Use the youtube-nocookie embed. Keep the <style> block below.
 * - Copy rules: no em-dashes or en-dashes anywhere (use periods/commas, "to"
 *   for ranges). Never position on price.
 * - Keep the <style> and <script> blocks verbatim. Add the new page's video
 *   selectors are already covered by the reveal observer.
 * ══════════════════════════════════════════════════════════════════════════
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import FinalCTA from '@/components/FinalCTA.astro';
import RelatedIndustry from '@/components/RelatedIndustry.astro';
// Optional: standard featured testimonial unit. Include only when there is a client quote.
import CaseStudyTestimonial from '@/components/CaseStudyTestimonial.astro';
---

<BaseLayout
  title="{{SEO_TITLE}} | Field Vision"
  description="{{META_DESCRIPTION}}"
>
  <Header slot="header" />

<!-- Scroll progress bar -->
<div class="cs-scroll-progress" id="csScrollProgress"></div>

<!-- ═══ HERO ═══ -->
<div class="cs-hero-v2-wrapper">
  <div class="cs-hero-v2-sticky" id="csHero">
    <!-- Real image: style="background-image:url('{{HERO_IMAGE_URL}}')"
         No image: style="background:linear-gradient(135deg,#18271a,#2f4a2f)" -->
    <div class="cs-hero-v2-bg" style="background:linear-gradient(135deg,#18271a,#2f4a2f)"></div>
    <div class="cs-hero-v2-content">
      <h1>{{HERO_HEADLINE_LINE_1}}<br>{{HERO_HEADLINE_LINE_2}} <span class="highlight-chip">{{CLIENT_NAME}}</span></h1>
      <p class="cs-hero-v2-summary">{{HERO_SUMMARY}}</p>
      <div class="cs-scroll-hint">Scroll to explore</div>
    </div>
  </div>
</div>

<!-- ═══ STATS ═══ -->
<section class="cs-stats-v2" id="csStats">
  <div class="cs-stats-v2-inner">
    <div class="cs-stat-drop">
      <div class="cs-stat-drop-num" data-target="{{STAT1_NUM}}" data-prefix="{{STAT1_PREFIX}}" data-suffix="{{STAT1_SUFFIX}}">{{STAT1_PREFIX}}0{{STAT1_SUFFIX}}</div>
      <div class="cs-stat-drop-label">{{STAT1_LABEL}}</div>
    </div>
    <div class="cs-stat-drop">
      <div class="cs-stat-drop-num" data-target="{{STAT2_NUM}}" data-prefix="{{STAT2_PREFIX}}" data-suffix="{{STAT2_SUFFIX}}">{{STAT2_PREFIX}}0{{STAT2_SUFFIX}}</div>
      <div class="cs-stat-drop-label">{{STAT2_LABEL}}</div>
    </div>
    <div class="cs-stat-drop">
      <div class="cs-stat-drop-num" data-target="{{STAT3_NUM}}" data-prefix="{{STAT3_PREFIX}}" data-suffix="{{STAT3_SUFFIX}}">{{STAT3_PREFIX}}0{{STAT3_SUFFIX}}</div>
      <div class="cs-stat-drop-label">{{STAT3_LABEL}}</div>
    </div>
    <div class="cs-stat-drop">
      <div class="cs-stat-drop-num" data-target="{{STAT4_NUM}}" data-prefix="{{STAT4_PREFIX}}" data-suffix="{{STAT4_SUFFIX}}">{{STAT4_PREFIX}}0{{STAT4_SUFFIX}}</div>
      <div class="cs-stat-drop-label">{{STAT4_LABEL}}</div>
    </div>
  </div>
</section>

<!-- ═══ FEATURE VIDEO (optional — include only if there is a video) ═══ -->
<section class="cs-video-v2" id="csVideo">
  <div class="cs-video-v2-inner">
    <span class="eyebrow">See It Live</span>
    <h2>{{VIDEO_HEADING}}</h2>
    <div class="cs-video-embed">
      <iframe
        src="https://www.youtube-nocookie.com/embed/{{YOUTUBE_ID}}?rel=0"
        title="{{VIDEO_TITLE}}"
        loading="lazy"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</section>

<!-- ═══ TESTIMONIAL (optional) — standard featured testimonial unit.
     Include when there is a client quote; remove this whole section if none.
     Sits right before Challenge, after Stats and the Feature Video. ═══ -->
<section class="cs-testimonial-band">
  <CaseStudyTestimonial
    quote="{{TESTIMONIAL_QUOTE}}"
    name="{{TESTIMONIAL_NAME}}"
    title="{{TESTIMONIAL_TITLE}}"
    image="/testimonials/{{TESTIMONIAL_IMAGE_FILE}}"
  />
</section>

<!-- ═══ CHALLENGE ═══ -->
<section class="cs-challenge-v2">
  <div class="cs-challenge-v2-inner">
    <span class="eyebrow">The Challenge</span>
    <h2>{{CHALLENGE_HEADLINE}}</h2>

    <div class="cs-fly-card">
      <span class="cs-fly-card-num">1</span>
      <span class="cs-fly-card-text"><strong>{{CHALLENGE_1_BOLD}}</strong> {{CHALLENGE_1_TEXT}}</span>
    </div>
    <div class="cs-fly-card">
      <span class="cs-fly-card-num">2</span>
      <span class="cs-fly-card-text"><strong>{{CHALLENGE_2_BOLD}}</strong> {{CHALLENGE_2_TEXT}}</span>
    </div>
    <div class="cs-fly-card">
      <span class="cs-fly-card-num">3</span>
      <span class="cs-fly-card-text"><strong>{{CHALLENGE_3_BOLD}}</strong> {{CHALLENGE_3_TEXT}}</span>
    </div>
    <div class="cs-fly-card">
      <span class="cs-fly-card-num">4</span>
      <span class="cs-fly-card-text"><strong>{{CHALLENGE_4_BOLD}}</strong> {{CHALLENGE_4_TEXT}}</span>
    </div>

    <div class="cs-mandate-drop">
      <span class="eyebrow">The Mandate</span>
      <blockquote>{{MANDATE_TEXT}}</blockquote>
    </div>
  </div>
</section>

<!-- ═══ APPROACH ═══ -->
<div class="cs-approach section">
  <div class="cs-section-inner">
    <span class="eyebrow">The Approach</span>
    <h2>{{APPROACH_HEADLINE}}</h2>
    <p class="cs-approach-insight">{{APPROACH_INSIGHT}}</p>

    <div class="cs-approach-grid">
      <div class="cs-phase-card">
        <div class="cs-phase-num">01</div>
        <div class="cs-phase-title">{{PHASE1_TITLE}}</div>
        <div class="cs-phase-desc">{{PHASE1_DESC}}</div>
        <div class="cs-phase-tools">
          <a href="{{PHASE1_SERVICE_HREF}}" class="cs-phase-tool">{{PHASE1_SERVICE_LABEL}} →</a>
        </div>
      </div>
      <div class="cs-phase-card">
        <div class="cs-phase-num">02</div>
        <div class="cs-phase-title">{{PHASE2_TITLE}}</div>
        <div class="cs-phase-desc">{{PHASE2_DESC}}</div>
        <div class="cs-phase-tools">
          <a href="{{PHASE2_SERVICE_HREF}}" class="cs-phase-tool">{{PHASE2_SERVICE_LABEL}} →</a>
        </div>
      </div>
      <div class="cs-phase-card">
        <div class="cs-phase-num">03</div>
        <div class="cs-phase-title">{{PHASE3_TITLE}}</div>
        <div class="cs-phase-desc">{{PHASE3_DESC}}</div>
        <div class="cs-phase-tools">
          <a href="{{PHASE3_SERVICE_HREF}}" class="cs-phase-tool">{{PHASE3_SERVICE_LABEL}} →</a>
        </div>
      </div>
      <div class="cs-phase-card">
        <div class="cs-phase-num">04</div>
        <div class="cs-phase-title">{{PHASE4_TITLE}}</div>
        <div class="cs-phase-desc">{{PHASE4_DESC}}</div>
        <div class="cs-phase-tools">
          <a href="{{PHASE4_SERVICE_HREF}}" class="cs-phase-tool">{{PHASE4_SERVICE_LABEL}} →</a>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ═══ RESULTS ═══ -->
<section class="cs-results section">
  <div class="cs-results-inner">
    <span class="eyebrow">The Results</span>
    <h2>{{RESULTS_HEADLINE}}</h2>

    <div class="cs-result-row">
      <div class="cs-result-row-num" data-target="{{RESULT1_NUM}}" data-prefix="{{RESULT1_PREFIX}}" data-suffix="{{RESULT1_SUFFIX}}"><span class="accent">{{RESULT1_PREFIX}}</span>0{{RESULT1_SUFFIX}}</div>
      <div>
        <div class="cs-result-label">{{RESULT1_LABEL}}</div>
        <div class="cs-result-desc">{{RESULT1_DESC}}</div>
      </div>
    </div>
    <div class="cs-result-row">
      <div class="cs-result-row-num" data-target="{{RESULT2_NUM}}" data-prefix="{{RESULT2_PREFIX}}" data-suffix="{{RESULT2_SUFFIX}}"><span class="accent">{{RESULT2_PREFIX}}</span>0{{RESULT2_SUFFIX}}</div>
      <div>
        <div class="cs-result-label">{{RESULT2_LABEL}}</div>
        <div class="cs-result-desc">{{RESULT2_DESC}}</div>
      </div>
    </div>
    <div class="cs-result-row">
      <div class="cs-result-row-num" data-target="{{RESULT3_NUM}}" data-prefix="{{RESULT3_PREFIX}}" data-suffix="{{RESULT3_SUFFIX}}"><span class="accent">{{RESULT3_PREFIX}}</span>0{{RESULT3_SUFFIX}}</div>
      <div>
        <div class="cs-result-label">{{RESULT3_LABEL}}</div>
        <div class="cs-result-desc">{{RESULT3_DESC}}</div>
      </div>
    </div>
    <div class="cs-result-row">
      <div class="cs-result-row-num" data-target="{{RESULT4_NUM}}" data-prefix="{{RESULT4_PREFIX}}" data-suffix="{{RESULT4_SUFFIX}}"><span class="accent">{{RESULT4_PREFIX}}</span>0{{RESULT4_SUFFIX}}</div>
      <div>
        <div class="cs-result-label">{{RESULT4_LABEL}}</div>
        <div class="cs-result-desc">{{RESULT4_DESC}}</div>
      </div>
    </div>
  </div>
</section>

<!-- ═══ IMPACT ═══ -->
<section class="cs-impact-v2">
  <div class="cs-impact-v2-inner">
    <span class="eyebrow">The Impact</span>
    <h2>{{IMPACT_HEADLINE}}</h2>

    <div class="cs-impact-v2-card">
      <div class="cs-impact-icon">{{IMPACT_ICON}}</div>
      <p class="cs-impact-text">{{IMPACT_TEXT}}</p>
    </div>
  </div>
</section>

<!-- CTA -->
<RelatedIndustry items={[{ label: '{{RELATED_INDUSTRY_LABEL}}', href: '{{RELATED_INDUSTRY_HREF}}' }]} />
<FinalCTA />

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* ── FEATURE VIDEO — dark section that flows out of the stats ── */
  /* Stats block defaults to 100vh with centered numbers, leaving a half-screen
     void below them. Compact it here so the video sits right under the numbers. */
  .cs-stats-v2 {
    min-height: auto;
    padding: 120px 24px 48px;
  }
  .cs-video-v2 {
    background: var(--ink);
    padding: 48px 24px 120px;
  }
  .cs-video-v2-inner {
    max-width: 1000px;
    margin: 0 auto;
    text-align: center;
  }
  .cs-video-v2 .eyebrow {
    color: var(--green-lt);
    opacity: 0;
    transform: translateX(-20px);
    transition: all 0.6s ease;
  }
  .cs-video-v2 .eyebrow::before { background: var(--green-lt); }
  .cs-video-v2 .eyebrow.visible { opacity: 1; transform: translateX(0); }
  .cs-video-v2 h2 {
    font-family: 'Anton', sans-serif;
    color: var(--offwhite);
    font-size: clamp(32px, 5vw, 56px);
    line-height: 1.05;
    margin: 12px 0 40px;
    opacity: 0;
    filter: blur(8px);
    transform: translateY(20px);
    transition: all 0.7s ease;
  }
  .cs-video-v2 h2.visible { opacity: 1; filter: blur(0); transform: translateY(0); }
  .cs-video-embed {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(165, 219, 93, 0.25);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
    opacity: 0;
    transform: translateY(40px) scale(0.97);
    transition: opacity 0.8s ease, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cs-video-embed.visible { opacity: 1; transform: translateY(0) scale(1); }
  .cs-video-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  @supports not (aspect-ratio: 16 / 9) {
    .cs-video-embed { height: 0; padding-top: 56.25%; }
  }
</style>

<script>
  // Scroll progress
  window.addEventListener('scroll', () => {
    const p = (window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)) * 100;
    const bar = document.getElementById('csScrollProgress');
    if (bar) bar.style.width = p + '%';
  });

  // Hero activation
  setTimeout(() => document.getElementById('csHero')?.classList.add('active'), 300);

  // General reveal observer
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) e.target.classList.add('visible');
    });
  }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

  document.querySelectorAll(
    '.cs-video-v2 .eyebrow, .cs-video-v2 h2, .cs-video-embed, ' +
    '.cs-challenge-v2 .eyebrow, .cs-challenge-v2 h2, .cs-fly-card, .cs-mandate-drop, ' +
    '.cs-approach .eyebrow, .cs-approach h2, .cs-approach-insight, .cs-approach-grid .cs-phase-card, ' +
    '.cs-results .eyebrow, .cs-results h2, .cs-result-row, ' +
    '.cs-impact-v2 .eyebrow, .cs-impact-v2 h2, .cs-impact-v2-card'
  ).forEach(el => obs.observe(el));

  // Stats auto-play drop-in
  let statsTriggered = false;
  const statsObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting && !statsTriggered) {
        statsTriggered = true;
        e.target.classList.add('in-view');
        const blocks = document.querySelectorAll('.cs-stat-drop');
        const nums = document.querySelectorAll('.cs-stat-drop-num[data-target]');
        blocks.forEach((block, i) => {
          setTimeout(() => {
            block.classList.add('dropped');
            const el = nums[i];
            const target = parseFloat(el.dataset.target);
            const prefix = el.dataset.prefix || '';
            const suffix = el.dataset.suffix || '';
            const isFloat = target % 1 !== 0;
            const duration = 1800;
            const start = performance.now();
            function update(now) {
              const elapsed = now - start;
              const progress = Math.min(elapsed / duration, 1);
              const eased = 1 - Math.pow(1 - progress, 3);
              const current = isFloat ? (target * eased).toFixed(1) : Math.round(target * eased);
              el.textContent = prefix + current + suffix;
              if (progress < 1) requestAnimationFrame(update);
            }
            requestAnimationFrame(update);
          }, i * 400);
        });
      }
    });
  }, { threshold: 0.3 });
  const statsEl = document.getElementById('csStats');
  if (statsEl) statsObs.observe(statsEl);

  // Results count-up
  let resultsCounted = false;
  const resultObs = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting && !resultsCounted) {
        resultsCounted = true;
        document.querySelectorAll('.cs-result-row-num[data-target]').forEach((el, i) => {
          setTimeout(() => {
            const target = parseFloat(el.dataset.target);
            const prefix = el.dataset.prefix || '';
            const suffix = el.dataset.suffix || '';
            const isFloat = target % 1 !== 0;
            const accentHtml = prefix ? '<span class="accent">' + prefix + '</span>' : '';
            const duration = 2000;
            const start = performance.now();
            function update(now) {
              const elapsed = now - start;
              const progress = Math.min(elapsed / duration, 1);
              const eased = 1 - Math.pow(1 - progress, 3);
              const current = isFloat ? (target * eased).toFixed(1) : Math.round(target * eased);
              el.innerHTML = accentHtml + current + suffix;
              if (progress < 1) requestAnimationFrame(update);
            }
            requestAnimationFrame(update);
          }, i * 200);
        });
      }
    });
  }, { threshold: 0.2 });
  const resultsEl = document.querySelector('.cs-results');
  if (resultsEl) resultObs.observe(resultsEl);

  // Cap chips staggered
  const capObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.querySelectorAll('.cs-cap-chip').forEach((chip, i) => {
          setTimeout(() => chip.classList.add('visible'), i * 150);
        });
        capObs.unobserve(e.target);
      }
    });
  }, { threshold: 0.3 });
  const capsEl = document.getElementById('csCapsGrid');
  if (capsEl) capObs.observe(capsEl);
</script>
