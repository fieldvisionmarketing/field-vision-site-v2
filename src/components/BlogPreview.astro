---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<section class="insights section">
  <div class="section-header-row reveal">
    <div>
      <h2 class="section-title">Latest <span class="hl-cream">Insights</span></h2>
    </div>
    <a href="/blog/" class="btn-brutal-outline">View All Posts →</a>
  </div>
  <div class="blog-grid">
    {posts.map((post, i) => (
      <a href={`/blog/${post.id.replace(/\.md$/, '')}/`} class={`blog-card reveal rd${i + 1}`}>
        <div class="blog-body">
          <span class="blog-cat">{post.data.category}</span>
          <h3>{post.data.title}</h3>
          <p>{post.data.description}</p>
        </div>
      </a>
    ))}
  </div>
</section>
