---
/**
 * CardGrid — Two-column responsive grid for Card components
 */
---
<div class="card-grid">
  <slot />
</div>

<style>
  .card-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin: 24px 0;
  }
  @media (max-width: 900px) {
    .card-grid { grid-template-columns: 1fr; }
  }
</style>
