---
/**
 * Card — Labeled content card for use inside CardGrid
 * @prop label — Card header label (e.g. "WHAT YOU DO", "KEY QUESTIONS")
 */
interface Props {
  label: string;
}
const { label } = Astro.props;
---
<div class="card">
  <div class="card-label">{label}</div>
  <div class="card-body">
    <slot />
  </div>
</div>

<style>
  .card {
    background: #fff;
    border: 1px solid rgba(33, 54, 33, 0.08);
    border-radius: 14px;
    padding: 28px 24px;
    box-shadow: 0 2px 8px rgba(33, 54, 33, 0.04);
  }
  .card-label {
    font-family: 'Satoshi', sans-serif;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #8B9A7E;
    margin-bottom: 12px;
  }
  .card-body {
    font-family: 'Satoshi', sans-serif;
    font-size: 15px;
    color: rgba(33, 54, 33, 0.7);
    line-height: 1.65;
  }
  .card-body :global(strong) {
    color: #213621;
  }
</style>
