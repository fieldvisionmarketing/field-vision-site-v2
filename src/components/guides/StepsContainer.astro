---
/**
 * StepsContainer — Wrapper for a vertical sequence of SubStep components
 * @prop label — Optional label shown above the steps (e.g. "Follow these 3 sub-steps")
 */
interface Props {
  label?: string;
}
const { label } = Astro.props;
---
{label && <div class="steps-label">{label}</div>}
<div class="steps-container">
  <slot />
</div>

<style>
  .steps-label {
    font-family: 'Satoshi', sans-serif;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #8B9A7E;
    margin-bottom: 16px;
  }
  .steps-container {
    margin: 32px 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
</style>
