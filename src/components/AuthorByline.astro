---
interface Props {
  date: Date;
  readingTime?: number;
}


const { date, readingTime } = Astro.props;


const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---


<div class="author-byline">
  <img src="/logos/NoXO%20Social%20Profile.png" alt="Field Vision" class="author-avatar" loading="lazy" />
  <div>
    <span class="author-name">Field Vision</span>
    <span class="author-meta">
      Published {formattedDate}{readingTime ? ` · ${readingTime} min read` : ''}
    </span>
  </div>
</div>


<style>
  .author-byline {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 2rem;
  }
  .author-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
