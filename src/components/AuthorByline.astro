---
interface Props {
  date: Date;
  readingTime?: number;
}


const { date, readingTime } = Astro.props;


const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---


<div class="author-byline">
  <img src="/headshot-david-hampian.jpg" alt="David Hampian" class="author-avatar" loading="lazy" />
  <div>
    <span class="author-name"><a href="/about/" rel="author">David Hampian</a> · Field Vision</span>
    <span class="author-meta">
      Published {formattedDate}{readingTime ? ` · ${readingTime} min read` : ''}
    </span>
  </div>
</div>


<style>
  .author-byline {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 2rem;
  }
  .author-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .author-name {
    display: block;
    font-weight: 700;
    font-size: 0.95rem;
  }
  .author-name a {
    color: inherit;
    text-decoration: none;
  }
  .author-name a:hover {
    text-decoration: underline;
  }
  .author-meta {
    display: block;
    font-size: 0.85rem;
    opacity: 0.7;
  }
</style>
