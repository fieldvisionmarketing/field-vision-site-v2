---
const frameworks = [
  {
    name: "ABCT",
    body: "Our key engagement model. We audit what exists, blueprint the strategy, construct the systems, then transfer ownership — built to be fired.",
    href: "/guides/abct-framework/",
  },
  {
    name: "SCORE",
    body: "The strategic foundation of a growth system. Strategy, Channels, Operations, Reporting, and Experimentation — the five pillars of sustainable growth.",
    href: "/guides/score-framework/",
  },
  {
    name: "PLOT",
    body: "A marketer's guide to securing more budget and organizational buy-in. Position, Leverage, Outcomes, and Timing — the framework for internal advocacy.",
    href: "/guides/plot-framework/",
  },
];
---

<section class="frameworks">
  <div class="frameworks-inner">
    <div class="reveal">
      <h2>Our <span class="highlight">Products</span></h2>
      <p class="section-sub">Every engagement runs on proprietary growth systems — not guesswork. Repeatable results, every time.</p>
    </div>
    <div class="fw-grid">
      {frameworks.map((fw, i) => (
        <a href={fw.href} class={`fw-card reveal rd${i + 1}`}>
          <div class="fw-name">{fw.name}</div>
          <p>{fw.body}</p>
          <span class="fw-link">Read the Guide →</span>
        </a>
      ))}
    </div>
  </div>
</section>
