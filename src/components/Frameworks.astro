---
// v3 Phase 4: ABCT is the one framework at the top level.
// SCORE and CGS run inside its Construct phase, not as co-equal products.
const frameworks = [
  {
    icon: "🔬",
    name: "ABCT®",
    tag: "The engagement model",
    body: "The one framework every engagement runs on, end to end. We audit what exists, blueprint the strategy, construct the systems, then transfer ownership. Built to be fired.",
    href: "/guides/abct-framework/",
  },
  {
    icon: "📊",
    name: "SCORE®",
    tag: "Inside Construct",
    body: "The testing engine inside Construct. A hypothesis-driven playbook: five steps that turn strategic context into testable experiments, disciplined execution, and compounding growth.",
    href: "/guides/score-framework/",
  },
  {
    icon: "🔄",
    name: "CGS®",
    tag: "Inside Construct",
    body: "The growth flywheel inside Construct. The Compound Growth System, four C’s for scalable acquisition and retention: Catch, Convert, Cultivate, and Champion your way to compounding growth.",
    href: "/guides/compound-growth-system/",
  },
];
---

<section class="frameworks section" style="background:var(--warm-gray)">
  <div class="section-header-row reveal">
    <div>
      <h2 class="section-title">One Framework: <span class="hl-green">ABCT®</span></h2>
      <p class="section-subtitle">Every engagement runs on ABCT. The SCORE and CGS systems live inside its Construct phase.</p>
    </div>
    <a href="/guides/" class="btn-brutal-outline">View All Guides →</a>
  </div>
  <div class="products-grid">
    {frameworks.map((fw, i) => (
      <a href={fw.href} class={`product-card reveal rd${i + 1}`}>
        <div class="product-header">
          <div class="product-icon"><span>{fw.icon}</span></div>
          <span class="product-name">{fw.name}</span>
        </div>
        <div class="product-body">
          <p class="product-desc"><strong style="color:var(--green-dk);font-weight:700;">{fw.tag}.</strong> {fw.body}</p>
          <span class="product-link">Read the Guide →</span>
        </div>
      </a>
    ))}
  </div>
</section>
