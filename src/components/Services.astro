    </div>
    <div class="bento">
      {services.map((s, i) => (
        <a href={s.href} class={`bento-card ${s.style} reveal rd${(i % 5) + 1}`}>
          {s.badge && <span class="bento-badge">{s.badge}</span>}
          {s.emoji && <span class="bento-emoji">{s.emoji}</span>}
          <h3 set:html={s.title} />
          <p>{s.body}</p>
          <span class="card-link">Learn More →</span>
        </a>
      ))}
    </div>
  </div>
