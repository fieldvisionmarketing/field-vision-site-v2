---
// v3 (2026 brand realignment): seven services collapsed to the four doors.
// Each door opens with its trigger's pain, not a feature list.
const doors = [
  {
    emoji: "🎯",
    title: "Fractional CMO",
    body: "“Nobody senior is steering.” Embedded marketing leadership for founders carrying the CMO hat on top of everything else. Strategy, systems, hiring, and the operating cadence to run them.",
    href: "/services/fractional-cmo/",
  },
  {
    emoji: "🚀",
    title: "Go-to-Market Strategy",
    body: "“We’re launching something.” The plan and the launch for a product, market, or moment with a real date, from a leader who’s launched at Amazon, Twitch, and Hard Rock.",
    href: "/services/go-to-market/",
  },
  {
    emoji: "📈",
    title: "Growth & Lifecycle",
    body: "“Growth stalled; the wins are drying up.” The full-funnel engine that acquires the right users and keeps them, so growth compounds instead of plateaus.",
    href: "/services/growth-marketing/",
  },
  {
    emoji: "✏️",
    title: "Brand Strategy & Positioning",
    body: "“Our story is fuzzy. AI gave us mush.” Sharp positioning and a story your whole company can tell, so you sound like no one else in the category.",
    href: "/services/brand-strategy-positioning/",
  },
];
---

<section class="services section">
  <div class="section-header-row reveal">
    <div>
      <h2 class="section-title">Our <span class="hl-green">Services</span></h2>
    </div>
    <a href="/services/" class="btn-brutal-outline">View All Services →</a>
  </div>
  <div class="services-grid">
    {doors.map((s, i) => (
      <a href={s.href} class={`service-card reveal rd${i + 1}`}>
        <div class="service-card-header">
          <span class="service-emoji">{s.emoji}</span>
          <span class="service-name">{s.title}</span>
        </div>
        <div class="service-card-body">
          <p class="service-desc">{s.body}</p>
          <span class="service-link">Learn More →</span>
        </div>
      </a>
    ))}
  </div>
</section>
