---
const rows = [
  {
    old: "Hire a full-time CMO at $250K+ before you have product-market fit",
    new: "Engage a fractional CMO who's scaled growth at Amazon, Twitch, and Pandora",
  },
  {
    old: "Pay expensive agencies that don't understand your business or industry",
    new: "Get a project-based engagement with proprietary growth systems — not a retainer that drains budget",
  },
  {
    old: "Engage ivory-tower consultants who deliver strategy decks that collect dust",
    new: "Align brand, growth, and product marketing with a unified, systems-driven strategy",
  },
  {
    old: "Chase disconnected tactics — paid ads, PR, influencers — hoping something sticks",
    new: "Own everything we build — every engagement transfers full IP, no dependency created",
  },
];
---

<section class="how-it-works section">
  <div class="section-header reveal">
    <div class="section-eyebrow">Our Approach</div>
    <h2 class="section-title">How We <span class="hl-green">Work</span></h2>
    <p class="section-subtitle">We replace the broken playbook with a systems-driven approach built on a decade of scaling brands at Amazon, Twitch, and Pandora.</p>
  </div>
  <div class="owvnw reveal rd1">
    <table class="owvnw-table">
      <thead>
        <tr>
          <th>The Old Way</th>
          <th>The New Way</th>
        </tr>
      </thead>
      <tbody>
        {rows.map(row => (
          <tr>
            <td>
              <div class="owvnw-td-inner">
                <span class="row-icon red">✗</span>
                <span>{row.old}</span>
              </div>
            </td>
            <td>
              <div class="owvnw-td-inner">
                <span class="row-icon green">✓</span>
                <span>{row.new}</span>
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
