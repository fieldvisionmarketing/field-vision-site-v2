---
// Contextual internal link from a case study to the vertical it proves.
// Keeps vertical pages out of nav/footer while passing topical link equity.
const { items = [] } = Astro.props;
---
{items.length > 0 && (
  <section class="cs-related-ind section" style="background:var(--paper);border-top:4px solid var(--ink)">
    <div class="cs-related-ind-inner reveal">
      <span class="eyebrow">Explore</span>
      <div class="cs-related-ind-links">
        {items.map((i: { label: string; href: string }) => (
          <a href={i.href} class="cs-related-ind-link">{i.label} <span>&rarr;</span></a>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .cs-related-ind { padding: 48px 24px; }
  .cs-related-ind-inner { max-width: 1080px; margin: 0 auto; }
  .cs-related-ind-links { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 16px; }
  .cs-related-ind-link {
    font-family: 'Anton', sans-serif;
    text-transform: uppercase;
    font-size: clamp(1.05rem, 2vw, 1.4rem);
    letter-spacing: 0.02em;
    color: var(--ink);
    text-decoration: none;
    border: 4px solid var(--ink);
    box-shadow: 6px 6px 0 var(--ink);
    background: var(--paper);
    padding: 14px 22px;
    transition: transform 0.15s, box-shadow 0.15s, color 0.15s;
  }
  .cs-related-ind-link:hover {
    transform: translate(-2px, -2px);
    box-shadow: 8px 8px 0 var(--ink), 0 0 30px rgba(165,219,93,0.55), 0 0 60px rgba(165,219,93,0.2);
    color: var(--green-dk);
  }
  .cs-related-ind-link span { color: var(--green-dk); }
</style>
