---
// v3 (2026 brand realignment): trigger router as an editorial index (non-card).
// Four founder situations, simply labeled, each routing to a door.
const rows = [
  {
    num: '01',
    quote: "Just raised, need a growth plan.",
    resp: "The good news is we have investors. The bad news is we need to prove we can grow now, and we don't have anybody focusing on that.",
    door: "Fractional CMO",
    sub: "Embedded leadership",
    href: "/services/fractional-cmo/",
  },
  {
    num: '02',
    quote: "Upcoming launch, needed a plan yesterday.",
    resp: "We're racing against the clock to launch our new product and need a GTM plan. We need it to be good, and we need it now.",
    door: "Go-to-Market",
    sub: "Plan and launch",
    href: "/services/go-to-market/",
  },
  {
    num: '03',
    quote: "Nothing's working and no one knows why.",
    resp: "We've tested a bunch of stuff, but nothing seems to stick. It feels like we're stuck in a rut. We need to understand why so we can start winning.",
    door: "Growth & Lifecycle",
    sub: "Full-funnel engine",
    href: "/services/growth-marketing/",
  },
  {
    num: '04',
    quote: "We tried AI and it gave us junk.",
    resp: "We used AI for our marketing. It gave us a plan that looks, feels, and sounds exactly like everyone else. We need real judgment, experience, and taste moving forward.",
    door: "Brand Strategy",
    sub: "Sharp positioning",
    href: "/services/brand-strategy-positioning/",
  },
];
---

<section class="starting-point section">
  <div class="section-header reveal">
    <div class="section-eyebrow">Your Starting Point</div>
    <h2 class="section-title">Every Startup's Marketing Challenge Looks <span class="hl-cream">Different</span></h2>
    <p class="section-subtitle">Find the one that sounds like you. That's your door.</p>
  </div>

  <div class="sp-index reveal">
    {rows.map((r) => (
      <a href={r.href} class="sp-row">
        <div class="sp-num">{r.num}</div>
        <div class="sp-body">
          <div class="sp-quote">{r.quote}</div>
          <p class="sp-resp">{r.resp}</p>
        </div>
        <div class="sp-door">
          <span class="sp-door-label">{r.door} →</span>
          <span class="sp-door-sub">{r.sub}</span>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .sp-index {
    margin-top: 34px;
    border-top: 2px solid var(--ink);
  }
  .sp-row {
    display: grid;
    grid-template-columns: 118px 1fr 220px;
    align-items: center;
    gap: 30px;
    padding: 28px 12px;
    border-bottom: 1px solid var(--line, #e4e1d3);
    text-decoration: none;
    color: var(--ink);
    transition: background 0.15s ease;
  }
  .sp-row:hover { background: var(--paper); }

  .sp-num {
    font-family: 'Anton', sans-serif;
    font-size: 64px;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 2px var(--green-dk);
    transition: color 0.15s ease, -webkit-text-stroke-color 0.15s ease;
  }
  .sp-row:hover .sp-num {
    color: var(--green-lt);
    -webkit-text-stroke: 2px var(--ink);
  }

  .sp-quote {
    font-family: 'Anton', sans-serif;
    font-size: 23px;
    line-height: 1.12;
    text-transform: uppercase;
    letter-spacing: 0.005em;
    color: var(--ink);
  }
  .sp-resp {
    font-size: 15px;
    line-height: 1.5;
    color: var(--muted);
    margin: 9px 0 0;
    max-width: 560px;
  }

  .sp-door {
    justify-self: end;
    text-align: right;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }
  .sp-door-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--ink);
    white-space: nowrap;
    border-top: 3px solid var(--ink);
    padding-top: 10px;
  }
  .sp-row:hover .sp-door-label { color: var(--green-dk); }
  .sp-door-sub {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 5px;
  }

  @media (max-width: 760px) {
    .sp-row {
      grid-template-columns: 64px 1fr;
      grid-template-areas: "num body" "num door";
      gap: 6px 18px;
      padding: 22px 4px;
      align-items: start;
    }
    .sp-num { grid-area: num; font-size: 40px; }
    .sp-body { grid-area: body; }
    .sp-quote { font-size: 19px; }
    .sp-door {
      grid-area: door;
      justify-self: start;
      text-align: left;
      align-items: flex-start;
      margin-top: 10px;
    }
    .sp-door-label { border-top: none; padding-top: 0; }
  }
</style>
