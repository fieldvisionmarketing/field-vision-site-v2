---
const cards = [
  {
    num: '01',
    title: "Not ready for a full-time marketing hire",
    body: "You need senior marketing leadership but not the $500K+ commitment. A fractional CMO gives you the strategy and oversight without the overhead.",
    link: { label: "Explore Fractional CMO →", href: "/services/fractional-cmo/" },
  },
  {
    num: '02',
    title: "Launching something and need a growth strategy",
    body: "You have a specific initiative, a product launch, new market entry, or rebrand, and need an expert to build the plan and lead the execution.",
    link: { label: "Explore Go-to-Market →", href: "/services/go-to-market/" },
  },
  {
    num: '03',
    title: "Have a team but need an expert to steer",
    body: "You're doing marketing but aren't sure it's working. You need someone to audit what exists, set a direction, and coach your team to execute.",
    link: { label: "Take the Assessment →", href: "/assessment/" },
  },
];
---

<section class="starting-point section">
  <div class="section-header reveal">
    <div class="section-eyebrow">Your Starting Point</div>
    <h2 class="section-title">Every Startup's Marketing Challenge Looks <span class="hl-cream">Different</span></h2>
    <p class="section-subtitle">Which sounds like yours?</p>
  </div>
  <div class="persona-grid">
    {cards.map((card, i) => (
      <div class={`persona-card reveal rd${i + 1}`}>
        <div class="persona-top">
          <div class="persona-num">{card.num}</div>
          <div>
            <div class="persona-name">{card.title}</div>
          </div>
        </div>
        <div class="persona-bottom">
          <p class="persona-desc">{card.body}</p>
        </div>
      </div>
    ))}
  </div>
</section>
