<section class="hero-section">
  <div class="hero-left">
    <div class="hero-headline">
      <h1>Marketing Leadership for <span class="hl-green">Startups</span></h1>
    </div>
    <div class="hero-lede-row">
      <div class="hero-lede">
        <p>We come in at <span class="mark">inflection points</span> — product launches, new market entries, growth plateaus — to align your strategy, test what works, and install systems that scale.</p>
      </div>
      <a href="/contact/" class="btn-brutal">Book a Call <span>→</span></a>
    </div>
  </div>
  <div class="hero-right">
    <div class="hero-right-label">
      <div class="label-eyebrow">Currently Running</div>
      <div class="label-service" id="play-label">Fractional CMO</div>
    </div>
    <svg class="play-anim-svg" viewBox="0 0 500 800" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
      <g id="bg-main"></g>
      <g id="play-main" opacity="0"></g>
    </svg>
  </div>
</section>
<div class="scroll-hint"><span class="scroll-chevron">↓</span></div>

<script>
(function () {
  var NS = 'http://www.w3.org/2000/svg';

  function el(tag, attrs) {
    var e = document.createElementNS(NS, tag);
    for (var k in attrs) e.setAttribute(k, attrs[k]);
    return e;
  }
  function arrowPts(ex, ey, px, py) {
    var a = Math.atan2(ey-py,ex-px), s = Math.PI/6, sz = 9;
    return [[ex,ey],[ex-sz*Math.cos(a-s),ey-sz*Math.sin(a-s)],[ex-sz*Math.cos(a+s),ey-sz*Math.sin(a+s)]]
      .map(function(p){return p[0].toFixed(1)+','+p[1].toFixed(1)}).join(' ');
  }
  function raf(fn) { requestAnimationFrame(function(){ requestAnimationFrame(fn); }); }

  function drawFootball(bgEl) {
    bgEl.innerHTML = '';
    [[0,200,500,200],[0,600,500,600]].forEach(function(c){
      bgEl.appendChild(el('line',{class:'yard-hash',x1:c[0],y1:c[1],x2:c[2],y2:c[3]}));
    });
    [[0,350,500,350],[0,480,500,480]].forEach(function(c){
      bgEl.appendChild(el('line',{class:'scrimmage',x1:c[0],y1:c[1],x2:c[2],y2:c[3]}));
    });
  }



  var plays = [
    { sport:'football', label:'Shotgun Spread', players:[
      {x:200,y:410,t:'O'},{x:230,y:410,t:'O'},{x:250,y:410,t:'O'},{x:270,y:410,t:'O'},{x:300,y:410,t:'O'},
      {x:250,y:470,t:'X'},{x:220,y:500,t:'X'},
      {x:50,y:400,t:'X'},{x:140,y:390,t:'X'},{x:450,y:400,t:'X'},{x:340,y:400,t:'X'}
    ], routes:[
      {d:'M 50 400 L 50 280 Q 50 230 100 200 L 180 150',delay:.4,dur:2.0},
      {d:'M 450 400 L 450 280 Q 450 230 470 200 L 490 140',delay:.5,dur:2.0},
      {d:'M 140 390 L 210 330 L 260 300',delay:.6,dur:1.5},
      {d:'M 340 400 L 340 350 Q 340 320 300 300 L 180 280',delay:.8,dur:1.8},
      {d:'M 220 500 Q 150 500 100 480 L 60 450',delay:1.0,dur:1.5}
    ]},
    { sport:'football', label:'I-Form Power', players:[
      {x:200,y:410,t:'O'},{x:230,y:410,t:'O'},{x:250,y:410,t:'O'},{x:270,y:410,t:'O'},{x:300,y:410,t:'O'},
      {x:250,y:435,t:'X'},{x:250,y:480,t:'X'},{x:250,y:530,t:'X'},
      {x:340,y:405,t:'X'},{x:60,y:405,t:'X'},{x:440,y:405,t:'X'}
    ], routes:[
      {d:'M 250 530 Q 270 510 300 480 L 340 440 Q 370 410 400 370 L 420 330',delay:.5,dur:2.4},
      {d:'M 250 480 L 290 450 L 330 420',delay:.3,dur:1.3},
      {d:'M 230 410 Q 230 430 240 440 Q 270 450 310 430 L 350 400',delay:.2,dur:1.5},
      {d:'M 60 405 L 60 300 L 60 220',delay:.6,dur:1.5},
      {d:'M 440 405 L 380 370 L 350 340',delay:.7,dur:1.1}
    ]}
  ];

  var serviceNames = [
    'Fractional CMO',
    'Go-to-Market Strategy',
    'Growth & Lifecycle',
    'Integrated Marketing',
    'Content & Creator',
    'AI Growth Systems',
    'Org & Process Design'
  ];
  var serviceIdx = 0;

  function renderPlay(playEl, bgEl, p) {
    playEl.innerHTML = '';
    drawFootball(bgEl);
    p.players.forEach(function(pl, i) {
      var g = el('g',{class: pl.t==='X' ? 'player-x' : 'player-o'});
      var txt = el('text',{x:pl.x, y:pl.y});
      txt.textContent = pl.t;
      txt.style.opacity = '0';
      txt.style.transition = 'opacity 0.4s ease '+(i*0.04)+'s';
      g.appendChild(txt);
      playEl.appendChild(g);
      raf(function(){ txt.style.opacity = '1'; });
    });
    p.routes.forEach(function(r) {
      var path = el('path',{d:r.d, class:'route'});
      if (r.dashed) { path.setAttribute('stroke-dasharray','6 4'); path.style.opacity = '0'; }
      playEl.appendChild(path);
      var len = path.getTotalLength();
      if (r.dashed) {
        path.style.strokeDashoffset = len;
        path.style.transition = 'stroke-dashoffset '+r.dur+'s ease-in-out '+r.delay+'s, opacity 0.3s ease '+r.delay+'s';
        raf(function(){ path.style.strokeDashoffset='0'; path.style.opacity='0.5'; });
      } else {
        path.style.strokeDasharray = len;
        path.style.strokeDashoffset = len;
        path.style.transition = 'stroke-dashoffset '+r.dur+'s ease-in-out '+r.delay+'s';
        raf(function(){ path.style.strokeDashoffset='0'; });
      }
      var end = path.getPointAtLength(len);
      var prev = path.getPointAtLength(Math.max(0,len-14));
      var arrow = el('polygon',{class:'arrowhead', points:arrowPts(end.x,end.y,prev.x,prev.y)});
      arrow.style.transition = 'opacity 0.3s ease '+(r.delay+r.dur-0.1)+'s';
      playEl.appendChild(arrow);
      raf(function(){ arrow.style.opacity='1'; });
    });
  }

  var playEl = document.getElementById('play-main');
  var bgEl = document.getElementById('bg-main');
  var labelEl = document.getElementById('play-label');
  if (!playEl || !bgEl) return;

  var idx = 0;
  var active = true;
  var timers = [];

  function fadeEl(g, op, dur) {
    return new Promise(function(res){
      g.style.transition = 'opacity '+dur+'s ease';
      g.setAttribute('opacity', op);
      setTimeout(res, dur*1000);
    });
  }

  function cycle() {
    if (!active) return;
    var p = plays[idx];
    idx = (idx+1) % plays.length;
    renderPlay(playEl, bgEl, p);
    if (labelEl) { labelEl.style.opacity = '0'; setTimeout(function(){ labelEl.textContent = serviceNames[serviceIdx]; serviceIdx = (serviceIdx+1) % serviceNames.length; labelEl.style.opacity = '1'; }, 400); }
    fadeEl(playEl,1,.8).then(function(){
      return new Promise(function(r){ timers.push(setTimeout(r,5200)); });
    }).then(function(){
      return fadeEl(playEl,0,.8);
    }).then(function(){
      if (active) cycle();
    });
  }

  function start() { cycle(); }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
  else start();

  document.addEventListener('visibilitychange', function(){
    if (document.hidden) { active = false; timers.forEach(clearTimeout); timers = []; }
    else { active = true; cycle(); }
  });
})();
</script>
