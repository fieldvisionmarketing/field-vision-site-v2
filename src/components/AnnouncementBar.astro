---
// Dismissible slide-down promo banner, site-wide, links to the event page.
const HREF = "/fanaticsfest/";
---
<div id="ff-banner" role="region" aria-label="Event announcement">
  <a href={HREF} class="ff-banner-link-wrap">
    <div class="ff-banner-inner">
      <span class="ff-banner-chip"><span class="ff-live-dot"></span>LIVE</span>
      <span class="ff-banner-text">
        <span class="ff-track">
          <span class="ff-msg">Marketing Teardown @ Fanatics Fest NYC, Sat, Jul 18 &middot; <span class="ff-banner-cta">Reserve your slot <span class="ff-arrow">&rarr;</span></span></span>
          <span class="ff-msg ff-msg--dup" aria-hidden="true">Marketing Teardown @ Fanatics Fest NYC, Sat, Jul 18 &middot; <span class="ff-banner-cta">Reserve your slot &rarr;</span></span>
        </span>
      </span>
    </div>
  </a>
  <button id="ff-banner-close" aria-label="Dismiss announcement">&times;</button>
</div>

<style is:global>
  #ff-banner {
    position: fixed; top: 0; left: 0; width: 100%; z-index: 1200;
    transform: translateY(-100%);
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    background: var(--green-lt); color: var(--ink);
    border-bottom: 4px solid var(--ink);
    overflow: hidden;
  }
  #ff-banner.is-open { transform: translateY(0); }

  /* Glossy shine sweep */
  #ff-banner::after {
    content: ''; position: absolute; top: 0; left: -60%; height: 100%; width: 55%;
    background: linear-gradient(100deg, transparent 0%, rgba(255,255,255,0.55) 50%, transparent 100%);
    transform: skewX(-20deg); pointer-events: none; z-index: 1;
    animation: ffShine 5s ease-in-out 0.8s infinite;
  }

  .ff-banner-link-wrap { display: block; color: var(--ink); position: relative; z-index: 2; }
  .ff-banner-inner {
    height: 44px; display: flex; align-items: center; justify-content: center;
    gap: 12px; padding: 0 52px;
  }
  .ff-banner-chip {
    display: inline-flex; align-items: center; gap: 7px;
    font-family: 'Anton', sans-serif; font-size: 12px; letter-spacing: 0.08em;
    text-transform: uppercase; background: #d62828; color: #fff;
    padding: 3px 10px 4px; flex-shrink: 0;
  }
  .ff-live-dot {
    width: 8px; height: 8px; border-radius: 50%; background: #fff;
    display: inline-block; animation: ffPulse 1.3s ease-in-out infinite;
  }
  .ff-banner-text {
    font-family: 'Archivo', sans-serif; font-size: 13px; font-weight: 700;
    letter-spacing: 0.03em; text-transform: uppercase; white-space: nowrap;
    overflow: hidden; text-overflow: ellipsis;
  }
  .ff-banner-cta { text-decoration: underline; text-underline-offset: 3px; }
  .ff-track { display: inline; }
  .ff-msg--dup { display: none; }
  .ff-arrow { display: inline-block; animation: ffNudge 1.1s ease-in-out infinite; }

  #ff-banner-close {
    position: absolute; right: 14px; top: 50%; transform: translateY(-50%);
    background: none; border: none; cursor: pointer; z-index: 3;
    font-size: 24px; line-height: 1; color: var(--ink); padding: 4px 8px;
    transition: transform 0.15s;
  }
  #ff-banner-close:hover { transform: translateY(-50%) scale(1.15); }

  /* Push the page + fixed header down when the banner is visible */
  body.has-banner { padding-top: 44px; }
  body.has-banner .header { top: 44px; }

  @keyframes ffShine {
    0% { left: -60%; }
    45% { left: 120%; }
    100% { left: 120%; }
  }
  @keyframes ffPulse {
    0%, 100% { transform: scale(1); opacity: 1; box-shadow: 0 0 0 0 rgba(255,255,255,0.8); }
    50% { transform: scale(1.35); opacity: 0.65; box-shadow: 0 0 0 4px rgba(255,255,255,0); }
  }
  @keyframes ffNudge {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(5px); }
  }

  @media (max-width: 600px) {
    .ff-banner-inner { padding: 0 40px; gap: 0; justify-content: flex-start; }
    .ff-banner-text { font-size: 11px; letter-spacing: 0.01em; width: 100%; overflow: hidden; }
    .ff-banner-chip { display: none; }
    .ff-track {
      display: inline-flex; flex-wrap: nowrap; will-change: transform;
      animation: ffMarquee 14s linear infinite;
    }
    .ff-msg { white-space: nowrap; padding-right: 48px; }
    .ff-msg--dup { display: inline-block; }
  }

  @keyframes ffMarquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    #ff-banner { transition: transform 0.3s ease; }
    #ff-banner::after, .ff-live-dot, .ff-arrow, .ff-track { animation: none; }
    #ff-banner::after { display: none; }
    .ff-msg--dup { display: none; }
  }
</style>

<script is:inline>
  (function () {
    var KEY = 'ff-banner-dismissed';
    var bar = document.getElementById('ff-banner');
    if (!bar) return;
    try { if (localStorage.getItem(KEY) === '1') { bar.parentNode && bar.parentNode.removeChild(bar); return; } } catch (e) {}
    document.body.classList.add('has-banner');
    requestAnimationFrame(function () { bar.classList.add('is-open'); });
    var close = document.getElementById('ff-banner-close');
    close.addEventListener('click', function (e) {
      e.preventDefault(); e.stopPropagation();
      bar.classList.remove('is-open');
      document.body.classList.remove('has-banner');
      try { localStorage.setItem(KEY, '1'); } catch (er) {}
      setTimeout(function () { bar.parentNode && bar.parentNode.removeChild(bar); }, 360);
    });
  })();
</script>
