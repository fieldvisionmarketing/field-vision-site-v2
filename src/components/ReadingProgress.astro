---
/**
 * ReadingProgress — canonical long-form reading indicator (R21)
 * Vertical lime bar pinned to the right edge that fills top→bottom as the
 * reader scrolls, plus a live percent readout pill in the bottom-right.
 * Used on blog articles and long-form essay pages. Self-contained: markup,
 * scoped styles, and scroll script all live here.
 */
---

<div class="reading-progress" id="readingProgress" aria-hidden="true">
  <div class="reading-progress-fill" id="readingProgressFill"></div>
</div>
<div class="reading-progress-pct" id="readingProgressPct" aria-hidden="true">0%</div>

<style>
  .reading-progress {
    position: fixed; top: 0; right: 0;
    width: 12px; height: 100vh;
    background: rgba(33, 54, 33, 0.12);
    border-left: 2px solid var(--ink);
    z-index: 1300;
  }
  .reading-progress-fill {
    width: 100%; height: 0;
    background: var(--green-lt);
    transition: height 0.1s linear;
  }
  .reading-progress-pct {
    position: fixed; right: 24px; bottom: 24px;
    z-index: 1300;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700; font-size: 13px; letter-spacing: 0.04em;
    background: var(--ink); color: var(--offwhite);
    border: 3px solid var(--ink);
    box-shadow: 4px 4px 0 var(--green-lt);
    padding: 7px 11px;
  }
  @media (max-width: 600px) {
    .reading-progress { width: 8px; }
    .reading-progress-pct { right: 16px; bottom: 16px; font-size: 12px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .reading-progress-fill { transition: none; }
  }
</style>

<script>
  const fill = document.getElementById('readingProgressFill');
  const pctEl = document.getElementById('readingProgressPct');
  function updateReadingProgress() {
    if (!fill) return;
    const h = document.documentElement;
    const max = h.scrollHeight - window.innerHeight;
    const pct = max > 0 ? (window.scrollY / max) * 100 : 0;
    const clamped = Math.min(Math.max(pct, 0), 100);
    fill.style.height = clamped + '%';
    if (pctEl) pctEl.textContent = Math.round(clamped) + '%';
  }
  window.addEventListener('scroll', updateReadingProgress, { passive: true });
  window.addEventListener('resize', updateReadingProgress);
  updateReadingProgress();
</script>
