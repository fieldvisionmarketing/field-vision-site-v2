<!-- UTM parameter capture — runs immediately, no consent needed -->
<script>
  (function() {
    const params = new URLSearchParams(window.location.search);
    const utmKeys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'];
    const utmData = {};
    let hasUtm = false;

    utmKeys.forEach(function(key) {
      const val = params.get(key);
      if (val) {
        utmData[key] = val;
        hasUtm = true;
      }
    });

    if (hasUtm) {
      // Store UTMs in sessionStorage for attribution
      sessionStorage.setItem('fv_utm', JSON.stringify(utmData));

      // Push to dataLayer for GTM
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: 'utm_captured',
        ...utmData
      });
    }

    // Also store landing page and referrer
    if (!sessionStorage.getItem('fv_landing')) {
      sessionStorage.setItem('fv_landing', window.location.href);
      sessionStorage.setItem('fv_referrer', document.referrer || 'direct');
    }
  })();
</script>
