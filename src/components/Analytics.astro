---
/**
 * Analytics Component
 *
 * Loads GA4 (gtag.js) immediately on every page load.
 * No consent gating, CCPA does not require opt-in consent for analytics.
 *
 * GTM is available as a container for future pixels (Meta, LinkedIn, etc.)
 *
 * IDs:
 * - GA4_ID: G-W2HXBJNJ6V (Google Analytics 4)
 * - GTM_ID: GTM-XXXXXXX (replace when GTM container is set up)
 */

const GA4_ID = 'G-W2HXBJNJ6V';
const GTM_ID = 'GTM-XXXXXXX'; // Replace with real GTM container ID when ready
---

<!-- GA4 (gtag.js), fires immediately on every page -->
<script is:inline src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`} async></script>
<script define:vars={{ GA4_ID }}>
  window.dataLayer = window.dataLayer || [];
  function gtag(){window.dataLayer.push(arguments);}
  window.gtag = gtag;
  gtag('js', new Date());
  gtag('config', GA4_ID, {
    send_page_view: true
  });
</script>

