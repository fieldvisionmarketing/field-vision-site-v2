---
/**
 * Analytics Component
 *
 * Loads GA4 (gtag.js) and GTM behind cookie consent.
 *
 * GA4 fires directly via gtag.js for immediate analytics.
 * GTM is available as a container for future pixels (Meta, LinkedIn, etc.)
 *
 * IDs:
 * - GA4_ID: G-W2HXBJNJ6V (Google Analytics 4)
 * - GTM_ID: GTM-XXXXXXX (replace when GTM container is set up)
 */

const GA4_ID = 'G-W2HXBJNJ6V';
const GTM_ID = 'GTM-XXXXXXX'; // Replace with real GTM container ID when ready
---

<!-- GA4 (gtag.js) — fires only after consent -->
<script define:vars={{ GA4_ID }}>
  window.addEventListener('fv-consent-granted', function() {
    // Only load once
    if (document.querySelector('script[src*="googletagmanager.com/gtag"]')) return;

    // Load gtag.js
    var script = document.createElement('script');
    script.async = true;
    script.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA4_ID;
    document.head.appendChild(script);

    // Initialize gtag
    window.dataLayer = window.dataLayer || [];
    function gtag(){window.dataLayer.push(arguments);}
    window.gtag = gtag;
    gtag('js', new Date());
    gtag('config', GA4_ID, {
      send_page_view: true
    });
  });

  // Initialize dataLayer
  window.dataLayer = window.dataLayer || [];
</script>

