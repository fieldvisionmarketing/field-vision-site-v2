---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Startup Marketing Blog" description="Insights on growth strategy, fractional CMO leadership, go-to-market playbooks, and building marketing systems for startups in digital media and entertainment.">
  <Header slot="header" />

  <section class="blog-listing">
    <div class="blog-listing-inner">
      <h1 class="reveal">Latest <span class="highlight">Insights</span></h1>
      <p class="section-sub reveal rd1">Growth strategy, frameworks, and lessons from a decade of scaling brands at Amazon, Twitch, and Pandora.</p>

      <div class="blog-grid" style="margin-top:48px">
        {posts.map((post, i) => (
          <a href={`/blog/${post.id.replace(/\.md$/, '')}/`} class={`blog-card reveal rd${(i % 3) + 1}`}>
            <div class="blog-body">
              <span class="blog-cat">{post.data.category}</span>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .blog-listing {
    padding: 140px 24px 80px;
  }
  .blog-listing-inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .blog-listing h1 {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4rem);
    text-transform: uppercase;
    line-height: 0.92;
    text-align: center;
  }
  .blog-listing .section-sub {
    text-align: center;
    max-width: 600px;
    margin: 16px auto 0;
  }
</style>
