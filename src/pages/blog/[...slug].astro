---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ReadingProgress from '@/components/ReadingProgress.astro';
import AuthorByline from '@/components/AuthorByline.astro';
import AuthorBio from '@/components/AuthorBio.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const rawBody = post.body || '';
const readingTime = rawBody ? Math.ceil(rawBody.split(/\s+/).length / 200) : 5;

const siteUrl = 'https://fieldvisiongroup.com';

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.data.title,
  "description": post.data.description,
  "author": {
    "@type": "Person",
    "name": post.data.author,
    "url": "https://www.linkedin.com/in/davidhampian/"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Field Vision Group",
    "url": siteUrl
  },
  "datePublished": post.data.date.toISOString(),
  ...(post.data.updated && { "dateModified": post.data.updated.toISOString() }),
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `${siteUrl}/blog/${post.id.replace(/\.md$/, '')}/`
  }
};
---

<BaseLayout
  title={post.data.seoTitle || post.data.title}
  description={post.data.description}
  ogImage={post.data.ogImage}
  ogType="article"
  publishDate={post.data.date.toISOString()}
>
  <Header slot="header" />

  <ReadingProgress />

  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    {post.data.schemaJson && (
      <script type="application/ld+json" set:html={post.data.schemaJson} />
    )}
  </Fragment>

  <article class="blog-article">
    <div class="article-header reveal">
      <span class="blog-cat">{post.data.category}</span>
      <h1>{post.data.title}</h1>
    </div>
    <AuthorByline date={post.data.date} readingTime={readingTime} />
    <div class="article-content">
      <Content />
    </div>
    <AuthorBio />
  </article>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .blog-article {
    max-width: 740px;
    margin: 0 auto;
    padding: 140px 24px 80px;
  }
  .article-header {
    margin-bottom: 48px;
  }
  .article-header h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    text-transform: uppercase;
    line-height: 1;
    margin: 16px 0 24px;
  }
  .article-meta {
    font-size: 0.95rem;
    color: #666;
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .meta-sep { opacity: 0.4; }
  .article-content :global(h2) {
    font-family: var(--font-display);
    font-size: 1.6rem;
    text-transform: uppercase;
    margin: 48px 0 16px;
    line-height: 1.1;
  }
  .article-content :global(h3) {
    font-family: var(--font-display);
    font-size: 1.25rem;
    text-transform: uppercase;
    margin: 36px 0 12px;
    line-height: 1.15;
  }
  .article-content :global(p) {
    font-size: 1.1rem;
    line-height: 1.75;
    margin-bottom: 20px;
    color: #333;
  }
  .article-content :global(ul),
  .article-content :global(ol) {
    margin: 16px 0 24px 24px;
    font-size: 1.1rem;
    line-height: 1.75;
  }
  .article-content :global(li) {
    margin-bottom: 8px;
  }
  .article-content :global(strong) {
    font-weight: 700;
  }
  .article-content :global(a) {
    color: var(--dark);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .article-content :global(blockquote) {
    border-left: 4px solid var(--accent);
    padding: 12px 24px;
    margin: 24px 0;
    font-style: italic;
    color: #555;
  }
  .article-content :global(hr) {
    border: none;
    border-top: 1px solid #e0e0e0;
    margin: 40px 0;
  }
  .article-content :global(.blog-hero-image) {
    display: block;
    width: 100%;
    height: auto;
    border: 4px solid var(--ink);
    box-shadow: 8px 8px 0 var(--ink);
    margin: 0 0 40px;
  }
  .article-content :global(.key-takeaway) {
    background: var(--offwhite);
    border: 4px solid var(--ink);
    box-shadow: 6px 6px 0 var(--ink);
    padding: 22px 26px;
    margin: 0 0 40px;
    font-size: 1.08rem;
    line-height: 1.7;
    color: var(--ink);
  }
  .article-content :global(.key-takeaway strong) {
    font-family: 'Anton', sans-serif;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--ink);
  }
  .article-content :global(code) {
    background: #f4f4f4;
    padding: 2px 6px;
    border-radius: 0;
    font-size: 0.95em;
  }
  .article-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 32px 0 40px;
    font-size: 1rem;
    line-height: 1.55;
    background: var(--paper);
    border: 3px solid var(--ink);
    box-shadow: 6px 6px 0 var(--ink);
  }
  .article-content :global(thead) {
    background: var(--ink);
  }
  .article-content :global(th) {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.4px;
    color: var(--offwhite);
    text-align: left;
    padding: 13px 16px;
    font-size: 0.92rem;
    line-height: 1.2;
    border-right: 1px solid rgba(239, 234, 211, 0.18);
  }
  .article-content :global(td) {
    padding: 13px 16px;
    border-top: 1px solid #e4dfcd;
    border-right: 1px solid #e4dfcd;
    color: #333;
    vertical-align: top;
  }
  .article-content :global(tbody tr:nth-child(even)) {
    background: var(--offwhite);
  }
  .article-content :global(th:last-child),
  .article-content :global(td:last-child) {
    border-right: none;
  }
  @media (max-width: 640px) {
    .article-content :global(table) {
      display: block;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
    .article-content :global(th),
    .article-content :global(td) {
      min-width: 150px;
    }
  }
</style>
