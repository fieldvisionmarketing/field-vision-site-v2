---
/* Private pitch: The Therapist x BetterHelp. Unlisted, DM only. */
import PitchPage from '@/components/PitchPage.astro';

const base = '/pitch/thetherapist-betterhelp';
const deck = '/pitch/thetherapist'; // shared, brand-neutral deck
const slides = Array.from({ length: 19 }, (_, i) => `${deck}/slides/slide-${String(i + 1).padStart(2, '0')}.webp`);
---

<PitchPage
  pageTitle="The Therapist x BetterHelp"
  brand="BetterHelp"
  show="The Therapist"
  subhead="A Season 2 partnership built for BetterHelp. Watch the sizzle, then open the deck."
  video={`${base}/pitch.mp4`}
  poster={`${base}/poster.jpg`}
  slides={slides}
  pdf={`${deck}/The-Therapist-Sponsorship-Deck.pdf`}
  ogImage={`${base}/og.jpg`}
  theme={{ bg: '#F3F7F0', surface: '#FFFFFF', ink: '#1E3A24', muted: '#4A5D4E', accent: '#5FAE47', accentDk: '#46903A' }}
/>
