---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

const cases = [
  {
    slug: "amazon-audience-development",
    company: "Amazon",
    title: "Audience Development at Amazon",
    desc: "Built and scaled audience development strategies across Amazon's entertainment portfolio, driving growth and acquisition at a global scale.",
    tags: ["Growth & Acquisition", "Global"],
    icon: "🎯"
  },
  {
    slug: "twitch-sells-out",
    company: "Amazon / Twitch",
    title: "Pioneering Creator Commerce: Twitch Sells Out",
    desc: "Four years before TikTok Shop, we created live creator commerce — a 36-hour QVC-style livestream that drove \$24M in incremental Prime Day revenue and 89K Prime sign-ups.",
    tags: ["Live Commerce", "Creator Marketing"],
    icon: "🛒"
  },
  {
    slug: "maestro",
    company: "Amazon Music",
    title: "Launching Maestro, Amazon's First AI Music Experience",
    desc: "Led the go-to-market strategy for Amazon Music's first AI-powered playlist generator, positioning the brand as the category innovator.",
    tags: ["Product Launch", "AI"],
    icon: "🤖"
  },
  {
    slug: "twitch",
    company: "Twitch",
    title: "Expanding Twitch Beyond Gaming into Sports & Music",
    desc: "Led the strategic expansion that took Twitch from a gaming-only platform into sports and music, unlocking new audiences and content verticals.",
    tags: ["Platform Expansion", "Sports & Music"],
    icon: "🚀"
  },
  {
    slug: "thursday-night-football",
    company: "Amazon / Twitch",
    title: "Inventing Creator-Led Sports Broadcasting with Thursday Night Football",
    desc: "Pioneered the creator-led broadcast model for Thursday Night Football, merging live sports with interactive streaming culture.",
    tags: ["Creator Marketing", "Sports"],
    icon: "🏈"
  },
  {
    slug: "pandora",
    company: "Pandora",
    title: "Growing Pandora to Over 80 Million Monthly Active Users",
    desc: "Led growth and lifecycle marketing that scaled Pandora's user base by 60%, building the full-funnel engine from acquisition through retention.",
    tags: ["Growth & Lifecycle", "Global"],
    icon: "📈"
  },
  {
    slug: "hard-rock-bet",
    company: "Hard Rock Digital",
    title: "Launching Hard Rock Bet Across Six States",
    desc: "Orchestrated the multi-state brand launch and growth strategy for Hard Rock's digital sports betting platform across six regulated markets.",
    tags: ["Brand Launch", "Multi-State"],
    icon: "🎰"
  },
  {
    slug: "amazon-music-live",
    company: "Amazon Music",
    title: "Architecting Amazon Music's Livestream Strategy",
    desc: "Designed and launched the livestream programming strategy that transformed Amazon Music from an audio platform into a live entertainment destination.",
    tags: ["Growth Strategy", "Live Programming"],
    icon: "🎬"
  },
  {
    slug: "pandora-ticketfly",
    company: "Pandora / Ticketfly",
    title: "Connecting Listeners to Live Music at Pandora & Ticketfly",
    desc: "Drove the audience development strategy that connected Pandora's streaming listeners to live music experiences through the Ticketfly integration.",
    tags: ["Audience Development", "Partnerships"],
    icon: "🎵"
  }
];
---

<BaseLayout
  title="Case Studies — Field Vision"
  description="Real results from real engagements. Explore how Field Vision has driven growth for Amazon, Pandora, Twitch, Hard Rock Bet, and more."
>
  <Header slot="header" />

  <!-- ═══ HERO (cream bookend per R9) ═══ -->
  <section class="cslp-hero">
    <div class="cslp-hero-inner">
      <span class="eyebrow">Case Studies</span>
      <h1>Our <span class="hl-green">Work</span></h1>
      <div class="cslp-hero-divider"></div>
      <p class="cslp-hero-sub">Real results from real engagements. Explore how we've driven growth, launched products, and built audiences for some of the biggest names in entertainment, streaming, and sports.</p>
    </div>
  </section>

  <!-- ═══ CASE STUDY CARDS (white bg) ═══ -->
  <section class="cslp-cards section">
    <div class="cslp-cards-inner">
      <div class="cslp-grid">
        {cases.map(c => (
          <a href={`/case-studies/${c.slug}/`} class="cslp-card">
            <div class="cslp-card-header">
              <span>{c.icon} {c.company}</span>
            </div>
            <div class="cslp-card-body">
              <h3>{c.title}</h3>
              <p>{c.desc}</p>
            </div>
            <div class="cslp-card-footer">
              <span class="cslp-card-link">View Case Study →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ CTA (offwhite bookend — diff from footer per R9) ═══ -->
  <section class="cslp-cta section" style="background:var(--offwhite)">
    <div class="cslp-cta-inner">
      <h2>Ready to Build Your <span class="hl-green">Growth Engine?</span></h2>
      <p>Let's talk about where you are, where you want to go, and how we can help you get there.</p>
      <a href="/contact/" class="btn-brutal">Book a Call <span>→</span></a>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
