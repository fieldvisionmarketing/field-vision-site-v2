---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import FinalCTA from '@/components/FinalCTA.astro';
---

<BaseLayout
  title="Pioneering Creator Commerce at Twitch | Field Vision"
  description="Four years before TikTok Shop, led the go-to-market for Twitch Sells Out — a 36-hour creator-led Prime Day livestream that drove $24M in revenue and 89K Prime sign-ups."
>
  <Header slot="header" />

<!-- Scroll progress bar -->
<div class="cs-scroll-progress" id="csScrollProgress"></div>

<!-- ═══ HERO ═══ -->
<div class="cs-hero-v2-wrapper">
  <div class="cs-hero-v2-sticky" id="csHero">
    <div class="cs-hero-v2-bg" style="background-image:url('https://static0.polygonimages.com/wordpress/wp-content/uploads/chorus/uploads/chorus_asset/file/16683784/Twitch_Sells_Out.jpg')"></div>
    <div class="cs-hero-v2-content">
      <h1>Pioneering Creator<br>Commerce at <span class="highlight-chip">Twitch</span></h1>
      <p class="cs-hero-v2-summary">
        Led the go-to-market for Twitch Sells Out — a 36-hour creator-led Prime Day
        livestream that drove $24M in revenue and 89K Prime sign-ups, establishing the
        live commerce category four years before TikTok Shop.
      </p>
      <div class="cs-scroll-hint">Scroll to explore</div>
    </div>
  </div>
</div>

<!-- ═══ STATS ═══ -->
<section class="cs-stats-v2" id="csStats">
  <div class="cs-stats-v2-inner">
    <div class="cs-stat-drop">
      <div class="cs-stat-drop-num" data-target="24" data-prefix="$" data-suffix="M">$0M</div>
      <div class="cs-stat-drop-label">Incremental Prime Day Revenue</div>
    </div>
    <div class="cs-stat-drop">
      <div class="cs-stat-drop-num" data-target="89" data-suffix="K">0K</div>
      <div class="cs-stat-drop-label">Prime Trial Sign-Ups</div>
    </div>
    <div class="cs-stat-drop">
      <div class="cs-stat-drop-num" data-target="115" data-suffix="M+">0M+</div>
      <div class="cs-stat-drop-label">Campaign Impressions</div>
    </div>
    <div class="cs-stat-drop">
      <div class="cs-stat-drop-num" data-target="32" data-prefix="+" data-suffix="%">+0%</div>
      <div class="cs-stat-drop-label">Creator Viewership Growth</div>
    </div>
  </div>
</section>

<!-- ═══ CHALLENGE ═══ -->
<section class="cs-challenge-v2">
  <div class="cs-challenge-v2-inner">
    <span class="eyebrow">The Challenge</span>
    <h2>Creating a Category That Didn't Exist</h2>

    <div class="cs-fly-card">
      <span class="cs-fly-card-num">1</span>
      <span class="cs-fly-card-text"><strong>No precedent for live commerce.</strong> Creator-led shopping didn't exist in the U.S. — no playbook for integrating sales into live entertainment.</span>
    </div>
    <div class="cs-fly-card">
      <span class="cs-fly-card-num">2</span>
      <span class="cs-fly-card-text"><strong>30 million non-Prime viewers to convert.</strong> Only 5M of Twitch's 35M U.S. viewers were Prime members — a massive conversion opportunity.</span>
    </div>
    <div class="cs-fly-card">
      <span class="cs-fly-card-num">3</span>
      <span class="cs-fly-card-text"><strong>36-hour live production with 29 creators.</strong> Marathon broadcast with 100+ products and complex commerce integrations requiring flawless orchestration.</span>
    </div>
    <div class="cs-fly-card">
      <span class="cs-fly-card-num">4</span>
      <span class="cs-fly-card-text"><strong>Authenticity at scale.</strong> Twitch's audience is skeptical of overt sales. Commerce had to enhance the experience, not interrupt it.</span>
    </div>

    <div class="cs-mandate-drop">
      <span class="eyebrow">The Mandate</span>
      <blockquote>
        Invent a live commerce format that drives Prime Day sales and sign-ups while staying
        true to Twitch's community-first culture — years before anyone else would attempt it.
      </blockquote>
    </div>
  </div>
</section>

<!-- ═══ APPROACH ═══ -->
<div class="cs-approach section">
  <div class="cs-section-inner">
    <span class="eyebrow">The Approach</span>
    <h2>QVC Meets Twitch</h2>
    <p class="cs-approach-insight">
      Reimagine the TV shopping format through Twitch culture:
      <em>irreverent, interactive, and creator-driven.</em>
    </p>

    <div class="cs-approach-grid">
      <div class="cs-phase-card">
        <div class="cs-phase-num">01</div>
        <div class="cs-phase-title">Concept &amp; Format Design</div>
        <div class="cs-phase-desc">
          Designed 18 two-hour segments pairing creators with products they authentically use,
          wrapped in satirical entertainment energy across a 36-hour marathon.
        </div>
        <div class="cs-phase-tools">
          <a href="/services/go-to-market" class="cs-phase-tool">Go-to-Market Strategy →</a>
        </div>
      </div>
      <div class="cs-phase-card">
        <div class="cs-phase-num">02</div>
        <div class="cs-phase-title">Multi-Channel Pre-Launch</div>
        <div class="cs-phase-desc">
          10-day campaign across paid social, email, house media, PR, and creator socials
          with custom video content. Drove awareness and sign-ups before the show started.
        </div>
        <div class="cs-phase-tools">
          <a href="/services/integrated-marketing" class="cs-phase-tool">Integrated Marketing →</a>
        </div>
      </div>
      <div class="cs-phase-card">
        <div class="cs-phase-num">03</div>
        <div class="cs-phase-title">Creator-Led Commerce</div>
        <div class="cs-phase-desc">
          Curated 29 creators with 100+ products. Integrated Amazon directly for
          in-stream purchasing — buy without leaving Twitch.
        </div>
        <div class="cs-phase-tools">
          <a href="/services/content-creator-marketing" class="cs-phase-tool">Content &amp; Creator Marketing →</a>
        </div>
      </div>
      <div class="cs-phase-card">
        <div class="cs-phase-num">04</div>
        <div class="cs-phase-title">Manufacturer Partnerships</div>
        <div class="cs-phase-desc">
          Sourced 7 of the top 10 products directly from manufacturers as exclusive
          Twitch deals. Transformed the format from cost center to revenue platform.
        </div>
        <div class="cs-phase-tools">
          <a href="/services/growth-marketing" class="cs-phase-tool">Growth &amp; Lifecycle Marketing →</a>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ═══ RESULTS ═══ -->
<section class="cs-results section">
  <div class="cs-results-inner">
    <span class="eyebrow">The Results</span>
    <h2>The Numbers Tell the Story</h2>

    <div class="cs-result-row">
      <div class="cs-result-row-num" data-target="24" data-prefix="$" data-suffix="M"><span class="accent">$</span>0M</div>
      <div>
        <div class="cs-result-label">Incremental Revenue</div>
        <div class="cs-result-desc">Drove $24M in Prime Day purchases. Viewers discovered products and expanded shopping across all of Prime Day, creating a halo effect beyond the 100+ featured items.</div>
      </div>
    </div>
    <div class="cs-result-row">
      <div class="cs-result-row-num" data-target="89" data-suffix="K">0K</div>
      <div>
        <div class="cs-result-label">Prime Trial Sign-Ups</div>
        <div class="cs-result-desc">89,006 new Prime sign-ups worldwide — a 19% lift. Over $10M in subscription value. 93% from Europe and North America.</div>
      </div>
    </div>
    <div class="cs-result-row">
      <div class="cs-result-row-num" data-target="115" data-suffix="M+">0M+</div>
      <div>
        <div class="cs-result-label">Campaign Impressions</div>
        <div class="cs-result-desc">Largest marketing reach Twitch achieved in 2019. Record 89.45% VCR on house ads across the multi-channel pre-launch campaign.</div>
      </div>
    </div>
    <div class="cs-result-row">
      <div class="cs-result-row-num" data-target="32" data-prefix="+" data-suffix="%"><span class="accent">+</span>0%</div>
      <div>
        <div class="cs-result-label">Creator Viewership Growth</div>
        <div class="cs-result-desc">Minutes watched grew 32%, total viewers up 18%, active viewers up 20% in the week following — proving the program was a positive force for creator growth.</div>
      </div>
    </div>
  </div>
</section>

<!-- ═══ IMPACT ═══ -->
<section class="cs-impact-v2">
  <div class="cs-impact-v2-inner">
    <span class="eyebrow">The Impact</span>
    <h2>From Strategy to Playbook</h2>

    <div class="cs-impact-v2-card">
      <div class="cs-impact-icon">🛒</div>
      <p class="cs-impact-text">
        Twitch Sells Out established the live creator commerce category in 2019 — four years
        before TikTok Shop launched in the U.S. The format proved that creator-driven shopping
        could drive $24M in revenue and $10M+ in subscription value at scale.
      </p>
    </div>

    <div class="cs-caps-grid" id="csCapsGrid">
      <a href="/services/go-to-market" class="cs-cap-chip">Go-to-Market Strategy</a>
      <a href="/services/integrated-marketing" class="cs-cap-chip">Integrated Marketing</a>
      <a href="/services/content-creator-marketing" class="cs-cap-chip">Content &amp; Creators</a>
      <a href="/services/growth-marketing" class="cs-cap-chip">Growth &amp; Lifecycle</a>
    </div>
  </div>
</section>

<!-- CTA -->
<FinalCTA />

  <Footer slot="footer" />
</BaseLayout>

<script>
  // Scroll progress
  window.addEventListener('scroll', () => {
    const p = (window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)) * 100;
    const bar = document.getElementById('csScrollProgress');
    if (bar) bar.style.width = p + '%';
  });

  // Hero activation
  setTimeout(() => document.getElementById('csHero')?.classList.add('active'), 300);

  // General reveal observer
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) e.target.classList.add('visible');
    });
  }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

  document.querySelectorAll(
    '.cs-challenge-v2 .eyebrow, .cs-challenge-v2 h2, .cs-fly-card, .cs-mandate-drop, ' +
    '.cs-approach .eyebrow, .cs-approach h2, .cs-approach-insight, .cs-approach-grid .cs-phase-card, ' +
    '.cs-results .eyebrow, .cs-results h2, .cs-result-row, ' +
    '.cs-impact-v2 .eyebrow, .cs-impact-v2 h2, .cs-impact-v2-card'
  ).forEach(el => obs.observe(el));

  // Stats auto-play drop-in
  let statsTriggered = false;
  const statsObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting && !statsTriggered) {
        statsTriggered = true;
        e.target.classList.add('in-view');
        const blocks = document.querySelectorAll('.cs-stat-drop');
        const nums = document.querySelectorAll('.cs-stat-drop-num[data-target]');
        blocks.forEach((block, i) => {
          setTimeout(() => {
            block.classList.add('dropped');
            const el = nums[i];
            const target = parseFloat(el.dataset.target);
            const prefix = el.dataset.prefix || '';
            const suffix = el.dataset.suffix || '';
            const isFloat = target % 1 !== 0;
            const duration = 1800;
            const start = performance.now();
            function update(now) {
              const elapsed = now - start;
              const progress = Math.min(elapsed / duration, 1);
              const eased = 1 - Math.pow(1 - progress, 3);
              const current = isFloat ? (target * eased).toFixed(1) : Math.round(target * eased);
              el.textContent = prefix + current + suffix;
              if (progress < 1) requestAnimationFrame(update);
            }
            requestAnimationFrame(update);
          }, i * 400);
        });
      }
    });
  }, { threshold: 0.3 });
  const statsEl = document.getElementById('csStats');
  if (statsEl) statsObs.observe(statsEl);

  // Results count-up
  let resultsCounted = false;
  const resultObs = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting && !resultsCounted) {
        resultsCounted = true;
        document.querySelectorAll('.cs-result-row-num[data-target]').forEach((el, i) => {
          setTimeout(() => {
            const target = parseFloat(el.dataset.target);
            const prefix = el.dataset.prefix || '';
            const suffix = el.dataset.suffix || '';
            const isFloat = target % 1 !== 0;
            const accentHtml = prefix ? '<span class="accent">' + prefix + '</span>' : '';
            const duration = 2000;
            const start = performance.now();
            function update(now) {
              const elapsed = now - start;
              const progress = Math.min(elapsed / duration, 1);
              const eased = 1 - Math.pow(1 - progress, 3);
              const current = isFloat ? (target * eased).toFixed(1) : Math.round(target * eased);
              el.innerHTML = accentHtml + current + suffix;
              if (progress < 1) requestAnimationFrame(update);
            }
            requestAnimationFrame(update);
          }, i * 200);
        });
      }
    });
  }, { threshold: 0.2 });
  const resultsEl = document.querySelector('.cs-results');
  if (resultsEl) resultObs.observe(resultsEl);

  // Cap chips staggered
  const capObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.querySelectorAll('.cs-cap-chip').forEach((chip, i) => {
          setTimeout(() => chip.classList.add('visible'), i * 150);
        });
        capObs.unobserve(e.target);
      }
    });
  }, { threshold: 0.3 });
  const capsEl = document.getElementById('csCapsGrid');
  if (capsEl) capObs.observe(capsEl);
</script>
