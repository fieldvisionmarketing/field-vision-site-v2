---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import FinalCTA from '@/components/FinalCTA.astro';
import RelatedIndustry from '@/components/RelatedIndustry.astro';
---

<BaseLayout
  title="Bridging Streaming and Live Music at Pandora &amp; Ticketfly | Field Vision"
  description="Built the Industry Marketing function that connected Pandora's listening data to Ticketfly's ticketing platform, driving 16M ticket sales, promoting 90K+ concerts, and creating the first streaming-to-ticketing integration."
>
  <Header slot="header" />

<!-- Scroll progress bar -->
<div class="cs-scroll-progress" id="csScrollProgress"></div>

<!-- ═══ HERO, Sticky parallax + blur-to-focus ═══ -->
<div class="cs-hero-v2-wrapper">
  <div class="cs-hero-v2-sticky" id="csHero">
    <div class="cs-hero-v2-bg" style="background-image:url('https://static.wixstatic.com/media/d84514_c70ef83a5a2d4069800cca10ffe8a119~mv2.png')"></div>
    <div class="cs-hero-v2-content">
      <h1>Bridging Streaming and<br><span class="highlight-chip">Ticket Sales</span> at Scale</h1>
      <p class="cs-hero-v2-summary">
        Built the Industry Marketing function that connected Pandora's listening data
        to Ticketfly's ticketing platform, driving 16 million ticket sales and promoting
        over 90,000 concerts.
      </p>
      <div class="cs-scroll-hint">Scroll to explore</div>
    </div>
  </div>
</div>

<!-- ═══ STATS, Auto-play drop-in ═══ -->
<section class="cs-stats-v2" id="csStats">
  <div class="cs-stats-v2-inner">
    <div class="cs-stat-drop">
      <div class="cs-stat-drop-num" data-target="16" data-suffix="M">0M</div>
      <div class="cs-stat-drop-label">Tickets Sold</div>
    </div>
    <div class="cs-stat-drop">
      <div class="cs-stat-drop-num" data-target="90" data-suffix="K+">0K+</div>
      <div class="cs-stat-drop-label">Concerts Promoted</div>
    </div>
    <div class="cs-stat-drop">
      <div class="cs-stat-drop-num">1st</div>
      <div class="cs-stat-drop-label">Streaming-to-Ticketing Integration</div>
    </div>
    <div class="cs-stat-drop">
      <div class="cs-stat-drop-num">New</div>
      <div class="cs-stat-drop-label">Industry Marketing Function</div>
    </div>
  </div>
</section>

<!-- ═══ CHALLENGE, Fly-in cards ═══ -->
<section class="cs-challenge-v2">
  <div class="cs-challenge-v2-inner">
    <span class="eyebrow">The Challenge</span>
    <h2>Streaming and Live Music in Separate Worlds</h2>

    <div class="cs-fly-card">
      <span class="cs-fly-card-num">1</span>
      <span class="cs-fly-card-text"><strong>No bridge between listening data and live events.</strong> Rich behavioral data on what listeners loved, but no mechanism to connect that insight to concert discovery or ticket purchasing.</span>
    </div>
    <div class="cs-fly-card">
      <span class="cs-fly-card-num">2</span>
      <span class="cs-fly-card-text"><strong>The music industry needed proof of real-world value.</strong> Artists, labels, and promoters needed to see that Pandora could drive outcomes beyond streams to invest as marketing partners.</span>
    </div>
    <div class="cs-fly-card">
      <span class="cs-fly-card-num">3</span>
      <span class="cs-fly-card-text"><strong>No Industry Marketing function existed.</strong> No dedicated team or strategy for working with the music industry as marketing partners, the function needed to be built from scratch.</span>
    </div>
    <div class="cs-fly-card">
      <span class="cs-fly-card-num">4</span>
      <span class="cs-fly-card-text"><strong>Scale required automation, not one-off campaigns.</strong> With 90,000+ concerts per year, the integration needed behavioral targeting and programmatic promotion at massive scale.</span>
    </div>

    <div class="cs-mandate-drop">
      <span class="eyebrow">The Mandate</span>
      <blockquote>
        Build the bridge between streaming and live music, creating a new revenue stream
        by connecting Pandora listeners directly to concerts and ticket purchases at scale.
      </blockquote>
    </div>
  </div>
</section>

<!-- ═══ APPROACH, 2x2 animated grid ═══ -->
<div class="cs-approach section">
  <div class="cs-section-inner">
    <span class="eyebrow">The Approach</span>
    <h2>Listening Data Becomes Concert Discovery.</h2>
    <p class="cs-approach-insight">
      The work started with one insight: <em>listening behavior is the most powerful signal
      for predicting concert attendance.</em> That connected two separate businesses into one engine.
    </p>

    <div class="cs-approach-grid">
      <div class="cs-phase-card">
        <div class="cs-phase-num">01</div>
        <div class="cs-phase-title">Industry Marketing from Scratch</div>
        <div class="cs-phase-desc">
          Created the Industry Marketing function at Pandora, establishing the strategy,
          team, and partnerships to position Pandora as an essential marketing partner
          for artists, labels, and promoters.
        </div>
        <div class="cs-phase-tools">
          <a href="/services/go-to-market" class="cs-phase-tool">Go-to-Market Strategy →</a>
        </div>
      </div>
      <div class="cs-phase-card">
        <div class="cs-phase-num">02</div>
        <div class="cs-phase-title">Behavioral Targeting at Scale</div>
        <div class="cs-phase-desc">
          Built targeting systems using Pandora's listening data, artist preferences,
          genre affinities, listening patterns, to match listeners with relevant concerts
          in their area.
        </div>
        <div class="cs-phase-tools">
          <a href="/services/growth-marketing" class="cs-phase-tool">Growth &amp; Lifecycle Marketing →</a>
        </div>
      </div>
      <div class="cs-phase-card">
        <div class="cs-phase-num">03</div>
        <div class="cs-phase-title">Integrated Ticketing Experience</div>
        <div class="cs-phase-desc">
          Embedded ticket purchasing directly into the Pandora experience, transforming
          the streaming platform from a passive listening tool into an active concert
          discovery engine.
        </div>
        <div class="cs-phase-tools">
          <a href="/services/integrated-marketing" class="cs-phase-tool">Integrated Marketing →</a>
        </div>
      </div>
      <div class="cs-phase-card">
        <div class="cs-phase-num">04</div>
        <div class="cs-phase-title">Artist &amp; Label Partnerships</div>
        <div class="cs-phase-desc">
          Built co-marketing programs with major labels, independent artists, and live
          promoters, using Pandora's platform to drive real-world ticket sales and
          artist revenue.
        </div>
        <div class="cs-phase-tools">
          <a href="/services/content-creator-marketing" class="cs-phase-tool">Content &amp; Creator Marketing →</a>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ═══ RESULTS, Count-up + alternating slide ═══ -->
<section class="cs-results section">
  <div class="cs-results-inner">
    <span class="eyebrow">The Results</span>
    <h2>The Numbers Tell the Story</h2>

    <div class="cs-result-row">
      <div class="cs-result-row-num" data-target="16" data-suffix="M">0M</div>
      <div>
        <div class="cs-result-label">Tickets Sold</div>
        <div class="cs-result-desc">16 million tickets sold through the integrated Pandora-Ticketfly experience, proving that streaming data could drive real-world concert attendance at massive scale.</div>
      </div>
    </div>
    <div class="cs-result-row">
      <div class="cs-result-row-num" data-target="90" data-suffix="K+">0K+</div>
      <div>
        <div class="cs-result-label">Concerts Promoted</div>
        <div class="cs-result-desc">Over 90,000 concerts promoted through behavioral targeting, matching listeners with live shows based on actual listening preferences and geographic proximity.</div>
      </div>
    </div>
    <div class="cs-result-row">
      <div class="cs-result-row-num">1st</div>
      <div>
        <div class="cs-result-label">Streaming-to-Ticketing Integration</div>
        <div class="cs-result-desc">Built the first scalable integration between a streaming platform's listening intelligence and a ticketing platform's purchase infrastructure, creating a new category.</div>
      </div>
    </div>
    <div class="cs-result-row">
      <div class="cs-result-row-num">New</div>
      <div>
        <div class="cs-result-label">Industry Marketing Function</div>
        <div class="cs-result-desc">Built the Industry Marketing function from zero, team, strategy, partnerships, and programs, positioning Pandora as essential to the live music marketing ecosystem.</div>
      </div>
    </div>
  </div>
</section>

<!-- ═══ IMPACT, Own reveal section ═══ -->
<section class="cs-impact-v2">
  <div class="cs-impact-v2-inner">
    <span class="eyebrow">The Impact</span>
    <h2>From Strategy to Playbook</h2>

    <div class="cs-impact-v2-card">
      <div class="cs-impact-icon">↗</div>
      <p class="cs-impact-text">
        The Pandora-Ticketfly integration proved that streaming platforms could drive
        real-world outcomes at scale. By connecting listening behavior to concert attendance,
        we created a new revenue stream for Pandora and established the platform as more
        than a place to listen, an essential partner in the broader music ecosystem.
      </p>
    </div>
  </div>
</section>

<!-- CTA -->
<RelatedIndustry items={[{ label: 'Fractional CMO for Music Startups', href: '/industries/music/' }]} />
<FinalCTA />

  <Footer slot="footer" />
</BaseLayout>

<script>
  // Scroll progress
  window.addEventListener('scroll', () => {
    const p = (window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)) * 100;
    const bar = document.getElementById('csScrollProgress');
    if (bar) bar.style.width = p + '%';
  });

  // Hero activation
  setTimeout(() => document.getElementById('csHero')?.classList.add('active'), 300);

  // General reveal observer
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) e.target.classList.add('visible');
    });
  }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

  document.querySelectorAll(
    '.cs-challenge-v2 .eyebrow, .cs-challenge-v2 h2, .cs-fly-card, .cs-mandate-drop, ' +
    '.cs-approach .eyebrow, .cs-approach h2, .cs-approach-insight, .cs-approach-grid .cs-phase-card, ' +
    '.cs-results .eyebrow, .cs-results h2, .cs-result-row, ' +
    '.cs-impact-v2 .eyebrow, .cs-impact-v2 h2, .cs-impact-v2-card'
  ).forEach(el => obs.observe(el));

  // Stats auto-play drop-in
  let statsTriggered = false;
  const statsObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting && !statsTriggered) {
        statsTriggered = true;
        e.target.classList.add('in-view');
        const blocks = document.querySelectorAll('.cs-stat-drop');
        const nums = document.querySelectorAll('.cs-stat-drop-num[data-target]');
        blocks.forEach((block, i) => {
          setTimeout(() => {
            block.classList.add('dropped');
            const el = nums[i];
            const target = parseFloat(el.dataset.target);
            const prefix = el.dataset.prefix || '';
            const suffix = el.dataset.suffix || '';
            const isFloat = target % 1 !== 0;
            const duration = 1800;
            const start = performance.now();
            function update(now) {
              const elapsed = now - start;
              const progress = Math.min(elapsed / duration, 1);
              const eased = 1 - Math.pow(1 - progress, 3);
              const current = isFloat ? (target * eased).toFixed(1) : Math.round(target * eased);
              el.textContent = prefix + current + suffix;
              if (progress < 1) requestAnimationFrame(update);
            }
            requestAnimationFrame(update);
          }, i * 400);
        });
      }
    });
  }, { threshold: 0.3 });
  const statsEl = document.getElementById('csStats');
  if (statsEl) statsObs.observe(statsEl);

  // Results count-up
  let resultsCounted = false;
  const resultObs = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting && !resultsCounted) {
        resultsCounted = true;
        document.querySelectorAll('.cs-result-row-num[data-target]').forEach((el, i) => {
          setTimeout(() => {
            const target = parseFloat(el.dataset.target);
            const prefix = el.dataset.prefix || '';
            const suffix = el.dataset.suffix || '';
            const isFloat = target % 1 !== 0;
            const accentHtml = prefix === '+' ? '<span class="accent">+</span>' : '';
            const duration = 2000;
            const start = performance.now();
            function update(now) {
              const elapsed = now - start;
              const progress = Math.min(elapsed / duration, 1);
              const eased = 1 - Math.pow(1 - progress, 3);
              const current = isFloat ? (target * eased).toFixed(1) : Math.round(target * eased);
              el.innerHTML = accentHtml + (prefix === '+' ? '' : prefix) + current + suffix;
              if (progress < 1) requestAnimationFrame(update);
            }
            requestAnimationFrame(update);
          }, i * 200);
        });
      }
    });
  }, { threshold: 0.2 });
  const resultsEl = document.querySelector('.cs-results');
  if (resultsEl) resultObs.observe(resultsEl);

  // Cap chips staggered
  const capObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.querySelectorAll('.cs-cap-chip').forEach((chip, i) => {
          setTimeout(() => chip.classList.add('visible'), i * 150);
        });
        capObs.unobserve(e.target);
      }
    });
  }, { threshold: 0.3 });
  const capsEl = document.getElementById('csCapsGrid');
  if (capsEl) capObs.observe(capsEl);
</script>
