---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
---

<BaseLayout title="Connecting Listeners to Live Music at Pandora &amp; Ticketfly" description="A Field Vision case study - Connecting Listeners to Live Music at Pandora &amp; Ticketfly">
  <Header slot="header" />

  <!-- ═══════════════════════════════════════════
     SECTION 1: HERO
     ═══════════════════════════════════════════ -->
<section class="hero">
  <div class="hero-inner">
    <div>
      <span class="section-tag">Case Study</span>
      <h1>Connecting Listeners to Live Music at Pandora &amp; Ticketfly</h1>
      <p class="hero-desc">
        When Pandora acquired Ticketfly, we saw an opportunity to build something the industry had never done: connect streaming listeners directly to live concert experiences at scale. I built the Industry Marketing function that bridged listening data with ticketing — driving 16 million ticket sales and promoting over 90,000 concerts.
      </p>
      <div class="hero-meta">
        <div class="hero-meta-item">
          <span class="hero-meta-label">Company</span>
          <span class="hero-meta-value">Pandora / Ticketfly</span>
        </div>
        <div class="hero-meta-item">
          <span class="hero-meta-label">Industry</span>
          <span class="hero-meta-value">Music / Live Events</span>
        </div>
        <div class="hero-meta-item">
          <span class="hero-meta-label">Scope</span>
          <span class="hero-meta-value">National</span>
        </div>
        <div class="hero-meta-item">
          <span class="hero-meta-label">Focus</span>
          <span class="hero-meta-value">Industry Marketing &amp; Ticketing</span>
        </div>
      </div>
    </div>
    <div class="hero-image" style="padding:0; background:none; border:none;">
                <img src="https://static.wixstatic.com/media/d84514_c70ef83a5a2d4069800cca10ffe8a119~mv2.png" alt="Pandora Ticketfly marketing collage" style="width:100%; height:100%; object-fit:cover; border-radius:var(--radius);" />
            </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════
     SECTION 2: RESULTS STRIP
     ═══════════════════════════════════════════ -->
<section class="results-strip">
  <div class="results-strip-inner">
    <div class="result-stat">
      <div class="result-number">16M</div>
      <div class="result-label">Tickets Sold</div>
    </div>
    <div class="result-stat">
      <div class="result-number">90K+</div>
      <div class="result-label">Concerts Promoted</div>
    </div>
    <div class="result-stat">
      <div class="result-number">1st</div>
      <div class="result-label">Streaming-to-Ticketing Integration</div>
    </div>
    <div class="result-stat">
      <div class="result-number">New</div>
      <div class="result-label">Industry Marketing Function</div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════
     SECTION 3: THE SITUATION
     ═══════════════════════════════════════════ -->
<section class="content-section">
  <span class="section-tag">The Situation</span>
  <h2>Streaming and Live Music Existed in Separate Worlds</h2>
  <p>
    Pandora had the largest audience in digital music with deep listening behavior data. Ticketfly was a fast-growing ticketing platform for independent venues and promoters. But the two businesses operated independently, with no connection between a listener's streaming habits and their concert-going behavior.
  </p>
  <div class="challenge-grid">
    <ul class="challenge-points">
      <li class="challenge-point">
        <div class="challenge-icon">1</div>
        <div class="challenge-text">
          <strong>No bridge between listening data and live events.</strong> Despite having rich behavioral data on what listeners loved, there was no mechanism to connect that insight to concert discovery or ticket purchasing.
        </div>
      </li>
      <li class="challenge-point">
        <div class="challenge-icon">2</div>
        <div class="challenge-text">
          <strong>Artists, labels, and promoters needed proof of value.</strong> The music industry needed to see that Pandora could drive real-world outcomes — not just streams — to invest in the platform as a marketing partner.
        </div>
      </li>
      <li class="challenge-point">
        <div class="challenge-icon">3</div>
        <div class="challenge-text">
          <strong>No Industry Marketing function existed.</strong> Pandora had no dedicated team or strategy for working with the music industry as marketing partners — the function needed to be built from scratch.
        </div>
      </li>
      <li class="challenge-point">
        <div class="challenge-icon">4</div>
        <div class="challenge-text">
          <strong>Scale required automation, not one-off campaigns.</strong> With 90,000+ concerts per year, the ticketing integration needed to work at massive scale through behavioral targeting and programmatic promotion.
        </div>
      </li>
    </ul>
    <div class="challenge-callout">
      <span class="section-tag">The Mandate</span>
      <blockquote>
        Build the bridge between streaming and live music — creating a new revenue stream by connecting Pandora listeners directly to concerts and ticket purchases at scale.
      </blockquote>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════
     SECTION 4: THE APPROACH
     ═══════════════════════════════════════════ -->
<div class="approach-bg">
  <div class="content-section">
    <span class="section-tag">The Approach</span>
    <h2>Turning Listening Data into Live Music Experiences</h2>
    <p>
      We built an entirely new function — Industry Marketing — that connected Pandora's listening intelligence to the live music ecosystem. The strategy linked behavioral data to concert promotion, enabling listeners to discover and purchase tickets to shows from artists they already loved.
    </p>
    <div class="approach-phases">
      <div class="phase-card">
        <div class="phase-number">01</div>
        <div class="phase-title">Built Industry Marketing from Scratch</div>
        <div class="phase-desc">
          Created the Industry Marketing function at Pandora, establishing the strategy, team, and partnerships needed to position Pandora as an essential marketing partner for artists, labels, and promoters.
        </div>
        <div class="phase-tools">
          <a href="/services/go-to-market" class="phase-tool">Go-to-Market Strategy →</a>
        </div>
      </div>
      <div class="phase-card">
        <div class="phase-number">02</div>
        <div class="phase-title">Behavioral Targeting at Scale</div>
        <div class="phase-desc">
          Built targeting systems that used Pandora's listening data — artist preferences, genre affinities, listening patterns — to match listeners with relevant concerts in their area, driving ticket discovery and purchase.
        </div>
        <div class="phase-tools">
          <a href="/services/growth-marketing" class="phase-tool">Growth &amp; Lifecycle Marketing →</a>
        </div>
      </div>
      <div class="phase-card">
        <div class="phase-number">03</div>
        <div class="phase-title">Integrated Ticketing Experience</div>
        <div class="phase-desc">
          Embedded ticket purchasing directly into the Pandora listener experience — transforming the streaming platform from a passive listening tool into an active concert discovery engine.
        </div>
        <div class="phase-tools">
          <a href="/services/integrated-marketing" class="phase-tool">Integrated Marketing →</a>
        </div>
      </div>
      <div class="phase-card">
        <div class="phase-number">04</div>
        <div class="phase-title">Artist &amp; Label Partnerships</div>
        <div class="phase-desc">
          Built marketing programs with major labels, independent artists, and live promoters — creating co-marketing campaigns that used Pandora's platform to drive real-world ticket sales and artist revenue.
        </div>
        <div class="phase-tools">
          <a href="/services/content-creator-marketing" class="phase-tool">Content &amp; Creator Marketing →</a>
        </div>
      </div>
    </div>
  </div>
</div>



<!-- ═══════════════════════════════════════════
     SECTION 6: BEFORE / AFTER
     ═══════════════════════════════════════════ -->
<section class="before-after">
  <div class="before-after-inner">
    <span class="section-tag">Transformation</span>
    <h2>Before &amp; After Industry Marketing</h2>
    <div class="ba-grid">
      <div class="ba-column ba-before">
        <div class="ba-label">Before</div>
        <div class="ba-item">
          <div class="ba-bullet"></div>
          <div class="ba-item-text">No connection between streaming listening data and live concert experiences</div>
        </div>
        <div class="ba-item">
          <div class="ba-bullet"></div>
          <div class="ba-item-text">Pandora and Ticketfly operated as completely separate businesses</div>
        </div>
        <div class="ba-item">
          <div class="ba-bullet"></div>
          <div class="ba-item-text">No Industry Marketing function — no strategy for artist, label, or promoter partnerships</div>
        </div>
        <div class="ba-item">
          <div class="ba-bullet"></div>
          <div class="ba-item-text">Music industry saw Pandora as a streaming platform, not a marketing partner</div>
        </div>
      </div>
      <div class="ba-column ba-after">
        <div class="ba-label">After</div>
        <div class="ba-item">
          <div class="ba-bullet"></div>
          <div class="ba-item-text">Behavioral targeting connected listeners to concerts based on their actual listening habits</div>
        </div>
        <div class="ba-item">
          <div class="ba-bullet"></div>
          <div class="ba-item-text">16 million tickets sold through integrated streaming-to-ticketing experience</div>
        </div>
        <div class="ba-item">
          <div class="ba-bullet"></div>
          <div class="ba-item-text">Full Industry Marketing function built — dedicated team, strategy, and partnership programs</div>
        </div>
        <div class="ba-item">
          <div class="ba-bullet"></div>
          <div class="ba-item-text">90,000+ concerts promoted, establishing Pandora as essential to live music marketing</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════
     SECTION 7: RESULTS DEEP DIVE
     ═══════════════════════════════════════════ -->
<section class="results-section">
  <div class="results-inner">
    <span class="section-tag">Results</span>
    <h2 style="font-family:'Anton',sans-serif; font-size:clamp(28px,3.5vw,40px); text-transform:uppercase; color:var(--dark); margin-bottom:8px;">
      The Numbers Tell the Story
    </h2>
    <p style="font-size:16px; color:rgba(33,54,33,0.65); max-width:600px;">
      A new function built from scratch that transformed how the music industry connected with fans.
    </p>
    <div class="results-grid">
      <div class="result-card">
        <div class="result-card-metric">16M</div>
        <div class="result-card-label">Tickets Sold</div>
        <div class="result-card-desc">
          16 million tickets sold through the integrated Pandora-Ticketfly experience, proving that streaming listening data could drive real-world concert attendance at massive scale.
        </div>
        <div class="result-card-bar"><div class="result-card-bar-fill" style="width:95%"></div></div>
      </div>
      <div class="result-card">
        <div class="result-card-metric">90K+</div>
        <div class="result-card-label">Concerts Promoted</div>
        <div class="result-card-desc">
          Over 90,000 concerts promoted through behavioral targeting — matching listeners with live shows based on their actual listening preferences and geographic proximity.
        </div>
        <div class="result-card-bar"><div class="result-card-bar-fill" style="width:90%"></div></div>
      </div>
      <div class="result-card">
        <div class="result-card-metric">1st</div>
        <div class="result-card-label">Streaming-to-Ticketing Integration</div>
        <div class="result-card-desc">
          Built the first scalable integration between a streaming platform's listening intelligence and a ticketing platform's purchase infrastructure — creating a new category for music marketing.
        </div>
        <div class="result-card-bar"><div class="result-card-bar-fill" style="width:85%"></div></div>
      </div>
      <div class="result-card">
        <div class="result-card-metric">New</div>
        <div class="result-card-label">Industry Marketing Function</div>
        <div class="result-card-desc">
          Built the Industry Marketing function from zero — team, strategy, partnerships, and programs — positioning Pandora as an essential marketing partner for artists, labels, and live promoters.
        </div>
        <div class="result-card-bar"><div class="result-card-bar-fill" style="width:80%"></div></div>
      </div>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════
     SECTION 8: IMPACT
     ═══════════════════════════════════════════ -->
<section class="impact-section">
  <span class="section-tag">Impact</span>
  <h2>From Streaming Platform to Music Marketing Engine</h2>
  <p>
    The Pandora-Ticketfly integration proved that streaming platforms could drive real-world outcomes at scale. By building the bridge between listening behavior and concert attendance, we created a new revenue stream for Pandora while giving artists, labels, and promoters a powerful new marketing channel.
  </p>
  <p>
    The Industry Marketing function established Pandora as more than a place to listen — it became an essential partner in the broader music ecosystem, connecting fans to the live experiences they craved.
  </p>
  <div class="impact-callout">
    <div class="impact-icon">🎵</div>
    <div class="impact-text">
      By connecting streaming data to live music, we sold 16 million tickets and promoted 90,000+ concerts — proving that listening behavior is the most powerful signal for predicting concert attendance.
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════
     SECTION 9: SERVICES USED
     ═══════════════════════════════════════════ -->
<section class="services-used">
  <span class="section-tag">Capabilities Applied</span>
  <h2 style="font-family:'Anton',sans-serif; font-size:clamp(24px,3vw,32px); text-transform:uppercase; color:var(--dark); margin-bottom:8px;">
    What This Took
  </h2>
  <div class="services-pills">
    <a href="/services/go-to-market" class="service-pill">Go-to-Market Strategy</a>
    <a href="/services/integrated-marketing" class="service-pill">Integrated Marketing</a>
    <a href="/services/content-creator-marketing" class="service-pill">Content &amp; Creator Marketing</a>
    <a href="/services/growth-marketing" class="service-pill">Growth &amp; Lifecycle Marketing</a>
  </div>
</section>

<!-- ═══════════════════════════════════════════
     SECTION 10: CTA
     ═══════════════════════════════════════════ -->
<section class="cta-section">
  <h2>Ready to Build Your Growth Engine?</h2>
  <p>
    Every engagement starts with a conversation. Let's talk about where you are, where you want to go, and how to get there.
  </p>
  <a href="#" class="cta-btn">Book a Strategy Call</a>
</section>

<div class="lightbox-overlay" id="heroLightbox" onclick="this.classList.remove('active')">
    <span class="lightbox-close">&times;</span>
    <img id="lightboxImg" src="" alt="" />
</div>
<script>
    (function() {
        var heroImg = document.querySelector('.hero-image img');
        if (!heroImg) return;
        var overlay = document.getElementById('heroLightbox');
        var lbImg = document.getElementById('lightboxImg');
        heroImg.addEventListener('click', function() {
            lbImg.src = heroImg.src;
            lbImg.alt = heroImg.alt;
            overlay.classList.add('active');
        });
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') overlay.classList.remove('active');
        });
    })();
</script>
<script>(function(){var hb=document.querySelector('.hamburger'),mn=document.querySelector('.mobile-nav');if(!hb||!mn)return;hb.addEventListener('click',function(){hb.classList.toggle('active');mn.classList.toggle('open');hb.setAttribute('aria-expanded',hb.classList.contains('active')?'true':'false');document.body.style.overflow=mn.classList.contains('open')?'hidden':'';}); document.querySelectorAll('.mobile-nav a').forEach(function(l){l.addEventListener('click',function(){hb.classList.remove('active');mn.classList.remove('open');hb.setAttribute('aria-expanded','false');document.body.style.overflow='';});});})();</script>

  <Footer slot="footer" />
</BaseLayout>

<style is:global>
.section-tag {
    font-family: 'Satoshi', sans-serif;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2.5px;
    color: var(--tan);
    margin-bottom: 12px;
    display: block;
}
.hero {
    background: var(--dark);
    color: var(--cream);
    padding: 152px 24px 60px;
    position: relative;
    overflow: hidden;
}
.hero-inner {
    max-width: var(--max-w);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
}
.hero .section-tag { color: var(--accent); }
.hero h1 {
    font-family: 'Anton', sans-serif;
    font-size: clamp(36px, 5vw, 56px);
    line-height: 1.05;
    text-transform: uppercase;
    letter-spacing: -0.5px;
    margin-bottom: 20px;
}
.hero-desc {
    font-size: 16px;
    color: rgba(239,234,211,0.8);
    max-width: 500px;
    margin-bottom: 28px;
    line-height: 1.7;
}
.hero-meta { display: flex; gap: 24px; flex-wrap: wrap; }
.hero-meta-item { display: flex; flex-direction: column; gap: 2px; }
.hero-meta-label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--tan);
    font-weight: 700;
}
.hero-meta-value { font-size: 14px; font-weight: 600; color: var(--cream); }
.hero-image {
    border-radius: var(--radius);
    overflow: hidden;
    background: rgba(239,234,211,0.08);
    border: 1px solid rgba(239,234,211,0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--tan);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 1px;
    text-transform: uppercase;
}
.results-strip { background: var(--accent); padding: 40px 24px; }
.results-strip-inner {
    max-width: var(--max-w);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    text-align: center;
}
.result-number {
    font-family: 'Anton', sans-serif;
    font-size: clamp(28px, 4vw, 44px);
    color: var(--dark);
    line-height: 1;
    margin-bottom: 4px;
}
.result-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: rgba(33,54,33,0.7);
}
.content-section {
    padding: 72px 24px;
    max-width: var(--max-w);
    margin: 0 auto;
}
.content-section h2 {
    font-family: 'Anton', sans-serif;
    font-size: clamp(28px, 3.5vw, 40px);
    text-transform: uppercase;
    color: var(--dark);
    margin-bottom: 24px;
    line-height: 1.1;
}
.content-section p {
    font-size: 16px;
    color: rgba(33,54,33,0.75);
    max-width: 720px;
    margin-bottom: 16px;
    line-height: 1.8;
}
.challenge-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 48px;
    align-items: start;
    margin-top: 32px;
}
.challenge-points {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
}
.challenge-point { display: flex; gap: 14px; align-items: flex-start; }
.challenge-icon {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--dark);
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    flex-shrink: 0;
    margin-top: 2px;
    font-weight: 700;
}
.challenge-text { font-size: 15px; color: var(--dark); line-height: 1.6; }
.challenge-text strong { font-weight: 700; }
.challenge-callout {
    background: var(--dark);
    color: var(--cream);
    border-radius: var(--radius);
    padding: 32px;
}
.challenge-callout .section-tag { color: var(--accent); margin-bottom: 16px; }
.challenge-callout blockquote {
    font-size: 18px;
    font-style: italic;
    line-height: 1.6;
    margin-bottom: 16px;
    color: rgba(239,234,211,0.9);
}
.challenge-callout cite {
    font-size: 13px;
    font-style: normal;
    color: var(--tan);
    font-weight: 600;
}
.approach-bg { background: var(--dark); padding: 72px 24px; }
.approach-bg .content-section { padding: 0; max-width: var(--max-w); margin: 0 auto; }
.approach-bg .section-tag { color: var(--accent); }
.approach-bg h2 { color: var(--cream); }
.approach-bg p { color: rgba(239,234,211,0.7); }
.approach-phases {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 40px;
}
.phase-card {
    background: rgba(239,234,211,0.06);
    border: 1px solid rgba(239,234,211,0.1);
    border-radius: var(--radius);
    padding: 28px;
    transition: border-color 0.3s;
}
.phase-card:hover { border-color: var(--accent); }
.phase-number {
    font-family: 'Anton', sans-serif;
    font-size: 36px;
    color: var(--accent);
    line-height: 1;
    margin-bottom: 12px;
}
.phase-title { font-size: 15px; font-weight: 700; color: var(--cream); margin-bottom: 8px; }
.phase-desc { font-size: 13px; color: rgba(239,234,211,0.6); line-height: 1.6; }
.phase-tools { margin-top: 14px; display: flex; flex-wrap: wrap; gap: 6px; }
.phase-tool {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 4px 10px;
    border-radius: 20px;
    background: rgba(165,219,93,0.12);
    color: var(--accent);
    text-decoration: none;
    transition: background 0.3s, color 0.3s;
    display: inline-block;
}
a.phase-tool:hover { background: var(--accent); color: var(--dark); }
.gallery-section {
    padding: 72px 24px;
    max-width: var(--max-w);
    margin: 0 auto;
}
.before-after { background: var(--dark); padding: 72px 24px; }
.before-after-inner { max-width: var(--max-w); margin: 0 auto; }
.before-after .section-tag { color: var(--accent); }
.before-after h2 {
    color: var(--cream);
    font-family: 'Anton', sans-serif;
    font-size: clamp(28px,3.5vw,40px);
    text-transform: uppercase;
    margin-bottom: 40px;
}
.ba-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
.ba-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 20px;
    padding-bottom: 12px;
}
.ba-before .ba-label { color: var(--tan); border-bottom: 2px solid rgba(185,169,143,0.3); }
.ba-after .ba-label { color: var(--accent); border-bottom: 2px solid var(--accent); }
.ba-item { display: flex; gap: 12px; align-items: flex-start; margin-bottom: 16px; }
.ba-bullet { width: 8px; height: 8px; border-radius: 50%; margin-top: 6px; flex-shrink: 0; }
.ba-before .ba-bullet { background: var(--tan); opacity: 0.5; }
.ba-after .ba-bullet { background: var(--accent); }
.ba-item-text { font-size: 14px; line-height: 1.6; }
.ba-before .ba-item-text { color: rgba(239,234,211,0.5); }
.ba-after .ba-item-text { color: rgba(239,234,211,0.85); }
.results-section { background: var(--light-cream); padding: 72px 24px; }
.results-inner { max-width: var(--max-w); margin: 0 auto; }
.results-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-top: 40px;
}
.result-card {
    background: white;
    border-radius: var(--radius);
    padding: 32px;
    border: 1px solid rgba(185,169,143,0.2);
}
.result-card-metric {
    font-family: 'Anton', sans-serif;
    font-size: 40px;
    color: var(--dark);
    line-height: 1;
    margin-bottom: 4px;
}
.result-card-label {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--tan);
