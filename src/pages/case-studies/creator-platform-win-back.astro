---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import FinalCTA from '@/components/FinalCTA.astro';
import RelatedIndustry from '@/components/RelatedIndustry.astro';
---

<BaseLayout
  title="Content Over Cash: A Win-Back Engine for Creator Platforms | Field Vision"
  description="We tested whether a creator platform could win back lapsed customers with content instead of cash. Measured against a true control group, content won at zero cost and scales into an automated revenue engine."
>
  <Header slot="header" />

<!-- Scroll progress bar -->
<div class="cs-scroll-progress" id="csScrollProgress"></div>

<!-- ═══ HERO ═══ -->
<div class="cs-hero-v2-wrapper">
  <div class="cs-hero-v2-sticky" id="csHero">
    <div class="cs-hero-v2-bg" style="background:linear-gradient(135deg,#18271a,#2f4a2f)"></div>
    <div class="cs-hero-v2-content">
      <h1>Content over cash:<br>a win-back engine for <span class="highlight-chip">a Creator Platform</span></h1>
      <p class="cs-hero-v2-summary">I was brought in to answer a question the creator economy usually solves with its wallet: can you win lapsed customers back without paying them to return? We designed a controlled test that put a content-led reminder head to head with a cash credit, measured against a true no-email control group. Content won, at zero cost, and it scales into an automated revenue engine.</p>
      <div class="cs-scroll-hint">Scroll to explore</div>
    </div>
  </div>
</div>

<!-- ═══ STATS ═══ -->
<section class="cs-stats-v2" id="csStats">
  <div class="cs-stats-v2-inner">
    <div class="cs-stat-drop">
      <div class="cs-stat-drop-num" data-target="21" data-prefix="" data-suffix="%">0%</div>
      <div class="cs-stat-drop-label">Lapsed customers reactivated</div>
    </div>
    <div class="cs-stat-drop">
      <div class="cs-stat-drop-num" data-target="0" data-prefix="$" data-suffix="">$0</div>
      <div class="cs-stat-drop-label">Incentive cost</div>
    </div>
    <div class="cs-stat-drop">
      <div class="cs-stat-drop-num" data-target="80" data-prefix="$" data-suffix="K">$0K</div>
      <div class="cs-stat-drop-label">Savings per campaign</div>
    </div>
    <div class="cs-stat-drop">
      <div class="cs-stat-drop-num" data-target="600" data-prefix="$" data-suffix="K">$0K</div>
      <div class="cs-stat-drop-label">Annual run rate</div>
    </div>
  </div>
</section>

<!-- ═══ CHALLENGE ═══ -->
<section class="cs-challenge-v2">
  <div class="cs-challenge-v2-inner">
    <span class="eyebrow">The Challenge</span>
    <h2>Winning back lost customers without burning cash to do it</h2>

    <div class="cs-fly-card">
      <span class="cs-fly-card-num">1</span>
      <span class="cs-fly-card-text"><strong>Churn at scale.</strong> The platform was losing a large share of its paying customers every month, and the money walking out the door dwarfed anything a single campaign could cost.</span>
    </div>
    <div class="cs-fly-card">
      <span class="cs-fly-card-num">2</span>
      <span class="cs-fly-card-text"><strong>The cash-credit reflex.</strong> The category instinct is to buy lapsed users back with account credit, an approach that quietly erodes margin and had never been tested against a real baseline.</span>
    </div>
    <div class="cs-fly-card">
      <span class="cs-fly-card-num">3</span>
      <span class="cs-fly-card-text"><strong>No proof either way.</strong> No one knew whether win-back emails actually caused reactivation, or whether those customers would have drifted back on their own.</span>
    </div>
    <div class="cs-fly-card">
      <span class="cs-fly-card-num">4</span>
      <span class="cs-fly-card-text"><strong>No measurement discipline.</strong> Earlier efforts ran with no control group, so any result could be credited to the campaign or to chance, with no way to tell them apart.</span>
    </div>

    <div class="cs-mandate-drop">
      <span class="eyebrow">The Mandate</span>
      <blockquote>Find out what actually brings lapsed customers back, prove it against a real control group, and do it without giving away margin.</blockquote>
    </div>
  </div>
</section>

<!-- ═══ APPROACH ═══ -->
<div class="cs-approach section">
  <div class="cs-section-inner">
    <span class="eyebrow">The Approach</span>
    <h2>A controlled test of content against cash</h2>
    <p class="cs-approach-insight">Treat reactivation as a science experiment, not a campaign. Hold everything constant, change one thing, and let a true control group tell us what the email actually earned.</p>

    <div class="cs-approach-grid">
      <div class="cs-phase-card">
        <div class="cs-phase-num">01</div>
        <div class="cs-phase-title">Design the experiment</div>
        <div class="cs-phase-desc">We built a randomized test with a true no-email control group, a cash-credit arm, and a content-led arm. That structure meant every outcome could be read as real, incremental lift rather than a guess.</div>
        <div class="cs-phase-tools">
          <a href="/services/fractional-cmo/" class="cs-phase-tool">Fractional CMO →</a>
        </div>
      </div>
      <div class="cs-phase-card">
        <div class="cs-phase-num">02</div>
        <div class="cs-phase-title">Build the content engine</div>
        <div class="cs-phase-desc">The content arm reminded each customer of the creator they most loved and the posts they had missed, personalized at scale and carrying no incentive. It cost nothing to send beyond the email itself.</div>
        <div class="cs-phase-tools">
          <a href="/services/content-creator-marketing/" class="cs-phase-tool">Content &amp; Creator Marketing →</a>
        </div>
      </div>
      <div class="cs-phase-card">
        <div class="cs-phase-num">03</div>
        <div class="cs-phase-title">Measure what the email caused</div>
        <div class="cs-phase-desc">We tracked every cohort over a 30-day window against the control and decided on real incremental revenue, not vanity opens or clicks. The content email beat both the cash credit and doing nothing.</div>
        <div class="cs-phase-tools">
          <a href="/services/growth-marketing/" class="cs-phase-tool">Growth Marketing →</a>
        </div>
      </div>
      <div class="cs-phase-card">
        <div class="cs-phase-num">04</div>
        <div class="cs-phase-title">Turn the winner into a system</div>
        <div class="cs-phase-desc">We translated one proven email into an always-on, automated program, plus a roadmap of four follow-on experiments designed to compound its performance over the following two quarters.</div>
        <div class="cs-phase-tools">
          <a href="/services/integrated-marketing/" class="cs-phase-tool">Integrated Marketing →</a>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ═══ RESULTS ═══ -->
<section class="cs-results section">
  <div class="cs-results-inner">
    <span class="eyebrow">The Results</span>
    <h2>One test, a free engine, and a clear path to scale</h2>

    <div class="cs-result-row">
      <div class="cs-result-row-num" data-target="21" data-prefix="" data-suffix="%">0%</div>
      <div>
        <div class="cs-result-label">Lapsed customers reactivated</div>
        <div class="cs-result-desc">A content-led reminder brought roughly one in five lapsed customers back within 30 days, outperforming both a cash credit and no outreach at all.</div>
      </div>
    </div>
    <div class="cs-result-row">
      <div class="cs-result-row-num" data-target="0" data-prefix="$" data-suffix=""><span class="accent">$</span>0</div>
      <div>
        <div class="cs-result-label">Incentive cost per reactivation</div>
        <div class="cs-result-desc">The winning approach brings customers back with relevant content, not cash, so it earns at no incentive cost.</div>
      </div>
    </div>
    <div class="cs-result-row">
      <div class="cs-result-row-num" data-target="80" data-prefix="$" data-suffix="K"><span class="accent">$</span>0K</div>
      <div>
        <div class="cs-result-label">Savings per campaign</div>
        <div class="cs-result-desc">A cash-credit approach cost real money for no added return. Retiring it strips that expense out of every campaign.</div>
      </div>
    </div>
    <div class="cs-result-row">
      <div class="cs-result-row-num" data-target="600" data-prefix="$" data-suffix="K"><span class="accent">$</span>0K</div>
      <div>
        <div class="cs-result-label">Annual run rate</div>
        <div class="cs-result-desc">Rolled out across the lapsed base and ongoing monthly churn, the program runs at this annualized pace, fully automated and measured against a control.</div>
      </div>
    </div>
  </div>
</section>

<!-- ═══ IMPACT ═══ -->
<section class="cs-impact-v2">
  <div class="cs-impact-v2-inner">
    <span class="eyebrow">The Impact</span>
    <h2>A free growth engine, and a playbook to keep sharpening it</h2>

    <div class="cs-impact-v2-card">
      <div class="cs-impact-icon">🔁</div>
      <p class="cs-impact-text">The first test replaced an expensive, unproven habit with a measured, content-led program that reactivates customers for free. It retired a cash-credit approach that cost real money for no return, stood up an automated engine already running at a six-figure annual pace, and handed the founders a clear, evidence-backed roadmap to multiply it. Most importantly, it gave the business a repeatable way to learn, where every future send is measured against a control, so the program keeps getting better while it earns.</p>
    </div>

    <div class="cs-caps-grid" id="csCapsGrid">
      <a href="/services/growth-marketing/" class="cs-cap-chip">Lifecycle &amp; Retention</a>
      <a href="/services/integrated-marketing/" class="cs-cap-chip">Experimentation &amp; Measurement</a>
      <a href="/services/content-creator-marketing/" class="cs-cap-chip">Content Strategy</a>
      <a href="/services/fractional-cmo/" class="cs-cap-chip">Fractional CMO Leadership</a>
    </div>
  </div>
</section>

<!-- CTA -->
<RelatedIndustry items={[{ label: 'Creator Economy', href: '/industries/creator-economy/' }]} />
<FinalCTA />

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* ── FEATURE VIDEO — dark section that flows out of the stats ── */
  /* Stats block defaults to 100vh with centered numbers, leaving a half-screen
     void below them. Compact it here so the video sits right under the numbers. */
  .cs-stats-v2 {
    min-height: auto;
    padding: 120px 24px 48px;
  }
  .cs-video-v2 {
    background: var(--ink);
    padding: 48px 24px 120px;
  }
  .cs-video-v2-inner {
    max-width: 1000px;
    margin: 0 auto;
    text-align: center;
  }
  .cs-video-v2 .eyebrow {
    color: var(--green-lt);
    opacity: 0;
    transform: translateX(-20px);
    transition: all 0.6s ease;
  }
  .cs-video-v2 .eyebrow::before { background: var(--green-lt); }
  .cs-video-v2 .eyebrow.visible { opacity: 1; transform: translateX(0); }
  .cs-video-v2 h2 {
    font-family: 'Anton', sans-serif;
    color: var(--offwhite);
    font-size: clamp(32px, 5vw, 56px);
    line-height: 1.05;
    margin: 12px 0 40px;
    opacity: 0;
    filter: blur(8px);
    transform: translateY(20px);
    transition: all 0.7s ease;
  }
  .cs-video-v2 h2.visible { opacity: 1; filter: blur(0); transform: translateY(0); }
  .cs-video-embed {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(165, 219, 93, 0.25);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
    opacity: 0;
    transform: translateY(40px) scale(0.97);
    transition: opacity 0.8s ease, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cs-video-embed.visible { opacity: 1; transform: translateY(0) scale(1); }
  .cs-video-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  @supports not (aspect-ratio: 16 / 9) {
    .cs-video-embed { height: 0; padding-top: 56.25%; }
  }
</style>

<script>
  // Scroll progress
  window.addEventListener('scroll', () => {
    const p = (window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)) * 100;
    const bar = document.getElementById('csScrollProgress');
    if (bar) bar.style.width = p + '%';
  });

  // Hero activation
  setTimeout(() => document.getElementById('csHero')?.classList.add('active'), 300);

  // General reveal observer
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) e.target.classList.add('visible');
    });
  }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

  document.querySelectorAll(
    '.cs-video-v2 .eyebrow, .cs-video-v2 h2, .cs-video-embed, ' +
    '.cs-challenge-v2 .eyebrow, .cs-challenge-v2 h2, .cs-fly-card, .cs-mandate-drop, ' +
    '.cs-approach .eyebrow, .cs-approach h2, .cs-approach-insight, .cs-approach-grid .cs-phase-card, ' +
    '.cs-results .eyebrow, .cs-results h2, .cs-result-row, ' +
    '.cs-impact-v2 .eyebrow, .cs-impact-v2 h2, .cs-impact-v2-card'
  ).forEach(el => obs.observe(el));

  // Stats auto-play drop-in
  let statsTriggered = false;
  const statsObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting && !statsTriggered) {
        statsTriggered = true;
        e.target.classList.add('in-view');
        const blocks = document.querySelectorAll('.cs-stat-drop');
        const nums = document.querySelectorAll('.cs-stat-drop-num[data-target]');
        blocks.forEach((block, i) => {
          setTimeout(() => {
            block.classList.add('dropped');
            const el = nums[i];
            const target = parseFloat(el.dataset.target);
            const prefix = el.dataset.prefix || '';
            const suffix = el.dataset.suffix || '';
            const isFloat = target % 1 !== 0;
            const duration = 1800;
            const start = performance.now();
            function update(now) {
              const elapsed = now - start;
              const progress = Math.min(elapsed / duration, 1);
              const eased = 1 - Math.pow(1 - progress, 3);
              const current = isFloat ? (target * eased).toFixed(1) : Math.round(target * eased);
              el.textContent = prefix + current + suffix;
              if (progress < 1) requestAnimationFrame(update);
            }
            requestAnimationFrame(update);
          }, i * 400);
        });
      }
    });
  }, { threshold: 0.3 });
  const statsEl = document.getElementById('csStats');
  if (statsEl) statsObs.observe(statsEl);

  // Results count-up
  let resultsCounted = false;
  const resultObs = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting && !resultsCounted) {
        resultsCounted = true;
        document.querySelectorAll('.cs-result-row-num[data-target]').forEach((el, i) => {
          setTimeout(() => {
            const target = parseFloat(el.dataset.target);
            const prefix = el.dataset.prefix || '';
            const suffix = el.dataset.suffix || '';
            const isFloat = target % 1 !== 0;
            const accentHtml = prefix ? '<span class="accent">' + prefix + '</span>' : '';
            const duration = 2000;
            const start = performance.now();
            function update(now) {
              const elapsed = now - start;
              const progress = Math.min(elapsed / duration, 1);
              const eased = 1 - Math.pow(1 - progress, 3);
              const current = isFloat ? (target * eased).toFixed(1) : Math.round(target * eased);
              el.innerHTML = accentHtml + current + suffix;
              if (progress < 1) requestAnimationFrame(update);
            }
            requestAnimationFrame(update);
          }, i * 200);
        });
      }
    });
  }, { threshold: 0.2 });
  const resultsEl = document.querySelector('.cs-results');
  if (resultsEl) resultObs.observe(resultsEl);

  // Cap chips staggered
  const capObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.querySelectorAll('.cs-cap-chip').forEach((chip, i) => {
          setTimeout(() => chip.classList.add('visible'), i * 150);
        });
        capObs.unobserve(e.target);
      }
    });
  }, { threshold: 0.3 });
  const capsEl = document.getElementById('csCapsGrid');
  if (capsEl) capObs.observe(capsEl);
</script>