---
/**
 * CASE STUDY — MONTREALITY
 * Built on case-study-template.astro v2.0 (Animated). CS rules CS1-CS29 + Brutalist v2.4.
 * Source: 2026 brand guide (client-era receipts). v3 realignment.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import FinalCTA from '@/components/FinalCTA.astro';
import CaseStudyTestimonial from '@/components/CaseStudyTestimonial.astro';
---

<BaseLayout
  title="MONTREALITY Case Study | Fractional CMO for Music & Creator Media"
  description="How Field Vision turned a 15-year creator-led music media brand into a sponsorship business, authoring the strategy and closing its first six-figure partnership with Adobe."
>
  <Header slot="header" />

<!-- Scroll progress bar -->
<div class="cs-scroll-progress" id="csScrollProgress"></div>

<!-- ═══ HERO — CS4-CS8 ═══ -->
<div class="cs-hero-v2-wrapper">
  <div class="cs-hero-v2-sticky" id="csHero">
    <div class="cs-hero-v2-bg" style="background-image:url('/case-studies/montreality-hero.jpg')"></div>
    <div class="cs-hero-v2-content">
      <h1>A Business and Sponsorship<br>Strategy for <span class="highlight-chip">MONTREALITY</span></h1>
      <p class="cs-hero-v2-summary">We built the business and sponsorship strategy, led the outreach, and closed MONTREALITY's first six-figure partnership, with Adobe, turning 15 years of audience trust into a repeatable revenue engine.</p>
      <div class="cs-scroll-hint">Scroll to explore</div>
    </div>
  </div>
</div>

<!-- ═══ STATS — CS9-CS12 ═══ -->
<section class="cs-stats-v2" id="csStats">
  <div class="cs-stats-v2-inner">
    <div class="cs-stat-drop">
      <div class="cs-stat-drop-num" data-target="6" data-prefix="" data-suffix="">0</div>
      <div class="cs-stat-drop-label">Figure Partnership with Adobe</div>
    </div>
    <div class="cs-stat-drop">
      <div class="cs-stat-drop-num" data-target="1" data-prefix="" data-suffix="st">0st</div>
      <div class="cs-stat-drop-label">Tier-One Brand Partner</div>
    </div>
    <div class="cs-stat-drop">
      <div class="cs-stat-drop-num" data-target="15" data-prefix="" data-suffix="">0</div>
      <div class="cs-stat-drop-label">Years of Audience, Monetized</div>
    </div>
    <div class="cs-stat-drop">
      <div class="cs-stat-drop-num" data-target="8" data-prefix="" data-suffix="">0</div>
      <div class="cs-stat-drop-label">Person Team, Six-Figure Deal</div>
    </div>
  </div>
</section>

<!-- ═══ FEATURE VIDEO ═══ -->
<section class="cs-video-v2" id="csVideo">
  <div class="cs-video-v2-inner">
    <span class="eyebrow">See It Live</span>
    <h2>THE SERIES: LAYERS</h2>
    <p class="cs-video-sub">MONTREALITY x Field Vision x Adobe</p>
    <div class="cs-video-embed">
      <iframe
        src="https://www.youtube-nocookie.com/embed/tVz2IAAxttE?rel=0"
        title="MONTREALITY, The Design Process behind 20,000 Iconic Album Covers (LAYERS)"
        loading="lazy"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</section>

<!-- ═══ TESTIMONIAL ═══ -->
<section class="cs-testimonial-band">
  <CaseStudyTestimonial
    quote="Working with Field Vision has been a game-changer for MONTREALITY. They helped us revamp our media kit into something sharper, more premium, and brand-ready, and also improved our outreach approach with clearer messaging and stronger positioning."
    name="Sina Ghiassi & Daniel Yanez"
    title="Founders, MONTREALITY"
  />
</section>

<!-- ═══ CHALLENGE — CS13-CS16 ═══ -->
<section class="cs-challenge-v2">
  <div class="cs-challenge-v2-inner">
    <span class="eyebrow">The Challenge</span>
    <h2>Fifteen Years of Audience, No Business Model to Match</h2>

    <div class="cs-fly-card">
      <span class="cs-fly-card-num">1</span>
      <span class="cs-fly-card-text"><strong>No formal business model.</strong> The brand's value lived in relationships and reputation, with nothing structured that a corporate partner could evaluate or buy.</span>
    </div>
    <div class="cs-fly-card">
      <span class="cs-fly-card-num">2</span>
      <span class="cs-fly-card-text"><strong>An undersold audience.</strong> Fifteen years of loyal, culturally influential audience had never been packaged into a partnership story a brand could price.</span>
    </div>
    <div class="cs-fly-card">
      <span class="cs-fly-card-num">3</span>
      <span class="cs-fly-card-text"><strong>No outbound motion.</strong> There was no pipeline, no pitch, and no repeatable process for reaching and closing tier-one brands.</span>
    </div>
    <div class="cs-fly-card">
      <span class="cs-fly-card-num">4</span>
      <span class="cs-fly-card-text"><strong>A small team with big ambition.</strong> Eight people needed a strategy they could actually run, not a deck that sat on a shelf.</span>
    </div>

    <div class="cs-mandate-drop">
      <span class="eyebrow">The Mandate</span>
      <blockquote>Turn a trusted creator brand into a business tier-one partners will pay for, and prove it with a signed deal.</blockquote>
    </div>
  </div>
</section>

<!-- ═══ APPROACH — CS17-CS20 ═══ -->
<div class="cs-approach section">
  <div class="cs-section-inner">
    <span class="eyebrow">The Approach</span>
    <h2>Package the Trust, Then Go Sell It</h2>
    <p class="cs-approach-insight">The work started with positioning, <em>naming exactly what MONTREALITY offered a brand that no one else could</em>, then built the sponsorship model, ran the outbound motion, and closed.</p>

    <div class="cs-approach-grid">
      <div class="cs-phase-card">
        <div class="cs-phase-num">01</div>
        <div class="cs-phase-title">Position the Brand</div>
        <div class="cs-phase-desc">Defined MONTREALITY's distinct value to a corporate partner: a trusted, creator-led voice in music with 15 years of audience equity. Turned that into a sharp, buyable story.</div>
        <div class="cs-phase-tools">
          <a href="/services/brand-strategy-positioning" class="cs-phase-tool">Brand Strategy &amp; Positioning →</a>
        </div>
      </div>
      <div class="cs-phase-card">
        <div class="cs-phase-num">02</div>
        <div class="cs-phase-title">Build the Sponsorship Model</div>
        <div class="cs-phase-desc">Designed partnership tiers, deliverables, and pricing that matched the audience's real worth, so sponsorship became a repeatable product the team could sell.</div>
        <div class="cs-phase-tools">
          <a href="/services/go-to-market" class="cs-phase-tool">Go-to-Market Strategy →</a>
        </div>
      </div>
      <div class="cs-phase-card">
        <div class="cs-phase-num">03</div>
        <div class="cs-phase-title">Run the Outreach</div>
        <div class="cs-phase-desc">Built the target list and the pitch, then led outreach to tier-one brands, opening conversations the team had never had access to before.</div>
        <div class="cs-phase-tools">
          <a href="/services/go-to-market" class="cs-phase-tool">Go-to-Market Strategy →</a>
        </div>
      </div>
      <div class="cs-phase-card">
        <div class="cs-phase-num">04</div>
        <div class="cs-phase-title">Close the Deal</div>
        <div class="cs-phase-desc">Led the pitch process end to end and closed MONTREALITY's first six-figure partnership with Adobe, leaving the team a playbook they could run again.</div>
        <div class="cs-phase-tools">
          <a href="/services/fractional-cmo" class="cs-phase-tool">Fractional CMO →</a>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ═══ RESULTS — CS21-CS22 ═══ -->
<section class="cs-results section">
  <div class="cs-results-inner">
    <span class="eyebrow">The Results</span>
    <h2>The Numbers Tell the Story</h2>

    <div class="cs-result-row">
      <div class="cs-result-row-num" data-target="6" data-prefix="" data-suffix="-Figures">0-Figures</div>
      <div>
        <div class="cs-result-label">First Partnership</div>
        <div class="cs-result-desc">MONTREALITY's first six-figure sponsorship, closed with Adobe, set the floor for what the brand's audience is worth.</div>
      </div>
    </div>
    <div class="cs-result-row">
      <div class="cs-result-row-num" data-target="1" data-prefix="" data-suffix="st">0st</div>
      <div>
        <div class="cs-result-label">Tier-One Brand</div>
        <div class="cs-result-desc">The first tier-one partner in the brand's 15-year history, opening the door to a category of buyers.</div>
      </div>
    </div>
    <div class="cs-result-row">
      <div class="cs-result-row-num" data-target="15" data-prefix="" data-suffix="">0</div>
      <div>
        <div class="cs-result-label">Years Monetized</div>
        <div class="cs-result-desc">More than a decade of audience equity, finally packaged into a product that partners will pay for.</div>
      </div>
    </div>
    <div class="cs-result-row">
      <div class="cs-result-row-num" data-target="1" data-prefix="" data-suffix="">0</div>
      <div>
        <div class="cs-result-label">Repeatable Playbook</div>
        <div class="cs-result-desc">A sponsorship model and pitch the eight-person team can run again without outside help.</div>
      </div>
    </div>
  </div>
</section>

<!-- ═══ IMPACT — CS23-CS25 ═══ -->
<section class="cs-impact-v2">
  <div class="cs-impact-v2-inner">
    <span class="eyebrow">The Impact</span>
    <h2>From Beloved to Bankable</h2>

    <div class="cs-impact-v2-card">
      <div class="cs-impact-icon">↗</div>
      <p class="cs-impact-text">MONTREALITY spent fifteen years earning real trust inside music culture. The gap was never the audience, it was the absence of a business model that let a company like Adobe say yes. With a positioning platform, a sponsorship strategy, and an outbound motion in place, the brand closed its first six-figure partnership and kept the playbook to sell the next one itself.</p>
    </div>
  </div>
</section>

<!-- CTA -->
<FinalCTA />

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* ── FEATURE VIDEO — dark section that flows out of the stats ── */
  .cs-stats-v2 {
    min-height: auto;
    padding: 120px 24px 48px;
  }
  .cs-video-v2 {
    background: var(--ink);
    padding: 48px 24px 120px;
  }
  .cs-video-v2-inner {
    max-width: 1000px;
    margin: 0 auto;
    text-align: center;
  }
  .cs-video-v2 .eyebrow {
    color: var(--green-lt);
    opacity: 0;
    transform: translateX(-20px);
    transition: all 0.6s ease;
  }
  .cs-video-v2 .eyebrow::before { background: var(--green-lt); }
  .cs-video-v2 .eyebrow.visible { opacity: 1; transform: translateX(0); }
  .cs-video-v2 h2 {
    font-family: 'Anton', sans-serif;
    color: var(--offwhite);
    font-size: clamp(32px, 5vw, 56px);
    line-height: 1.05;
    margin: 12px 0 10px;
    opacity: 0;
    filter: blur(8px);
    transform: translateY(20px);
    transition: all 0.7s ease;
  }
  .cs-video-v2 h2.visible { opacity: 1; filter: blur(0); transform: translateY(0); }
  .cs-video-sub {
    font-family: 'Archivo', sans-serif;
    font-size: 15px;
    letter-spacing: 0.06em;
    color: var(--green-lt);
    margin: 0 0 40px;
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.6s ease 0.1s;
  }
  .cs-video-sub.visible { opacity: 1; transform: translateY(0); }
  .cs-video-embed {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(165, 219, 93, 0.25);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
    opacity: 0;
    transform: translateY(40px) scale(0.97);
    transition: opacity 0.8s ease, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cs-video-embed.visible { opacity: 1; transform: translateY(0) scale(1); }
  .cs-video-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  @supports not (aspect-ratio: 16 / 9) {
    .cs-video-embed { height: 0; padding-top: 56.25%; }
  }
</style>

<script>
  // Scroll progress
  window.addEventListener('scroll', () => {
    const p = (window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)) * 100;
    const bar = document.getElementById('csScrollProgress');
    if (bar) bar.style.width = p + '%';
  });

  // Hero activation
  setTimeout(() => document.getElementById('csHero')?.classList.add('active'), 300);

  // General reveal observer
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) e.target.classList.add('visible');
    });
  }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

  document.querySelectorAll(
    '.cs-video-v2 .eyebrow, .cs-video-v2 h2, .cs-video-v2 .cs-video-sub, .cs-video-embed, ' +
    '.cs-challenge-v2 .eyebrow, .cs-challenge-v2 h2, .cs-fly-card, .cs-mandate-drop, ' +
    '.cs-approach .eyebrow, .cs-approach h2, .cs-approach-insight, .cs-approach-grid .cs-phase-card, ' +
    '.cs-results .eyebrow, .cs-results h2, .cs-result-row, ' +
    '.cs-impact-v2 .eyebrow, .cs-impact-v2 h2, .cs-impact-v2-card, .cs-impact-quote'
  ).forEach(el => obs.observe(el));

  // Stats auto-play drop-in
  let statsTriggered = false;
  const statsObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting && !statsTriggered) {
        statsTriggered = true;
        e.target.classList.add('in-view');
        const blocks = document.querySelectorAll('.cs-stat-drop');
        const nums = document.querySelectorAll('.cs-stat-drop-num[data-target]');
        blocks.forEach((block, i) => {
          setTimeout(() => {
            block.classList.add('dropped');
            const el = nums[i];
            const target = parseFloat(el.dataset.target);
            const prefix = el.dataset.prefix || '';
            const suffix = el.dataset.suffix || '';
            const isFloat = target % 1 !== 0;
            const duration = 1800;
            const start = performance.now();
            function update(now) {
              const elapsed = now - start;
              const progress = Math.min(elapsed / duration, 1);
              const eased = 1 - Math.pow(1 - progress, 3);
              const current = isFloat ? (target * eased).toFixed(1) : Math.round(target * eased);
              el.textContent = prefix + current + suffix;
              if (progress < 1) requestAnimationFrame(update);
            }
            requestAnimationFrame(update);
          }, i * 400);
        });
      }
    });
  }, { threshold: 0.3 });
  const statsEl = document.getElementById('csStats');
  if (statsEl) statsObs.observe(statsEl);

  // Results count-up
  let resultsCounted = false;
  const resultObs = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting && !resultsCounted) {
        resultsCounted = true;
        document.querySelectorAll('.cs-result-row-num[data-target]').forEach((el, i) => {
          setTimeout(() => {
            const target = parseFloat(el.dataset.target);
            const prefix = el.dataset.prefix || '';
            const suffix = el.dataset.suffix || '';
            const isFloat = target % 1 !== 0;
            const duration = 2000;
            const start = performance.now();
            function update(now) {
              const elapsed = now - start;
              const progress = Math.min(elapsed / duration, 1);
              const eased = 1 - Math.pow(1 - progress, 3);
              const current = isFloat ? (target * eased).toFixed(1) : Math.round(target * eased);
              el.textContent = prefix + current + suffix;
              if (progress < 1) requestAnimationFrame(update);
            }
            requestAnimationFrame(update);
          }, i * 200);
        });
      }
    });
  }, { threshold: 0.2 });
  const resultsEl = document.querySelector('.cs-results');
  if (resultsEl) resultObs.observe(resultsEl);

  // Cap chips staggered
  const capObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.querySelectorAll('.cs-cap-chip').forEach((chip, i) => {
          setTimeout(() => chip.classList.add('visible'), i * 150);
        });
        capObs.unobserve(e.target);
      }
    });
  }, { threshold: 0.3 });
  const capsEl = document.getElementById('csCapsGrid');
  if (capsEl) capObs.observe(capsEl);
</script>
