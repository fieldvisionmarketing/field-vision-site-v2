---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import FinalCTA from '@/components/FinalCTA.astro';
---

<BaseLayout
  title="Launching a Sportsbook from Scratch at Hard Rock Bet | Field Vision"
  description="Built Hard Rock Bet from brand inception through six state launches — exceeding acquisition forecasts by 232%, delivering ARPU 17% above target, and launching the first legal sportsbook in Florida."
>
  <Header slot="header" />

<!-- Scroll progress bar -->
<div class="cs-scroll-progress" id="csScrollProgress"></div>

<!-- ═══ HERO — Sticky parallax + blur-to-focus ═══ -->
<div class="cs-hero-v2-wrapper">
  <div class="cs-hero-v2-sticky" id="csHero">
    <div class="cs-hero-v2-bg" style="background-image:url('https://static.wixstatic.com/media/d84514_dbb68c529f1145b08893fe4cbfa525e2~mv2.png')"></div>
    <div class="cs-hero-v2-content">
      <h1><span class="highlight-chip">Redefining</span> a<br>Legacy Brand</h1>
      <p class="cs-hero-v2-summary">
        Built the brand, marketing engine, and go-to-market strategy that launched Hard
        Rock Bet across six states — exceeding acquisition forecasts by 232% against
        billion-dollar incumbents.
      </p>
      <div class="cs-scroll-hint">Scroll to explore</div>
    </div>
  </div>
</div>

<!-- ═══ STATS — Auto-play drop-in ═══ -->
<section class="cs-stats-v2" id="csStats">
  <div class="cs-stats-v2-inner">
    <div class="cs-stat-drop">
      <div class="cs-stat-drop-num" data-target="232" data-prefix="+" data-suffix="%">+0%</div>
      <div class="cs-stat-drop-label">Exceeded Acquisition Forecasts</div>
    </div>
    <div class="cs-stat-drop">
      <div class="cs-stat-drop-num" data-target="6" data-suffix=" States">0 States</div>
      <div class="cs-stat-drop-label">Markets Launched</div>
    </div>
    <div class="cs-stat-drop">
      <div class="cs-stat-drop-num" data-target="17" data-prefix="+" data-suffix="%">+0%</div>
      <div class="cs-stat-drop-label">ARPU Above Target</div>
    </div>
    <div class="cs-stat-drop">
      <div class="cs-stat-drop-num">1st</div>
      <div class="cs-stat-drop-label">Legal Sportsbook in Florida</div>
    </div>
  </div>
</section>

<!-- ═══ CHALLENGE — Fly-in cards ═══ -->
<section class="cs-challenge-v2">
  <div class="cs-challenge-v2-inner">
    <span class="eyebrow">The Challenge</span>
    <h2>Building a Brand in a Billion-Dollar Market</h2>

    <div class="cs-fly-card">
      <span class="cs-fly-card-num">1</span>
      <span class="cs-fly-card-text"><strong>Entering a market dominated by well-funded incumbents.</strong> DraftKings and FanDuel had already spent billions on brand awareness and customer acquisition.</span>
    </div>
    <div class="cs-fly-card">
      <span class="cs-fly-card-num">2</span>
      <span class="cs-fly-card-text"><strong>No sportsbook brand or infrastructure existed.</strong> Brand identity, creative systems, media strategy, and acquisition engine all needed to be built from zero.</span>
    </div>
    <div class="cs-fly-card">
      <span class="cs-fly-card-num">3</span>
      <span class="cs-fly-card-text"><strong>Florida launch with national ambitions.</strong> The first legal sportsbook in the third-largest state was a high-stakes debut, with five more states to follow.</span>
    </div>
    <div class="cs-fly-card">
      <span class="cs-fly-card-num">4</span>
      <span class="cs-fly-card-text"><strong>Retention was the real battleground.</strong> In a category where sign-up bonuses drive switching, building engagement beyond the first bet was critical to profitability.</span>
    </div>

    <div class="cs-mandate-drop">
      <span class="eyebrow">The Mandate</span>
      <blockquote>
        Build a sportsbook brand from scratch that can compete with billion-dollar
        incumbents — then scale it across six states while exceeding acquisition and
        revenue targets.
      </blockquote>
    </div>
  </div>
</section>

<!-- ═══ APPROACH — 2x2 animated grid ═══ -->
<div class="cs-approach section">
  <div class="cs-section-inner">
    <span class="eyebrow">The Approach</span>
    <h2>Win the Launch, Then Build Beyond the First Bet.</h2>
    <p class="cs-approach-insight">
      The work rested on one insight: <em>dominate each launch window for outsized share,
      then build engagement systems that drive long-term value.</em>
    </p>

    <div class="cs-approach-grid">
      <div class="cs-phase-card">
        <div class="cs-phase-num">01</div>
        <div class="cs-phase-title">Win the Launch Moment</div>
        <div class="cs-phase-desc">
          Orchestrated high-impact, coordinated launches in each state — brand awareness
          blitzes, strategic media buys, and cultural tentpole activations to capture
          maximum attention in compressed windows.
        </div>
        <div class="cs-phase-tools">
          <a href="/services/go-to-market" class="cs-phase-tool">Go-to-Market Strategy →</a>
        </div>
      </div>
      <div class="cs-phase-card">
        <div class="cs-phase-num">02</div>
        <div class="cs-phase-title">Engagement Beyond the First Bet</div>
        <div class="cs-phase-desc">
          Identified key activation behaviors — second bet within 48 hours, multi-sport
          betting, live in-play wagering — and built campaigns to drive these high-value
          actions.
        </div>
        <div class="cs-phase-tools">
          <a href="/services/growth-marketing" class="cs-phase-tool">Growth &amp; Lifecycle Marketing →</a>
        </div>
      </div>
      <div class="cs-phase-card">
        <div class="cs-phase-num">03</div>
        <div class="cs-phase-title">Scalable Multi-State Playbook</div>
        <div class="cs-phase-desc">
          Built a repeatable launch framework localizable for each market — adapting
          messaging, media mix, and cultural hooks for Florida, Arizona, New Jersey,
          and beyond.
        </div>
        <div class="cs-phase-tools">
          <a href="/services/integrated-marketing" class="cs-phase-tool">Integrated Marketing →</a>
        </div>
      </div>
      <div class="cs-phase-card">
        <div class="cs-phase-num">04</div>
        <div class="cs-phase-title">Data-Driven Acquisition Engine</div>
        <div class="cs-phase-desc">
          Built performance infrastructure connecting brand spend to acquisition outcomes,
          enabling real-time optimization. Every dollar measured against customer
          lifetime value, not just sign-up volume.
        </div>
        <div class="cs-phase-tools">
          <a href="/services/content-creator-marketing" class="cs-phase-tool">Content &amp; Creator Marketing →</a>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ═══ RESULTS — Count-up + alternating slide ═══ -->
<section class="cs-results section">
  <div class="cs-results-inner">
    <span class="eyebrow">The Results</span>
    <h2>The Numbers Tell the Story</h2>

    <div class="cs-result-row">
      <div class="cs-result-row-num" data-target="232" data-prefix="+" data-suffix="%"><span class="accent">+</span>0%</div>
      <div>
        <div class="cs-result-label">Exceeded Acquisition Forecasts</div>
        <div class="cs-result-desc">Customer acquisition exceeded internal forecasts by 232% across all markets, driven by high-impact launch campaigns and performance optimization.</div>
      </div>
    </div>
    <div class="cs-result-row">
      <div class="cs-result-row-num" data-target="6" data-suffix=" States">0 States</div>
      <div>
        <div class="cs-result-label">Markets Launched</div>
        <div class="cs-result-desc">Launched across six states including Florida, Arizona, and New Jersey — using a repeatable playbook localized for each market.</div>
      </div>
    </div>
    <div class="cs-result-row">
      <div class="cs-result-row-num" data-target="17" data-prefix="+" data-suffix="%"><span class="accent">+</span>0%</div>
      <div>
        <div class="cs-result-label">ARPU Above Target</div>
        <div class="cs-result-desc">Average Revenue Per User exceeded targets by 17%, validating the engagement-first strategy focused on activation behaviors beyond the initial sign-up bonus.</div>
      </div>
    </div>
    <div class="cs-result-row">
      <div class="cs-result-row-num">1st</div>
      <div>
        <div class="cs-result-label">Legal Sportsbook in Florida</div>
        <div class="cs-result-desc">Launched the first legal sportsbook in the third-largest state by population, capturing significant first-mover advantage in a massive market.</div>
      </div>
    </div>
  </div>
</section>

<!-- ═══ IMPACT — Own reveal section ═══ -->
<section class="cs-impact-v2">
  <div class="cs-impact-v2-inner">
    <span class="eyebrow">The Impact</span>
    <h2>From Strategy to Playbook</h2>

    <div class="cs-impact-v2-card">
      <div class="cs-impact-icon">↗</div>
      <p class="cs-impact-text">
        Hard Rock Bet proved that a well-built brand with a clear strategy could compete
        against entrenched incumbents — even with multi-billion-dollar head starts. The
        two-pillar model — win the launch moment, then build beyond the first bet —
        created a repeatable framework that consistently outperformed forecasts in every
        market entered.
      </p>
    </div>

    <div class="cs-caps-grid" id="csCapsGrid">
      <a href="/services/go-to-market" class="cs-cap-chip">Go-to-Market Strategy</a>
      <a href="/services/integrated-marketing" class="cs-cap-chip">Integrated Marketing</a>
      <a href="/services/content-creator-marketing" class="cs-cap-chip">Content &amp; Creators</a>
      <a href="/services/growth-marketing" class="cs-cap-chip">Growth &amp; Lifecycle</a>
    </div>
  </div>
</section>

<!-- CTA -->
<FinalCTA />

  <Footer slot="footer" />
</BaseLayout>

<script>
  // Scroll progress
  window.addEventListener('scroll', () => {
    const p = (window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)) * 100;
    const bar = document.getElementById('csScrollProgress');
    if (bar) bar.style.width = p + '%';
  });

  // Hero activation
  setTimeout(() => document.getElementById('csHero')?.classList.add('active'), 300);

  // General reveal observer
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) e.target.classList.add('visible');
    });
  }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

  document.querySelectorAll(
    '.cs-challenge-v2 .eyebrow, .cs-challenge-v2 h2, .cs-fly-card, .cs-mandate-drop, ' +
    '.cs-approach .eyebrow, .cs-approach h2, .cs-approach-insight, .cs-approach-grid .cs-phase-card, ' +
    '.cs-results .eyebrow, .cs-results h2, .cs-result-row, ' +
    '.cs-impact-v2 .eyebrow, .cs-impact-v2 h2, .cs-impact-v2-card'
  ).forEach(el => obs.observe(el));

  // Stats auto-play drop-in
  let statsTriggered = false;
  const statsObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting && !statsTriggered) {
        statsTriggered = true;
        e.target.classList.add('in-view');
        const blocks = document.querySelectorAll('.cs-stat-drop');
        const nums = document.querySelectorAll('.cs-stat-drop-num[data-target]');
        blocks.forEach((block, i) => {
          setTimeout(() => {
            block.classList.add('dropped');
            const el = nums[i];
            const target = parseFloat(el.dataset.target);
            const prefix = el.dataset.prefix || '';
            const suffix = el.dataset.suffix || '';
            const isFloat = target % 1 !== 0;
            const duration = 1800;
            const start = performance.now();
            function update(now) {
              const elapsed = now - start;
              const progress = Math.min(elapsed / duration, 1);
              const eased = 1 - Math.pow(1 - progress, 3);
              const current = isFloat ? (target * eased).toFixed(1) : Math.round(target * eased);
              el.textContent = prefix + current + suffix;
              if (progress < 1) requestAnimationFrame(update);
            }
            requestAnimationFrame(update);
          }, i * 400);
        });
      }
    });
  }, { threshold: 0.3 });
  const statsEl = document.getElementById('csStats');
  if (statsEl) statsObs.observe(statsEl);

  // Results count-up
  let resultsCounted = false;
  const resultObs = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting && !resultsCounted) {
        resultsCounted = true;
        document.querySelectorAll('.cs-result-row-num[data-target]').forEach((el, i) => {
          setTimeout(() => {
            const target = parseFloat(el.dataset.target);
            const prefix = el.dataset.prefix || '';
            const suffix = el.dataset.suffix || '';
            const isFloat = target % 1 !== 0;
            const accentHtml = prefix === '+' ? '<span class="accent">+</span>' : '';
            const duration = 2000;
            const start = performance.now();
            function update(now) {
              const elapsed = now - start;
              const progress = Math.min(elapsed / duration, 1);
              const eased = 1 - Math.pow(1 - progress, 3);
              const current = isFloat ? (target * eased).toFixed(1) : Math.round(target * eased);
              el.innerHTML = accentHtml + (prefix === '+' ? '' : prefix) + current + suffix;
              if (progress < 1) requestAnimationFrame(update);
            }
            requestAnimationFrame(update);
          }, i * 200);
        });
      }
    });
  }, { threshold: 0.2 });
  const resultsEl = document.querySelector('.cs-results');
  if (resultsEl) resultObs.observe(resultsEl);

  // Cap chips staggered
  const capObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.querySelectorAll('.cs-cap-chip').forEach((chip, i) => {
          setTimeout(() => chip.classList.add('visible'), i * 150);
        });
        capObs.unobserve(e.target);
      }
    });
  }, { threshold: 0.3 });
  const capsEl = document.getElementById('csCapsGrid');
  if (capsEl) capObs.observe(capsEl);
</script>
