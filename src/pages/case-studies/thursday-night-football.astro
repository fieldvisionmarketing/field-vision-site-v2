---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import FinalCTA from '@/components/FinalCTA.astro';
---

<BaseLayout
  title="Inventing Creator-Led Sports Broadcasting | Field Vision"
  description="Pioneered the creator co-streaming format for Thursday Night Football on Twitch — 3.3M hours watched, +73% YoY growth, and 70-74% audience interaction rates that became the industry blueprint."
>
  <Header slot="header" />

<!-- Scroll progress bar -->
<div class="cs-scroll-progress" id="csScrollProgress"></div>

<!-- ═══ HERO — Sticky parallax + blur-to-focus ═══ -->
<div class="cs-hero-v2-wrapper">
  <div class="cs-hero-v2-sticky" id="csHero">
    <div class="cs-hero-v2-bg" style="background-image:url('https://static.wixstatic.com/media/d84514_01cfbac252c841b193b4fbcf0491dff0~mv2.png')"></div>
    <div class="cs-hero-v2-content">
      <h1>Pioneering the<br><span class="highlight-chip">Creator-Led</span><br>Sports Simulcast</h1>
      <p class="cs-hero-v2-summary">
        Pioneered the creator co-streaming format for Thursday Night Football on Twitch —
        reimagining live sports through real-time community interaction years before the
        industry caught on.
      </p>
      <div class="cs-scroll-hint">Scroll to explore</div>
    </div>
  </div>
</div>

<!-- ═══ STATS — Auto-play drop-in ═══ -->
<section class="cs-stats-v2" id="csStats">
  <div class="cs-stats-v2-inner">
    <div class="cs-stat-drop">
      <div class="cs-stat-drop-num" data-target="3.3" data-suffix="M">0M</div>
      <div class="cs-stat-drop-label">Hours Watched</div>
    </div>
    <div class="cs-stat-drop">
      <div class="cs-stat-drop-num" data-target="73" data-prefix="+" data-suffix="%">+0%</div>
      <div class="cs-stat-drop-label">YoY Viewership Growth</div>
    </div>
    <div class="cs-stat-drop">
      <div class="cs-stat-drop-num" data-target="128" data-suffix="M+">0M+</div>
      <div class="cs-stat-drop-label">Impressions</div>
    </div>
    <div class="cs-stat-drop">
      <div class="cs-stat-drop-num">70-74%</div>
      <div class="cs-stat-drop-label">Audience Interaction Rate</div>
    </div>
  </div>
</section>

<!-- ═══ CHALLENGE — Fly-in cards ═══ -->
<section class="cs-challenge-v2">
  <div class="cs-challenge-v2-inner">
    <span class="eyebrow">The Challenge</span>
    <h2>Sports Broadcasting Was Fundamentally Passive</h2>

    <div class="cs-fly-card">
      <span class="cs-fly-card-num">1</span>
      <span class="cs-fly-card-text"><strong>No proven model for creator-led sports broadcasts.</strong> The format that would later become the Manningcast simply didn't exist yet — it needed to be invented.</span>
    </div>
    <div class="cs-fly-card">
      <span class="cs-fly-card-num">2</span>
      <span class="cs-fly-card-text"><strong>Traditional sports media was entirely one-way.</strong> Fans watched with professional commentators, with no way to interact, participate, or shape the experience.</span>
    </div>
    <div class="cs-fly-card">
      <span class="cs-fly-card-num">3</span>
      <span class="cs-fly-card-text"><strong>Twitch needed to prove sports could work on the platform.</strong> Demonstrating that live sports could thrive inside a creator ecosystem was essential for expansion beyond gaming.</span>
    </div>
    <div class="cs-fly-card">
      <span class="cs-fly-card-num">4</span>
      <span class="cs-fly-card-text"><strong>The NFL partnership demanded results at scale.</strong> Working with the NFL and Amazon required a format that could deliver meaningful viewership, not just an experiment.</span>
    </div>

    <div class="cs-mandate-drop">
      <span class="eyebrow">The Mandate</span>
      <blockquote>
        Prove that live sports could succeed on a creator-driven platform — and develop a
        new broadcast format blending traditional sports with interactive community experiences.
      </blockquote>
    </div>
  </div>
</section>

<!-- ═══ APPROACH — 2x2 animated grid ═══ -->
<div class="cs-approach section">
  <div class="cs-section-inner">
    <span class="eyebrow">The Approach</span>
    <h2>Reimagining Sports Through Community.</h2>
    <p class="cs-approach-insight">
      The work started with one insight: <em>fans didn't want a better broadcast — they
      wanted to watch with their people.</em> That reshaped the entire format.
    </p>

    <div class="cs-approach-grid">
      <div class="cs-phase-card">
        <div class="cs-phase-num">01</div>
        <div class="cs-phase-title">Inventing the Creator Co-Stream</div>
        <div class="cs-phase-desc">
          Pioneered the format where creators layered personality and community on top
          of the live broadcast. Fans watched inside live chat with authentic, conversational
          commentary.
        </div>
        <div class="cs-phase-tools">
          <a href="/services/content-creator-marketing" class="cs-phase-tool">Content &amp; Creator Marketing →</a>
        </div>
      </div>
      <div class="cs-phase-card">
        <div class="cs-phase-num">02</div>
        <div class="cs-phase-title">Scaling the Creator Ecosystem</div>
        <div class="cs-phase-desc">
          Built a program integrating 21 creators and 200+ streams across the NFL season.
          Expanded to include Spanish and German broadcasters and professional athlete
          guest co-streams.
        </div>
        <div class="cs-phase-tools">
          <a href="/services/go-to-market" class="cs-phase-tool">Go-to-Market Strategy →</a>
        </div>
      </div>
      <div class="cs-phase-card">
        <div class="cs-phase-num">03</div>
        <div class="cs-phase-title">Full-Funnel Marketing Engine</div>
        <div class="cs-phase-desc">
          Built campaigns across owned channels and paid media driving 128M+ impressions
          and 581K clicks. Front page, push, email, search, social, and programmatic
          all coordinated per game.
        </div>
        <div class="cs-phase-tools">
          <a href="/services/integrated-marketing" class="cs-phase-tool">Integrated Marketing →</a>
        </div>
      </div>
      <div class="cs-phase-card">
        <div class="cs-phase-num">04</div>
        <div class="cs-phase-title">Interactive Viewing Mechanics</div>
        <div class="cs-phase-desc">
          Integrated Twitch-native features — real-time chat, prediction extensions tied
          to gameplay, and community participation mechanics — driving 70-74% audience
          interaction rates.
        </div>
        <div class="cs-phase-tools">
          <a href="/services/growth-marketing" class="cs-phase-tool">Growth &amp; Lifecycle Marketing →</a>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ═══ RESULTS — Count-up + alternating slide ═══ -->
<section class="cs-results section">
  <div class="cs-results-inner">
    <span class="eyebrow">The Results</span>
    <h2>The Numbers Tell the Story</h2>

    <div class="cs-result-row">
      <div class="cs-result-row-num" data-target="3.3" data-suffix="M">0M</div>
      <div>
        <div class="cs-result-label">Total Hours Watched</div>
        <div class="cs-result-desc">3.3 million hours of Thursday Night Football watched in a single season on Twitch, demonstrating massive demand for interactive sports viewing.</div>
      </div>
    </div>
    <div class="cs-result-row">
      <div class="cs-result-row-num" data-target="73" data-prefix="+" data-suffix="%"><span class="accent">+</span>0%</div>
      <div>
        <div class="cs-result-label">YoY Viewership Growth</div>
        <div class="cs-result-desc">Year-over-year growth in hours watched, proving the format was gaining momentum and building a loyal audience each season.</div>
      </div>
    </div>
    <div class="cs-result-row">
      <div class="cs-result-row-num" data-target="128" data-suffix="M+">0M+</div>
      <div>
        <div class="cs-result-label">Impressions Generated</div>
        <div class="cs-result-desc">Marketing campaigns drove 128M+ impressions with 581K clicks and 1.1M hours watched attributed to marketing channels across the season.</div>
      </div>
    </div>
    <div class="cs-result-row">
      <div class="cs-result-row-num">70-74%</div>
      <div>
        <div class="cs-result-label">Audience Interaction Rate</div>
        <div class="cs-result-desc">Prediction extensions alone drove 70-74% interaction rates — far exceeding engagement in any traditional sports broadcast format.</div>
      </div>
    </div>
  </div>
</section>

<!-- ═══ IMPACT — Own reveal section ═══ -->
<section class="cs-impact-v2">
  <div class="cs-impact-v2-inner">
    <span class="eyebrow">The Impact</span>
    <h2>From Strategy to Playbook</h2>

    <div class="cs-impact-v2-card">
      <div class="cs-impact-icon">↗</div>
      <p class="cs-impact-text">
        The creator co-stream format invented for Thursday Night Football on Twitch became
        the blueprint for interactive sports broadcasting — a model now replicated across
        the industry by ESPN, the NFL, and major sports properties. Years before the
        Manningcast normalized the idea, this program proved it could work at scale.
      </p>
    </div>

    <div class="cs-caps-grid" id="csCapsGrid">
      <a href="/services/go-to-market" class="cs-cap-chip">Go-to-Market Strategy</a>
      <a href="/services/integrated-marketing" class="cs-cap-chip">Integrated Marketing</a>
      <a href="/services/content-creator-marketing" class="cs-cap-chip">Content &amp; Creators</a>
      <a href="/services/growth-marketing" class="cs-cap-chip">Growth &amp; Lifecycle</a>
    </div>
  </div>
</section>

<!-- CTA -->
<FinalCTA />

  <Footer slot="footer" />
</BaseLayout>

<script>
  // Scroll progress
  window.addEventListener('scroll', () => {
    const p = (window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)) * 100;
    const bar = document.getElementById('csScrollProgress');
    if (bar) bar.style.width = p + '%';
  });

  // Hero activation
  setTimeout(() => document.getElementById('csHero')?.classList.add('active'), 300);

  // General reveal observer
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) e.target.classList.add('visible');
    });
  }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

  document.querySelectorAll(
    '.cs-challenge-v2 .eyebrow, .cs-challenge-v2 h2, .cs-fly-card, .cs-mandate-drop, ' +
    '.cs-approach .eyebrow, .cs-approach h2, .cs-approach-insight, .cs-approach-grid .cs-phase-card, ' +
    '.cs-results .eyebrow, .cs-results h2, .cs-result-row, ' +
    '.cs-impact-v2 .eyebrow, .cs-impact-v2 h2, .cs-impact-v2-card'
  ).forEach(el => obs.observe(el));

  // Stats auto-play drop-in
  let statsTriggered = false;
  const statsObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting && !statsTriggered) {
        statsTriggered = true;
        e.target.classList.add('in-view');
        const blocks = document.querySelectorAll('.cs-stat-drop');
        const nums = document.querySelectorAll('.cs-stat-drop-num[data-target]');
        blocks.forEach((block, i) => {
          setTimeout(() => {
            block.classList.add('dropped');
            const el = nums[i];
            const target = parseFloat(el.dataset.target);
            const prefix = el.dataset.prefix || '';
            const suffix = el.dataset.suffix || '';
            const isFloat = target % 1 !== 0;
            const duration = 1800;
            const start = performance.now();
            function update(now) {
              const elapsed = now - start;
              const progress = Math.min(elapsed / duration, 1);
              const eased = 1 - Math.pow(1 - progress, 3);
              const current = isFloat ? (target * eased).toFixed(1) : Math.round(target * eased);
              el.textContent = prefix + current + suffix;
              if (progress < 1) requestAnimationFrame(update);
            }
            requestAnimationFrame(update);
          }, i * 400);
        });
      }
    });
  }, { threshold: 0.3 });
  const statsEl = document.getElementById('csStats');
  if (statsEl) statsObs.observe(statsEl);

  // Results count-up
  let resultsCounted = false;
  const resultObs = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting && !resultsCounted) {
        resultsCounted = true;
        document.querySelectorAll('.cs-result-row-num[data-target]').forEach((el, i) => {
          setTimeout(() => {
            const target = parseFloat(el.dataset.target);
            const prefix = el.dataset.prefix || '';
            const suffix = el.dataset.suffix || '';
            const isFloat = target % 1 !== 0;
            const accentHtml = prefix === '+' ? '<span class="accent">+</span>' : '';
            const duration = 2000;
            const start = performance.now();
            function update(now) {
              const elapsed = now - start;
              const progress = Math.min(elapsed / duration, 1);
              const eased = 1 - Math.pow(1 - progress, 3);
              const current = isFloat ? (target * eased).toFixed(1) : Math.round(target * eased);
              el.innerHTML = accentHtml + (prefix === '+' ? '' : prefix) + current + suffix;
              if (progress < 1) requestAnimationFrame(update);
            }
            requestAnimationFrame(update);
          }, i * 200);
        });
      }
    });
  }, { threshold: 0.2 });
  const resultsEl = document.querySelector('.cs-results');
  if (resultsEl) resultObs.observe(resultsEl);

  // Cap chips staggered
  const capObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.querySelectorAll('.cs-cap-chip').forEach((chip, i) => {
          setTimeout(() => chip.classList.add('visible'), i * 150);
        });
        capObs.unobserve(e.target);
      }
    });
  }, { threshold: 0.3 });
  const capsEl = document.getElementById('csCapsGrid');
  if (capsEl) capObs.observe(capsEl);
</script>
