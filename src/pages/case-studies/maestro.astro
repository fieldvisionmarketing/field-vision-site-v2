---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import FinalCTA from '@/components/FinalCTA.astro';
---

<BaseLayout
  title="Launching AI Music Discovery at Amazon | Field Vision"
  description="Helped launch Maestro — the streaming industry's first AI-powered playlist generator — positioning Amazon Music as the category innovator with 50+ media placements."
>
  <Header slot="header" />

<!-- Scroll progress bar -->
<div class="cs-scroll-progress" id="csScrollProgress"></div>

<!-- ═══ HERO ═══ -->
<div class="cs-hero-v2-wrapper">
  <div class="cs-hero-v2-sticky" id="csHero">
    <!-- Video background instead of image -->
    <video class="cs-hero-v2-bg" autoplay muted loop playsinline style="width:50%;height:100%;object-fit:cover;opacity:0;transform:scale(1.15);transition:opacity 2s ease, transform 4s ease;">
      <source src="https://video.wixstatic.com/video/d84514_9ec5ca21a368465bb5979996bef0ac35/720p/mp4/file.mp4" type="video/mp4" />
    </video>
    <div class="cs-hero-v2-content">
      <h1>Launching AI Music<br>Discovery at <span class="highlight-chip">Amazon</span></h1>
      <p class="cs-hero-v2-summary">
        Helped launch Maestro — the streaming industry's first AI-powered playlist
        generator — turning mood and imagination into music discovery and positioning
        Amazon Music as the category innovator.
      </p>
    </div>
    <div class="cs-scroll-hint">Scroll to explore</div>
  </div>
</div>

<!-- ═══ STATS ═══ -->
<section class="cs-stats-v2" id="csStats">
  <div class="cs-stats-v2-inner">
    <div class="cs-stat-drop">
      <div class="cs-stat-drop-num">1st</div>
      <div class="cs-stat-drop-label">AI Product by Amazon Entertainment</div>
    </div>
    <div class="cs-stat-drop">
      <div class="cs-stat-drop-num" data-target="50" data-suffix="+">0+</div>
      <div class="cs-stat-drop-label">Media Placements</div>
    </div>
    <div class="cs-stat-drop">
      <div class="cs-stat-drop-num">1st</div>
      <div class="cs-stat-drop-label">Public Beta Launch</div>
    </div>
    <div class="cs-stat-drop">
      <div class="cs-stat-drop-num" data-target="100" data-suffix="%">0%</div>
      <div class="cs-stat-drop-label">Scaled to All Customers</div>
    </div>
  </div>
</section>

<!-- ═══ CHALLENGE ═══ -->
<section class="cs-challenge-v2">
  <div class="cs-challenge-v2-inner">
    <span class="eyebrow">— The Challenge</span>
    <h2>AI Was Reshaping Tech. Streaming Hadn't Moved.</h2>

    <div class="cs-fly-card">
      <span class="cs-fly-card-num">1</span>
      <span class="cs-fly-card-text"><strong>No streaming service had launched a consumer AI product.</strong> Despite AI dominating headlines, no competitor had delivered a generative AI music experience in the U.S.</span>
    </div>
    <div class="cs-fly-card">
      <span class="cs-fly-card-num">2</span>
      <span class="cs-fly-card-text"><strong>The interaction model was entirely new.</strong> Natural language prompts instead of traditional playlist browsing — customers needed to learn a new way to discover music.</span>
    </div>
    <div class="cs-fly-card">
      <span class="cs-fly-card-num">3</span>
      <span class="cs-fly-card-text"><strong>Customer education was critical.</strong> The launch needed to spark curiosity and demonstrate capabilities from day one.</span>
    </div>
    <div class="cs-fly-card">
      <span class="cs-fly-card-num">4</span>
      <span class="cs-fly-card-text"><strong>Amazon Entertainment's first AI product launch.</strong> Stakes extended beyond music — a milestone for the entire organization.</span>
    </div>

    <div class="cs-mandate-drop">
      <span class="eyebrow">— The Mandate</span>
      <blockquote>
        Launch the streaming industry's first AI-powered music discovery experience —
        and position Amazon Music as the innovation leader.
      </blockquote>
    </div>
  </div>
</section>

<!-- ═══ APPROACH ═══ -->
<div class="cs-approach section">
  <div class="cs-section-inner">
    <span class="eyebrow">— The Approach</span>
    <h2>Discovery Powered by Imagination</h2>
    <p class="cs-approach-insight">
      The narrative was simple: <em>type how you feel, get a custom soundtrack in seconds.</em>
    </p>

    <div class="cs-approach-grid">
      <div class="cs-phase-card">
        <div class="cs-phase-num">01</div>
        <div class="cs-phase-title">Category-Defining Positioning</div>
        <div class="cs-phase-desc">
          Framed Maestro as music discovery through natural language. Positioned Amazon Music
          as the first streaming service to bring generative AI directly to listeners.
        </div>
        <div class="cs-phase-tools">
          <a href="/services/go-to-market" class="cs-phase-tool">Go-to-Market Strategy →</a>
        </div>
      </div>
      <div class="cs-phase-card">
        <div class="cs-phase-num">02</div>
        <div class="cs-phase-title">Beta-Driven Rollout</div>
        <div class="cs-phase-desc">
          First public beta in Amazon Music history. Tested customer behavior, iterated on
          real usage data, built momentum before global release.
        </div>
        <div class="cs-phase-tools">
          <a href="/services/growth-marketing" class="cs-phase-tool">Growth &amp; Lifecycle Marketing →</a>
        </div>
      </div>
      <div class="cs-phase-card">
        <div class="cs-phase-num">03</div>
        <div class="cs-phase-title">PR-Led Innovation Narrative</div>
        <div class="cs-phase-desc">
          Drove 50+ media placements across Billboard, TechCrunch, Engadget, The Verge,
          and leading industry newsletters.
        </div>
        <div class="cs-phase-tools">
          <a href="/services/integrated-marketing" class="cs-phase-tool">Integrated Marketing →</a>
        </div>
      </div>
      <div class="cs-phase-card">
        <div class="cs-phase-num">04</div>
        <div class="cs-phase-title">Customer Education</div>
        <div class="cs-phase-desc">
          Campaign creative showcased imaginative prompts. Messaging coordinated across
          owned channels, social, and product surfaces to spark experimentation.
        </div>
        <div class="cs-phase-tools">
          <a href="/services/content-creator-marketing" class="cs-phase-tool">Content &amp; Creator Marketing →</a>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ═══ RESULTS ═══ -->
<section class="cs-results section">
  <div class="cs-results-inner">
    <span class="eyebrow">— The Results</span>
    <h2>The Numbers Tell the Story</h2>

    <div class="cs-result-row">
      <div class="cs-result-row-num">1st</div>
      <div>
        <div class="cs-result-label">Amazon Entertainment AI Product</div>
        <div class="cs-result-desc">First customer-facing generative AI product launched by Amazon Entertainment — a milestone for the entire organization.</div>
      </div>
    </div>
    <div class="cs-result-row">
      <div class="cs-result-row-num" data-target="50" data-suffix="+">0+</div>
      <div>
        <div class="cs-result-label">Media Placements</div>
        <div class="cs-result-desc">Coverage across Billboard, TechCrunch, Engadget, The Verge, Hypebot, and leading music and technology industry newsletters.</div>
      </div>
    </div>
    <div class="cs-result-row">
      <div class="cs-result-row-num">1st</div>
      <div>
        <div class="cs-result-label">Public Beta for Amazon Music</div>
        <div class="cs-result-desc">First public beta in Amazon Music history. Enabled rapid iteration and learning ahead of global rollout.</div>
      </div>
    </div>
    <div class="cs-result-row">
      <div class="cs-result-row-num" data-target="100" data-suffix="%">0%</div>
      <div>
        <div class="cs-result-label">Scaled to All Customers</div>
        <div class="cs-result-desc">Following the beta, Maestro scaled to 100% of Amazon Music customers in-app — becoming a core feature of the discovery experience.</div>
      </div>
    </div>
  </div>
</section>

<!-- ═══ IMPACT ═══ -->
<section class="cs-impact-v2">
  <div class="cs-impact-v2-inner">
    <span class="eyebrow">— The Impact</span>
    <h2>From Strategy to Playbook</h2>

    <div class="cs-impact-v2-card">
      <div class="cs-impact-icon">🤖</div>
      <p class="cs-impact-text">
        Maestro established Amazon Music as the first major streaming service to bring
        generative AI directly to listeners — creating a new category for AI-powered music
        discovery that the industry has since followed.
      </p>
    </div>

    <div class="cs-caps-grid" id="csCapsGrid">
      <a href="/services/go-to-market" class="cs-cap-chip">Go-to-Market Strategy</a>
      <a href="/services/integrated-marketing" class="cs-cap-chip">Integrated Marketing</a>
      <a href="/services/content-creator-marketing" class="cs-cap-chip">Content &amp; Creators</a>
      <a href="/services/growth-marketing" class="cs-cap-chip">Growth &amp; Lifecycle</a>
    </div>
  </div>
</section>

<!-- CTA -->
<FinalCTA />

  <Footer slot="footer" />
</BaseLayout>

<script>
  // Scroll progress
  window.addEventListener('scroll', () => {
    const p = (window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)) * 100;
    const bar = document.getElementById('csScrollProgress');
    if (bar) bar.style.width = p + '%';
  });

  // Hero activation — also handle video bg fade-in
  setTimeout(() => {
    const hero = document.getElementById('csHero');
    if (hero) {
      hero.classList.add('active');
      const vid = hero.querySelector('video');
      if (vid) {
        vid.style.opacity = '0.25';
        vid.style.transform = 'scale(1.0)';
      }
    }
  }, 300);

  // General reveal observer
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) e.target.classList.add('visible');
    });
  }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

  document.querySelectorAll(
    '.cs-challenge-v2 .eyebrow, .cs-challenge-v2 h2, .cs-fly-card, .cs-mandate-drop, ' +
    '.cs-approach .eyebrow, .cs-approach h2, .cs-approach-insight, .cs-approach-grid .cs-phase-card, ' +
    '.cs-results .eyebrow, .cs-results h2, .cs-result-row, ' +
    '.cs-impact-v2 .eyebrow, .cs-impact-v2 h2, .cs-impact-v2-card'
  ).forEach(el => obs.observe(el));

  // Stats auto-play drop-in
  let statsTriggered = false;
  const statsObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting && !statsTriggered) {
        statsTriggered = true;
        e.target.classList.add('in-view');
        const blocks = document.querySelectorAll('.cs-stat-drop');
        const nums = document.querySelectorAll('.cs-stat-drop-num');
        blocks.forEach((block, i) => {
          setTimeout(() => {
            block.classList.add('dropped');
            const el = nums[i];
            // Only count up if has data-target
            if (!el.dataset.target) return;
            const target = parseFloat(el.dataset.target);
            const prefix = el.dataset.prefix || '';
            const suffix = el.dataset.suffix || '';
            const isFloat = target % 1 !== 0;
            const duration = 1800;
            const start = performance.now();
            function update(now) {
              const elapsed = now - start;
              const progress = Math.min(elapsed / duration, 1);
              const eased = 1 - Math.pow(1 - progress, 3);
              const current = isFloat ? (target * eased).toFixed(1) : Math.round(target * eased);
              el.textContent = prefix + current + suffix;
              if (progress < 1) requestAnimationFrame(update);
            }
            requestAnimationFrame(update);
          }, i * 400);
        });
      }
    });
  }, { threshold: 0.3 });
  const statsEl = document.getElementById('csStats');
  if (statsEl) statsObs.observe(statsEl);

  // Results count-up
  let resultsCounted = false;
  const resultObs = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting && !resultsCounted) {
        resultsCounted = true;
        document.querySelectorAll('.cs-result-row-num[data-target]').forEach((el, i) => {
          setTimeout(() => {
            const target = parseFloat(el.dataset.target);
            const prefix = el.dataset.prefix || '';
            const suffix = el.dataset.suffix || '';
            const isFloat = target % 1 !== 0;
            const accentHtml = prefix ? '<span class="accent">' + prefix + '</span>' : '';
            const duration = 2000;
            const start = performance.now();
            function update(now) {
              const elapsed = now - start;
              const progress = Math.min(elapsed / duration, 1);
              const eased = 1 - Math.pow(1 - progress, 3);
              const current = isFloat ? (target * eased).toFixed(1) : Math.round(target * eased);
              el.innerHTML = accentHtml + current + suffix;
              if (progress < 1) requestAnimationFrame(update);
            }
            requestAnimationFrame(update);
          }, i * 200);
        });
      }
    });
  }, { threshold: 0.2 });
  const resultsEl = document.querySelector('.cs-results');
  if (resultsEl) resultObs.observe(resultsEl);

  // Cap chips staggered
  const capObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.querySelectorAll('.cs-cap-chip').forEach((chip, i) => {
          setTimeout(() => chip.classList.add('visible'), i * 150);
        });
        capObs.unobserve(e.target);
      }
    });
  }, { threshold: 0.3 });
  const capsEl = document.getElementById('csCapsGrid');
  if (capsEl) capObs.observe(capsEl);
</script>
