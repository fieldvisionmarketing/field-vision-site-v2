---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import FinalCTA from '@/components/FinalCTA.astro';
---

<BaseLayout
  title="Growing Pandora from 50M to 80M+ MAU | Field Vision"
  description="Built the lifecycle marketing engine at Pandora that turned passive listeners into active, retained users — growing MAU from 50M to 80M+, lifting week-2 retention 21%, and increasing subscription conversion 12%."
>
  <Header slot="header" />

<!-- Scroll progress bar -->
<div class="cs-scroll-progress" id="csScrollProgress"></div>

<!-- ═══ HERO — Sticky parallax + blur-to-focus ═══ -->
<div class="cs-hero-v2-wrapper">
  <div class="cs-hero-v2-sticky" id="csHero">
    <div class="cs-hero-v2-bg" style="background-image:url('https://static.wixstatic.com/media/d84514_8700860cdef84f04a9a1d923bbd91ac7~mv2.png')"></div>
    <div class="cs-hero-v2-content">
      <h1>Building the <span class="highlight-chip">Leader</span> in<br>Streaming Music</h1>
      <p class="cs-hero-v2-summary">
        Built the lifecycle marketing infrastructure — email, push, and in-app — that
        turned passive listeners into active, retained users and grew Pandora from
        50 million to over 80 million monthly active users.
      </p>
      <div class="cs-scroll-hint">Scroll to explore</div>
    </div>
  </div>
</div>

<!-- ═══ STATS — Auto-play drop-in ═══ -->
<section class="cs-stats-v2" id="csStats">
  <div class="cs-stats-v2-inner">
    <div class="cs-stat-drop">
      <div class="cs-stat-drop-num" data-target="80" data-suffix="M+">0M+</div>
      <div class="cs-stat-drop-label">Monthly Active Users</div>
    </div>
    <div class="cs-stat-drop">
      <div class="cs-stat-drop-num" data-target="21" data-prefix="+" data-suffix="%">+0%</div>
      <div class="cs-stat-drop-label">Week-2 Retention Lift</div>
    </div>
    <div class="cs-stat-drop">
      <div class="cs-stat-drop-num" data-target="12" data-prefix="+" data-suffix="%">+0%</div>
      <div class="cs-stat-drop-label">Subscription Conversion Lift</div>
    </div>
    <div class="cs-stat-drop">
      <div class="cs-stat-drop-num" data-target="2" data-suffix=" Key Behaviors">0 Key Behaviors</div>
      <div class="cs-stat-drop-label">Activation Signals Identified</div>
    </div>
  </div>
</section>

<!-- ═══ CHALLENGE — Fly-in cards ═══ -->
<section class="cs-challenge-v2">
  <div class="cs-challenge-v2-inner">
    <span class="eyebrow">The Challenge</span>
    <h2>Massive Reach, Listeners Slipping Away</h2>

    <div class="cs-fly-card">
      <span class="cs-fly-card-num">1</span>
      <span class="cs-fly-card-text"><strong>No lifecycle marketing infrastructure existed.</strong> No coordinated system for email, push, or in-app messaging to guide listener behavior after sign-up.</span>
    </div>
    <div class="cs-fly-card">
      <span class="cs-fly-card-num">2</span>
      <span class="cs-fly-card-text"><strong>First-week drop-off was significant.</strong> New users signed up but didn't return — the critical first seven days lacked any structured engagement to build habits.</span>
    </div>
    <div class="cs-fly-card">
      <span class="cs-fly-card-num">3</span>
      <span class="cs-fly-card-text"><strong>Activation behaviors were undefined.</strong> No one had identified which early actions — creating more than one station, giving more than 5 thumbs in your first week — predicted long-term retention.</span>
    </div>
    <div class="cs-fly-card">
      <span class="cs-fly-card-num">4</span>
      <span class="cs-fly-card-text"><strong>Subscription conversion was underperforming.</strong> Free-to-paid upsells were generic and poorly timed, missing behavioral signals that indicated real upgrade intent.</span>
    </div>

    <div class="cs-mandate-drop">
      <span class="eyebrow">The Mandate</span>
      <blockquote>
        Build the lifecycle marketing engine that turns passive listeners into active,
        retained users — and converts the most engaged into paying subscribers.
      </blockquote>
    </div>
  </div>
</section>

<!-- ═══ APPROACH — 2x2 animated grid ═══ -->
<div class="cs-approach section">
  <div class="cs-section-inner">
    <span class="eyebrow">The Approach</span>
    <h2>Activation, Retention, Conversion — from Scratch.</h2>
    <p class="cs-approach-insight">
      The work started with one insight: <em>two early listener actions predicted
      whether someone would stay for years.</em> That shaped the entire lifecycle program.
    </p>

    <div class="cs-approach-grid">
      <div class="cs-phase-card">
        <div class="cs-phase-num">01</div>
        <div class="cs-phase-title">Key Activation Behaviors</div>
        <div class="cs-phase-desc">
          Analyzed listener data to identify the two early actions that predicted
          long-term retention: creating more than one station and giving more than
          5 thumbs in your first week.
        </div>
        <div class="cs-phase-tools">
          <a href="/services/growth-marketing" class="cs-phase-tool">Growth &amp; Lifecycle Marketing →</a>
        </div>
      </div>
      <div class="cs-phase-card">
        <div class="cs-phase-num">02</div>
        <div class="cs-phase-title">First-Week Listener Journey</div>
        <div class="cs-phase-desc">
          Designed a structured onboarding sequence across email, push, and in-app
          that guided new users through activation milestones within their first
          seven days.
        </div>
        <div class="cs-phase-tools">
          <a href="/services/growth-marketing" class="cs-phase-tool">Growth &amp; Lifecycle Marketing →</a>
        </div>
      </div>
      <div class="cs-phase-card">
        <div class="cs-phase-num">03</div>
        <div class="cs-phase-title">Contextual Subscription Upsells</div>
        <div class="cs-phase-desc">
          Replaced generic free-to-paid messaging with behaviorally triggered upsells
          that appeared when listeners hit limits, discovered premium features, or
          completed key milestones.
        </div>
        <div class="cs-phase-tools">
          <a href="/services/go-to-market" class="cs-phase-tool">Go-to-Market Strategy →</a>
        </div>
      </div>
      <div class="cs-phase-card">
        <div class="cs-phase-num">04</div>
        <div class="cs-phase-title">Experimentation Culture</div>
        <div class="cs-phase-desc">
          Established continuous testing across every lifecycle touchpoint — subject
          lines, send times, sequencing, creative, and channel mix — creating a
          compounding optimization engine.
        </div>
        <div class="cs-phase-tools">
          <a href="/services/integrated-marketing" class="cs-phase-tool">Integrated Marketing →</a>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ═══ RESULTS — Count-up + alternating slide ═══ -->
<section class="cs-results section">
  <div class="cs-results-inner">
    <span class="eyebrow">The Results</span>
    <h2>The Numbers Tell the Story</h2>

    <div class="cs-result-row">
      <div class="cs-result-row-num" data-target="80" data-suffix="M+">0M+</div>
      <div>
        <div class="cs-result-label">Monthly Active Users</div>
        <div class="cs-result-desc">Grew from 50M to 80M+ MAU by building lifecycle infrastructure that activated, retained, and re-engaged listeners at scale.</div>
      </div>
    </div>
    <div class="cs-result-row">
      <div class="cs-result-row-num" data-target="21" data-prefix="+" data-suffix="%"><span class="accent">+</span>0%</div>
      <div>
        <div class="cs-result-label">Week-2 Retention Lift</div>
        <div class="cs-result-desc">Rebuilt the first-week listener journey with structured activation milestones that drove a 21% lift in second-week return rates.</div>
      </div>
    </div>
    <div class="cs-result-row">
      <div class="cs-result-row-num" data-target="12" data-prefix="+" data-suffix="%"><span class="accent">+</span>0%</div>
      <div>
        <div class="cs-result-label">Subscription Conversion Lift</div>
        <div class="cs-result-desc">Contextual, behaviorally triggered upsells replaced generic messaging — lifting paid subscription conversion by 12%.</div>
      </div>
    </div>
    <div class="cs-result-row">
      <div class="cs-result-row-num" data-target="2" data-suffix=" Behaviors">0 Behaviors</div>
      <div>
        <div class="cs-result-label">Activation Signals Identified</div>
        <div class="cs-result-desc">Discovered and validated the two early listener actions — creating more than one station and giving more than 5 thumbs in your first week — that predicted long-term retention.</div>
      </div>
    </div>
  </div>
</section>

<!-- ═══ IMPACT — Own reveal section ═══ -->
<section class="cs-impact-v2">
  <div class="cs-impact-v2-inner">
    <span class="eyebrow">The Impact</span>
    <h2>From Strategy to Playbook</h2>

    <div class="cs-impact-v2-card">
      <div class="cs-impact-icon">↗</div>
      <p class="cs-impact-text">
        What started as a platform with massive reach but no retention strategy became
        one of the most sophisticated lifecycle marketing operations in music streaming.
        The experimentation culture produced a compounding optimization engine that
        continued to improve retention, engagement, and conversion long after the initial
        infrastructure was in place.
      </p>
    </div>

    <div class="cs-caps-grid" id="csCapsGrid">
      <a href="/services/growth-marketing" class="cs-cap-chip">Growth &amp; Lifecycle</a>
      <a href="/services/go-to-market" class="cs-cap-chip">Go-to-Market Strategy</a>
      <a href="/services/integrated-marketing" class="cs-cap-chip">Integrated Marketing</a>
      <a href="/services/content-creator-marketing" class="cs-cap-chip">Content &amp; Creators</a>
    </div>
  </div>
</section>

<!-- CTA -->
<FinalCTA />

  <Footer slot="footer" />
</BaseLayout>

<script>
  // Scroll progress
  window.addEventListener('scroll', () => {
    const p = (window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)) * 100;
    const bar = document.getElementById('csScrollProgress');
    if (bar) bar.style.width = p + '%';
  });

  // Hero activation
  setTimeout(() => document.getElementById('csHero')?.classList.add('active'), 300);

  // General reveal observer
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) e.target.classList.add('visible');
    });
  }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

  document.querySelectorAll(
    '.cs-challenge-v2 .eyebrow, .cs-challenge-v2 h2, .cs-fly-card, .cs-mandate-drop, ' +
    '.cs-approach .eyebrow, .cs-approach h2, .cs-approach-insight, .cs-approach-grid .cs-phase-card, ' +
    '.cs-results .eyebrow, .cs-results h2, .cs-result-row, ' +
    '.cs-impact-v2 .eyebrow, .cs-impact-v2 h2, .cs-impact-v2-card'
  ).forEach(el => obs.observe(el));

  // Stats auto-play drop-in
  let statsTriggered = false;
  const statsObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting && !statsTriggered) {
        statsTriggered = true;
        e.target.classList.add('in-view');
        const blocks = document.querySelectorAll('.cs-stat-drop');
        const nums = document.querySelectorAll('.cs-stat-drop-num[data-target]');
        blocks.forEach((block, i) => {
          setTimeout(() => {
            block.classList.add('dropped');
            const el = nums[i];
            const target = parseFloat(el.dataset.target);
            const prefix = el.dataset.prefix || '';
            const suffix = el.dataset.suffix || '';
            const isFloat = target % 1 !== 0;
            const duration = 1800;
            const start = performance.now();
            function update(now) {
              const elapsed = now - start;
              const progress = Math.min(elapsed / duration, 1);
              const eased = 1 - Math.pow(1 - progress, 3);
              const current = isFloat ? (target * eased).toFixed(1) : Math.round(target * eased);
              el.textContent = prefix + current + suffix;
              if (progress < 1) requestAnimationFrame(update);
            }
            requestAnimationFrame(update);
          }, i * 400);
        });
      }
    });
  }, { threshold: 0.3 });
  const statsEl = document.getElementById('csStats');
  if (statsEl) statsObs.observe(statsEl);

  // Results count-up
  let resultsCounted = false;
  const resultObs = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting && !resultsCounted) {
        resultsCounted = true;
        document.querySelectorAll('.cs-result-row-num[data-target]').forEach((el, i) => {
          setTimeout(() => {
            const target = parseFloat(el.dataset.target);
            const prefix = el.dataset.prefix || '';
            const suffix = el.dataset.suffix || '';
            const isFloat = target % 1 !== 0;
            const accentHtml = prefix === '+' ? '<span class="accent">+</span>' : '';
            const duration = 2000;
            const start = performance.now();
            function update(now) {
              const elapsed = now - start;
              const progress = Math.min(elapsed / duration, 1);
              const eased = 1 - Math.pow(1 - progress, 3);
              const current = isFloat ? (target * eased).toFixed(1) : Math.round(target * eased);
              el.innerHTML = accentHtml + (prefix === '+' ? '' : prefix) + current + suffix;
              if (progress < 1) requestAnimationFrame(update);
            }
            requestAnimationFrame(update);
          }, i * 200);
        });
      }
    });
  }, { threshold: 0.2 });
  const resultsEl = document.querySelector('.cs-results');
  if (resultsEl) resultObs.observe(resultsEl);

  // Cap chips staggered
  const capObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.querySelectorAll('.cs-cap-chip').forEach((chip, i) => {
          setTimeout(() => chip.classList.add('visible'), i * 150);
        });
        capObs.unobserve(e.target);
      }
    });
  }, { threshold: 0.3 });
  const capsEl = document.getElementById('csCapsGrid');
  if (capsEl) capObs.observe(capsEl);
</script>
