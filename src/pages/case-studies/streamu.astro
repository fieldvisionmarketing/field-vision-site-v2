---
/**
 * CASE STUDY — StreamU
 * Built on case-study-template.astro v2.0 (Animated). CS rules CS1-CS29 + Brutalist v2.4.
 * Source: 2026 brand guide (client-era receipts). v3 realignment.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import FinalCTA from '@/components/FinalCTA.astro';
import CaseStudyTestimonial from '@/components/CaseStudyTestimonial.astro';
---

<BaseLayout
  title="StreamU Case Study | Fractional CMO for Sports & Creator Startups"
  description="How Field Vision built the content and go-to-market plan that launched an athlete-led livestreaming startup nationally at the March Madness Final Four."
>
  <Header slot="header" />

<!-- Scroll progress bar -->
<div class="cs-scroll-progress" id="csScrollProgress"></div>

<!-- ═══ HERO — CS4-CS8 ═══ -->
<div class="cs-hero-v2-wrapper">
  <div class="cs-hero-v2-sticky" id="csHero">
    <div class="cs-hero-v2-bg" style="background-image:url('/case-studies/streamu-hero.jpg')"></div>
    <div class="cs-hero-v2-content">
      <h1 style="font-size:clamp(34px,4vw,54px)">A National Launch Playbook for<br><span class="highlight-chip">StreamU</span> at the Final Four</h1>
      <p class="cs-hero-v2-summary">We built the content and go-to-market plan that launched an athlete-led livestreaming startup nationally at the March Madness Final Four, a first-of-its-kind strategy executed by a sub-20-person team.</p>
      <div class="cs-scroll-hint">Scroll to explore</div>
    </div>
  </div>
</div>

<!-- ═══ STATS — CS9-CS12 ═══ -->
<section class="cs-stats-v2" id="csStats">
  <div class="cs-stats-v2-inner">
    <div class="cs-stat-drop">
      <div class="cs-stat-drop-num" data-target="1" data-prefix="" data-suffix="st">0st</div>
      <div class="cs-stat-drop-label">First-of-Its-Kind GTM Strategy</div>
    </div>
    <div class="cs-stat-drop">
      <div class="cs-stat-drop-num" data-target="4" data-prefix="" data-suffix="">0</div>
      <div class="cs-stat-drop-label">Final Four Launch Stage</div>
    </div>
    <div class="cs-stat-drop">
      <div class="cs-stat-drop-num" data-target="20" data-prefix="&lt;" data-suffix="">&lt;0</div>
      <div class="cs-stat-drop-label">Person Team, National Reach</div>
    </div>
    <div class="cs-stat-drop">
      <div class="cs-stat-drop-num" data-target="1" data-prefix="" data-suffix="">0</div>
      <div class="cs-stat-drop-label">Repeatable Launch Playbook</div>
    </div>
  </div>
</section>

<!-- ═══ FEATURE VIDEO ═══ -->
<section class="cs-video-v2" id="csVideo">
  <div class="cs-video-v2-inner">
    <span class="eyebrow">See It Live</span>
    <h2>StreamU, In Their Words</h2>
    <div class="cs-video-embed">
      <iframe
        src="https://www.youtube-nocookie.com/embed/OanaUctVP6U?rel=0"
        title="John Lee (StreamU) on Working With Field Vision"
        loading="lazy"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</section>

<!-- ═══ TESTIMONIAL ═══ -->
<section class="cs-testimonial-band">
  <CaseStudyTestimonial
    quote="We knew we had to find the right experts to guide us through this process because we're new to the space. We're extremely grateful for Field Vision's help building a first-of-its-kind go-to-market strategy that will change college sports forever."
    name="John Lee"
    title="COO, The LinkU & Co-Founder, StreamU"
    image="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcR3bieCPL5syl2ynlIqanm4gRt5JDJWL746Jw&s"
  />
</section>

<!-- ═══ CHALLENGE — CS13-CS16 ═══ -->
<section class="cs-challenge-v2">
  <div class="cs-challenge-v2-inner">
    <span class="eyebrow">The Challenge</span>
    <h2>A National Moment, and One Shot to Land It</h2>

    <div class="cs-fly-card">
      <span class="cs-fly-card-num">1</span>
      <span class="cs-fly-card-text"><strong>No go-to-market plan.</strong> A sub-20-person team had a product and a date, with no structured launch, sequencing, or content strategy behind it.</span>
    </div>
    <div class="cs-fly-card">
      <span class="cs-fly-card-num">2</span>
      <span class="cs-fly-card-text"><strong>A stage that would not wait.</strong> The Final Four is fixed on the calendar and unforgiving. The launch had to be right the first time.</span>
    </div>
    <div class="cs-fly-card">
      <span class="cs-fly-card-num">3</span>
      <span class="cs-fly-card-text"><strong>A new category to explain.</strong> Athlete-led livestreaming in the NIL era was unfamiliar to fans, athletes, and press, and needed a story anyone could repeat.</span>
    </div>
    <div class="cs-fly-card">
      <span class="cs-fly-card-num">4</span>
      <span class="cs-fly-card-text"><strong>Creators as the channel.</strong> The whole model depended on athletes showing up and bringing their audiences, which required a content plan built for them.</span>
    </div>

    <div class="cs-mandate-drop">
      <span class="eyebrow">The Mandate</span>
      <blockquote>Turn the Final Four into StreamU's national launch, with a plan a small team can execute under pressure.</blockquote>
    </div>
  </div>
</section>

<!-- ═══ APPROACH — CS17-CS20 ═══ -->
<div class="cs-approach section">
  <div class="cs-section-inner">
    <span class="eyebrow">The Approach</span>
    <h2>Build the Launch Around the Moment</h2>
    <p class="cs-approach-insight">We reverse-engineered the launch from the Final Four back: <em>the positioning, the plan, the athlete motion, and the sequencing</em> that would make a small team look national.</p>

    <div class="cs-approach-grid">
      <div class="cs-phase-card">
        <div class="cs-phase-num">01</div>
        <div class="cs-phase-title">Position the Category</div>
        <div class="cs-phase-desc">Defined what StreamU is and why athlete-led livestreaming matters now, giving fans, athletes, and press a story they could repeat.</div>
        <div class="cs-phase-tools">
          <a href="/services/brand-strategy-positioning" class="cs-phase-tool">Brand Strategy &amp; Positioning →</a>
        </div>
      </div>
      <div class="cs-phase-card">
        <div class="cs-phase-num">02</div>
        <div class="cs-phase-title">Build the GTM Plan</div>
        <div class="cs-phase-desc">Built the full go-to-market plan for a national launch anchored on the Final Four: audiences, channels, sequencing, and milestones.</div>
        <div class="cs-phase-tools">
          <a href="/services/go-to-market" class="cs-phase-tool">Go-to-Market Strategy →</a>
        </div>
      </div>
      <div class="cs-phase-card">
        <div class="cs-phase-num">03</div>
        <div class="cs-phase-title">Design the Content Engine</div>
        <div class="cs-phase-desc">Created the content and creator plan that put athletes and their audiences at the center of the launch, so the platform filled with the right programming.</div>
        <div class="cs-phase-tools">
          <a href="/services/growth-marketing" class="cs-phase-tool">Growth &amp; Lifecycle →</a>
        </div>
      </div>
      <div class="cs-phase-card">
        <div class="cs-phase-num">04</div>
        <div class="cs-phase-title">Launch at the Final Four</div>
        <div class="cs-phase-desc">Sequenced the launch to land on college sport's biggest stage, and handed over a playbook the team could run for the next moment themselves.</div>
        <div class="cs-phase-tools">
          <a href="/services/fractional-cmo" class="cs-phase-tool">Fractional CMO →</a>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ═══ RESULTS — CS21-CS22 ═══ -->
<section class="cs-results section">
  <div class="cs-results-inner">
    <span class="eyebrow">The Results</span>
    <h2>The Numbers Tell the Story</h2>

    <div class="cs-result-row">
      <div class="cs-result-row-num" data-target="4" data-prefix="" data-suffix="">0</div>
      <div>
        <div class="cs-result-label">Final Four Launch Stage</div>
        <div class="cs-result-desc">The go-to-market plan turned the March Madness Final Four into StreamU's national launch moment.</div>
      </div>
    </div>
    <div class="cs-result-row">
      <div class="cs-result-row-num" data-target="1" data-prefix="" data-suffix="st">0st</div>
      <div>
        <div class="cs-result-label">Of Its Kind</div>
        <div class="cs-result-desc">A first-of-its-kind go-to-market strategy for athlete-led livestreaming, in the co-founder's own words.</div>
      </div>
    </div>
    <div class="cs-result-row">
      <div class="cs-result-row-num" data-target="20" data-prefix="&lt;" data-suffix="">&lt;0</div>
      <div>
        <div class="cs-result-label">Person Team</div>
        <div class="cs-result-desc">A national launch built to be executed by a sub-20-person startup, without a big-company machine behind it.</div>
      </div>
    </div>
    <div class="cs-result-row">
      <div class="cs-result-row-num" data-target="1" data-prefix="" data-suffix="">0</div>
      <div>
        <div class="cs-result-label">Repeatable Playbook</div>
        <div class="cs-result-desc">A launch and content playbook the team kept and can run again for the next moment.</div>
      </div>
    </div>
  </div>
</section>

<!-- ═══ IMPACT — CS23-CS25 ═══ -->
<section class="cs-impact-v2">
  <div class="cs-impact-v2-inner">
    <span class="eyebrow">The Impact</span>
    <h2>A Startup That Arrived National</h2>

    <div class="cs-impact-v2-card">
      <div class="cs-impact-icon">↗</div>
      <p class="cs-impact-text">StreamU was built for a real shift: in the NIL era, college athletes own their audiences, and the platforms that serve them grow as fast as the athletes do. By reverse-engineering the plan from the Final Four back, StreamU turned a fixed, high-pressure moment into a national arrival, with a go-to-market and content playbook a small team could run again.</p>
    </div>

    <blockquote class="cs-impact-quote">
      &ldquo;A first-of-its-kind go-to-market strategy that will change college sports forever.&rdquo;
      <cite>Co-Founder, StreamU</cite>
    </blockquote>
  </div>
</section>

<!-- CTA -->
<FinalCTA />

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* ── FEATURE VIDEO — dark section that flows out of the stats ── */
  .cs-stats-v2 {
    min-height: auto;
    padding: 120px 24px 48px;
  }
  .cs-video-v2 {
    background: var(--ink);
    padding: 48px 24px 120px;
  }
  .cs-video-v2-inner {
    max-width: 1000px;
    margin: 0 auto;
    text-align: center;
  }
  .cs-video-v2 .eyebrow {
    color: var(--green-lt);
    opacity: 0;
    transform: translateX(-20px);
    transition: all 0.6s ease;
  }
  .cs-video-v2 .eyebrow::before { background: var(--green-lt); }
  .cs-video-v2 .eyebrow.visible { opacity: 1; transform: translateX(0); }
  .cs-video-v2 h2 {
    font-family: 'Anton', sans-serif;
    color: var(--offwhite);
    font-size: clamp(32px, 5vw, 56px);
    line-height: 1.05;
    margin: 12px 0 40px;
    opacity: 0;
    filter: blur(8px);
    transform: translateY(20px);
    transition: all 0.7s ease;
  }
  .cs-video-v2 h2.visible { opacity: 1; filter: blur(0); transform: translateY(0); }
  .cs-video-embed {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(165, 219, 93, 0.25);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
    opacity: 0;
    transform: translateY(40px) scale(0.97);
    transition: opacity 0.8s ease, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cs-video-embed.visible { opacity: 1; transform: translateY(0) scale(1); }
  .cs-video-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  @supports not (aspect-ratio: 16 / 9) {
    .cs-video-embed { height: 0; padding-top: 56.25%; }
  }
</style>

<script>
  // Scroll progress
  window.addEventListener('scroll', () => {
    const p = (window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)) * 100;
    const bar = document.getElementById('csScrollProgress');
    if (bar) bar.style.width = p + '%';
  });

  // Hero activation
  setTimeout(() => document.getElementById('csHero')?.classList.add('active'), 300);

  // General reveal observer
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) e.target.classList.add('visible');
    });
  }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

  document.querySelectorAll(
    '.cs-video-v2 .eyebrow, .cs-video-v2 h2, .cs-video-embed, ' +
    '.cs-challenge-v2 .eyebrow, .cs-challenge-v2 h2, .cs-fly-card, .cs-mandate-drop, ' +
    '.cs-approach .eyebrow, .cs-approach h2, .cs-approach-insight, .cs-approach-grid .cs-phase-card, ' +
    '.cs-results .eyebrow, .cs-results h2, .cs-result-row, ' +
    '.cs-impact-v2 .eyebrow, .cs-impact-v2 h2, .cs-impact-v2-card, .cs-impact-quote'
  ).forEach(el => obs.observe(el));

  // Stats auto-play drop-in
  let statsTriggered = false;
  const statsObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting && !statsTriggered) {
        statsTriggered = true;
        e.target.classList.add('in-view');
        const blocks = document.querySelectorAll('.cs-stat-drop');
        const nums = document.querySelectorAll('.cs-stat-drop-num[data-target]');
        blocks.forEach((block, i) => {
          setTimeout(() => {
            block.classList.add('dropped');
            const el = nums[i];
            const target = parseFloat(el.dataset.target);
            const prefix = el.dataset.prefix || '';
            const suffix = el.dataset.suffix || '';
            const isFloat = target % 1 !== 0;
            const duration = 1800;
            const start = performance.now();
            function update(now) {
              const elapsed = now - start;
              const progress = Math.min(elapsed / duration, 1);
              const eased = 1 - Math.pow(1 - progress, 3);
              const current = isFloat ? (target * eased).toFixed(1) : Math.round(target * eased);
              el.textContent = prefix + current + suffix;
              if (progress < 1) requestAnimationFrame(update);
            }
            requestAnimationFrame(update);
          }, i * 400);
        });
      }
    });
  }, { threshold: 0.3 });
  const statsEl = document.getElementById('csStats');
  if (statsEl) statsObs.observe(statsEl);

  // Results count-up
  let resultsCounted = false;
  const resultObs = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting && !resultsCounted) {
        resultsCounted = true;
        document.querySelectorAll('.cs-result-row-num[data-target]').forEach((el, i) => {
          setTimeout(() => {
            const target = parseFloat(el.dataset.target);
            const prefix = el.dataset.prefix || '';
            const suffix = el.dataset.suffix || '';
            const isFloat = target % 1 !== 0;
            const duration = 2000;
            const start = performance.now();
            function update(now) {
              const elapsed = now - start;
              const progress = Math.min(elapsed / duration, 1);
              const eased = 1 - Math.pow(1 - progress, 3);
              const current = isFloat ? (target * eased).toFixed(1) : Math.round(target * eased);
              el.textContent = prefix + current + suffix;
              if (progress < 1) requestAnimationFrame(update);
            }
            requestAnimationFrame(update);
          }, i * 200);
        });
      }
    });
  }, { threshold: 0.2 });
  const resultsEl = document.querySelector('.cs-results');
  if (resultsEl) resultObs.observe(resultsEl);

  // Cap chips staggered
  const capObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.querySelectorAll('.cs-cap-chip').forEach((chip, i) => {
          setTimeout(() => chip.classList.add('visible'), i * 150);
        });
        capObs.unobserve(e.target);
      }
    });
  }, { threshold: 0.3 });
  const capsEl = document.getElementById('csCapsGrid');
  if (capsEl) capObs.observe(capsEl);
</script>
