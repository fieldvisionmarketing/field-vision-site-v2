---
/* Private pitch: The Therapist x SimplePractice. Unlisted, DM only. */
import PitchPage from '@/components/PitchPage.astro';

const base = '/pitch/thetherapist-simplepractice';
const deck = '/pitch/thetherapist'; // shared, brand-neutral deck
const slides = Array.from({ length: 19 }, (_, i) => `${deck}/slides/slide-${String(i + 1).padStart(2, '0')}.webp`);
---

<PitchPage
  pageTitle="The Therapist x SimplePractice"
  brand="SimplePractice"
  show="The Therapist"
  subhead="A Season 2 partnership built for SimplePractice. Watch the sizzle, then open the deck."
  video={`${base}/pitch.mp4`}
  poster={`${base}/poster.jpg`}
  slides={slides}
  pdf={`${deck}/The-Therapist-Sponsorship-Deck.pdf`}
  ogImage={`${base}/og.jpg`}
  theme={{ bg: '#FFFAEB', surface: '#FFFFFF', ink: '#123333', muted: '#446464', accent: '#FFC700', accentDk: '#CC9F00' }}
/>
