---
/* Private pitch: LAYERS Season 2 x Wacom. Unlisted, DM only. */
import PitchPage from '@/components/PitchPage.astro';

const base = '/pitch/layers-wacom';
const deck = '/pitch/layers'; // shared LAYERS one-pager (portrait, letter)
const slides = [`${deck}/slides/slide-01.webp`];
---

<PitchPage
  pageTitle="LAYERS x Wacom"
  brand="Wacom"
  show="LAYERS"
  subhead="A Season 2 partnership built for Wacom. Watch the sizzle, then open the one-pager."
  video={`${base}/pitch.mp4`}
  poster={`${base}/poster.jpg`}
  slides={slides}
  slideLinks={['https://www.youtube.com/watch?v=tVz2IAAxttE&t=2s']}
  slideAspect="612 / 792"
  pdf={`${deck}/LAYERS-One-Pager.pdf`}
  ogImage={`${base}/og.jpg`}
  hideNav
  theme={{ bg: '#F5F8FA', surface: '#FFFFFF', ink: '#0A0A0A', muted: '#4A4F54', accent: '#19A7E0', accentDk: '#0E86B8', onAccent: '#FFFFFF' }}
/>
