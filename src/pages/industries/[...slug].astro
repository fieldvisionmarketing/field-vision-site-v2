---
import { getCollection } from 'astro:content';
import IndustryPage from '@/components/IndustryPage.astro';

export async function getStaticPaths() {
  const industries = await getCollection('industries');
  return industries
    .filter((i) => !i.data.hidden)
    .map((industry) => ({
      params: { slug: industry.id.replace(/\.md$/, '') },
      props: { industry },
    }));
}

const { industry } = Astro.props;
const slug = industry.id.replace(/\.md$/, '');
const pageUrl = `https://fieldvisiongroup.com/industries/${slug}/`;
---

<IndustryPage industry={industry} pageUrl={pageUrl} />
