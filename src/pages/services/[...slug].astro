---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((service) => ({
    params: { slug: service.id.replace(/\.md$/, '') },
    props: { service },
  }));
}

const { service } = Astro.props;
const d = service.data;

const siteUrl = 'https://fieldvisiongroup.com';
const slug = service.id.replace(/\.md$/, '');

/* ── Highlight chip helper: wraps last word in hl-green ── */
function chipLastWord(text, chipClass = 'hl-green') {
  // Chip the last word — trailing punctuation stays inside the span (R19)
  const words = text.trim().split(/\s+/);
  if (words.length <= 1) return text;
  const last = words.pop();
  return words.join(' ') + ' <span class="' + chipClass + '">' + last + '</span>';
}
function chipCtaWord(text, chipClass = 'hl-green') {
  // Chip the last word — include trailing punctuation INSIDE the span (R19)
  const match = text.match(/^(.+?)\s+(\S+?)([?!.]?)$/);
  if (!match) return text;
  const [, prefix, lastWord, punct] = match;
  return prefix + ' <span class="' + chipClass + '">' + lastWord + punct + '</span>';
}

const heroTitle = chipLastWord(d.title);
const ctaTitle = chipCtaWord(d.ctaHeadline || 'Ready to Build Your Growth Engine?');
const problemTitle = chipLastWord(d.problemHeadline || 'The Challenge');


/* ── Schema.org: Service ── */
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": d.title,
  "description": d.description,
  "provider": {
    "@type": "Organization",
    "name": "Field Vision Group",
    "url": siteUrl
  },
  "areaServed": { "@type": "Country", "name": "United States" },
  "url": `${siteUrl}/services/${slug}/`
};

/* ── Schema.org: FAQPage ── */
const faqSchema = d.faqs?.length ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": d.faqs.map((faq: { question: string; answer: string }) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
  }))
} : null;
---

<BaseLayout
  title={d.title + ' | Field Vision'}
  description={d.description}
  ogImage={d.ogImage}
>
  <Header slot="header" />

  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </Fragment>

  <!-- ═══ HERO ═══ -->
  <section class="svcpg-hero">
    <div class="svcpg-hero-inner">
      <div class="svcpg-hero-text">
        <h1 set:html={heroTitle} />
        <p class="svcpg-subtitle">{d.description}</p>
        <a href="/contact/" class="btn-brutal">Book a Call →</a>
      </div>
      <aside class="svcpg-sidebar reveal">
        <div class="svcpg-sidebar-header">Engagement Snapshot</div>
        <div class="svcpg-sidebar-body">
          {d.sidebar?.map((item: { label: string; value: string }) => (
            <div class="svcpg-sidebar-row">
              <span class="svcpg-sidebar-key">{item.label}</span>
              <span class="svcpg-sidebar-val">{item.value}</span>
            </div>
          ))}
        </div>
      </aside>
    </div>
  </section>

  <!-- ═══ PROBLEM / SOLUTION ═══ -->
  <section class="svcpg-ps reveal">
    <div class="svcpg-ps-inner">
      <span class="eyebrow">The Challenge You're Facing</span>
      <h2 set:html={problemTitle} />
      <p class="svcpg-ps-intro">{d.problemIntro}</p>
      <div class="svcpg-ps-grid">
        <div class="svcpg-ps-card svcpg-ps-old">
          <div class="svcpg-ps-card-header svcpg-ps-card-header--old">Without Strategic Leadership</div>
          <div class="svcpg-ps-card-body">
            <ul>
              {d.oldWay?.map((item: string) => <li><span class="ps-x">✗</span> {item}</li>)}
            </ul>
          </div>
        </div>
        <div class="svcpg-ps-card svcpg-ps-new">
          <div class="svcpg-ps-card-header svcpg-ps-card-header--new">With Field Vision</div>
          <div class="svcpg-ps-card-body">
            <ul>
              {d.newWay?.map((item: string) => <li><span class="ps-check">✓</span> {item}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ DELIVERABLES ═══ -->
  <section class="svcpg-del reveal">
    <div class="svcpg-del-inner">
      <span class="eyebrow">What You Walk Away With</span>
      <h2><span class="hl-cream">Deliverables</span></h2>
      <div class="svcpg-del-grid">
        {d.deliverables?.map((del: { icon: string; title: string; desc: string }) => (
          <div class="svcpg-del-card">
            <span class="svcpg-del-icon">{del.icon}</span>
            <h3>{del.title}</h3>
            <p>{del.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ WHO THIS IS FOR ═══ -->
  <section class="svcpg-who reveal">
    <div class="svcpg-who-inner">
      <div class="svcpg-who-main">
        <span class="eyebrow">Is This You?</span>
        <h2>Who This Is <span class="hl-cream">For</span></h2>
        <p class="svcpg-who-intro">{d.whoIntro}</p>
        <ul class="svcpg-who-triggers">
          {d.whoTriggers?.map((t: string) => (
            <li><span class="who-check">✓</span> {t}</li>
          ))}
        </ul>
      </div>
      <aside class="svcpg-who-cta-card">
        <div class="svcpg-who-cta-header">{d.whoCta?.headline || 'Ready to get started?'}</div>
        <div class="svcpg-who-cta-body">
          <p>{d.whoCta?.body || "Book a 30-minute discovery call. We'll discuss where you are, where you want to go, and whether Field Vision is the right fit."}</p>
          <a href="/contact/" class="btn-brutal">Let's Talk →</a>
        </div>
      </aside>
    </div>
  </section>

  <!-- ═══ ABCT® MODEL ═══ -->
  <section class="svcpg-abct reveal">
    <div class="svcpg-abct-inner">
      <span class="eyebrow">Our Proven Framework</span>
      <h2>The <span class="hl-green">ABCT®</span> Model</h2>
      <p class="svcpg-abct-intro">Every engagement follows our proven four-phase framework — designed to deliver results and build independence.</p>
      <div class="svcpg-abct-grid">
        {(d.abctSteps || [
          { step: 'A', title: 'Audit', desc: "Deep-dive diagnostic into what's working, what's not, and where the biggest opportunities are." },
          { step: 'B', title: 'Blueprint', desc: "Strategy, positioning, and channel plan — tied directly to your growth model and business goals." },
          { step: 'C', title: 'Construct', desc: "Stand up the systems, processes, and team structure to execute the strategy at scale." },
          { step: 'T', title: 'Transfer', desc: "Document everything and hand it off so your team can run independently — built to be fired." },
        ]).map((s: { step: string; title: string; desc: string }, i: number) => (
          <div class="svcpg-abct-card">
            <span class="svcpg-abct-num">0{i + 1}</span>
            <h3>{s.step} — {s.title}</h3>
            <p>{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ FAQ ═══ -->
  {d.faqs?.length > 0 && (
    <section class="faq-section svcpg-faq reveal">
      <div class="faq-section-inner">
        <span class="eyebrow">Common Questions</span>
        <h2><span class="hl-cream">FAQ</span></h2>
        <div class="faq-canon-list">
          {d.faqs.map((faq: { question: string; answer: string }) => (
            <details class="faq-canon-item">
              <summary>{faq.question}</summary>
              <div class="faq-canon-answer"><p>{faq.answer}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ═══ FINAL CTA ═══ -->
  <section class="svcpg-final-cta reveal">
    <div class="svcpg-final-cta-inner">
      <h2 set:html={ctaTitle} />
      <p>{d.ctaBody || "Book a 30-minute discovery call. We'll talk about where you are, where you want to go, and whether Field Vision is the right fit."}</p>
      <a href="/contact/" class="btn-brutal">Book a Call →</a>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
