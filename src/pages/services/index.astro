---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Verticals from '@/components/Verticals.astro';

const services = (await getCollection('services'))
  .filter(s => !s.data.hidden)
  .sort((a, b) => a.data.order - b.data.order);

const siteUrl = 'https://fieldvisiongroup.com';

/* Schema.org for the services listing */
const serviceListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Field Vision Marketing Services",
  "itemListElement": services.map((s, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": s.data.title,
    "url": `${siteUrl}/services/${s.id.replace(/\.md$/, '')}/`
  }))
};
---

<BaseLayout
  title="Marketing Services for Startups | Field Vision"
  description="Fractional CMO, go-to-market strategy, growth marketing, content strategy, and marketing org design for seed through Series D startups in digital media and entertainment."
>
  <Header slot="header" />

  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(serviceListSchema)} />
  </Fragment>

  <!-- ═══ HERO ═══ -->
  <section class="svclp-hero reveal">
    <div class="svclp-hero-inner">
      <span class="eyebrow">Full-Stack Marketing Leadership</span>
      <h1>Our <span class="hl-green">Services</span></h1>
      <p class="svclp-hero-lede">Strategy through execution, built for startups at inflection points. Brand, go-to-market, growth, and lifecycle run as one integrated system. Every engagement follows our ABCT® model: Audit, Blueprint, Construct, Transfer.</p>
    </div>
  </section>

  <!-- ═══ SERVICE CARDS GRID ═══ -->
  <section class="svclp-grid-section reveal">
    <div class="svclp-grid-inner">
      <div class="svclp-grid">
        {services.map((service, i) => {
          const slug = service.id.replace(/\.md$/, '');
          return (
            <a href={`/services/${slug}/`} class={`svclp-card reveal rd${(i % 3) + 1}`}>
              <div class="svclp-card-header">
                {service.data.icon && <span class="svclp-card-icon">{service.data.icon}</span>}
                <span class="svclp-card-name">{service.data.title}</span>
              </div>
              <div class="svclp-card-body">
                <p class="svclp-card-desc">{service.data.description}</p>
                <span class="svclp-card-link">Learn More →</span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <Verticals />

  <!-- ═══ ABCT MODEL OVERVIEW ═══ -->
  <section class="svclp-abct reveal">
    <div class="svclp-abct-inner">
      <span class="eyebrow">Built to Be Fired</span>
      <h2>The <span class="hl-green">ABCT®</span> Model</h2>
      <p class="svclp-abct-intro">Every engagement follows the same four-phase framework, designed to deliver results and build independence. We succeed when you don't need us anymore.</p>
      <div class="svclp-abct-grid">
        <div class="svclp-abct-card">
          <span class="svclp-abct-num">01</span>
          <h3>A, Audit</h3>
          <p>Deep-dive diagnostic into what's working, what's not, and where the biggest opportunities are.</p>
        </div>
        <div class="svclp-abct-card">
          <span class="svclp-abct-num">02</span>
          <h3>B, Blueprint</h3>
          <p>Strategy, positioning, and channel plan, tied directly to your growth model and business goals.</p>
        </div>
        <div class="svclp-abct-card">
          <span class="svclp-abct-num">03</span>
          <h3>C, Construct</h3>
          <p>Stand up the systems, processes, and team structure to execute the strategy at scale.</p>
        </div>
        <div class="svclp-abct-card">
          <span class="svclp-abct-num">04</span>
          <h3>T, Transfer</h3>
          <p>Document everything and hand it off so your team can run independently.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ CTA ═══ -->
  <section class="svclp-cta reveal">
    <div class="svclp-cta-inner">
      <h2>Ready to Build Your <span class="hl-green">Growth Engine?</span></h2>
      <p>Book a 30-minute discovery call. We'll talk about where you are, where you want to go, and whether Field Vision is the right fit.</p>
      <a href="/contact/" class="btn-brutal">Book a Call →</a>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
