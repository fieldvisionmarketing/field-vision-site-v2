---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

const services = (await getCollection('services'))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Marketing Services for Startups" description="Fractional CMO, go-to-market strategy, growth marketing, content strategy, and marketing org design for seed through Series D startups in digital media and entertainment.">
  <Header slot="header" />

  <section class="services-listing">
    <div class="services-listing-inner">
      <h1 class="reveal">Our <span class="highlight">Services</span></h1>
      <p class="section-sub reveal rd1">Full-stack marketing leadership — from strategy through execution — built for startups at inflection points.</p>

      <div class="services-grid" style="margin-top:48px">
        {services.map((service, i) => (
          <a href={`/services/${service.id.replace(/\.md$/, '')}/`} class={`service-list-card reveal rd${(i % 3) + 1}`}>
            {service.data.icon && <span class="service-list-icon">{service.data.icon}</span>}
            <h3>{service.data.title}</h3>
            <p>{service.data.description}</p>
            <span class="service-list-link">Learn More →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .services-listing {
    padding: 140px 24px 80px;
  }
  .services-listing-inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .services-listing h1 {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4rem);
    text-transform: uppercase;
    line-height: 0.92;
    text-align: center;
  }
  .services-listing .section-sub {
    text-align: center;
    max-width: 600px;
    margin: 16px auto 0;
  }
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr));
    gap: 24px;
  }
  .service-list-card {
    background: #fff;
    border: 1px solid #e0e0e0;
    border-radius: 16px;
    padding: 36px 28px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.25s, box-shadow 0.25s;
    display: flex;
    flex-direction: column;
  }
  .service-list-card:hover {
    border-color: var(--accent);
    box-shadow: 0 4px 20px rgba(0,0,0,0.06);
  }
  .service-list-icon {
    font-size: 2rem;
    margin-bottom: 12px;
  }
  .service-list-card h3 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    text-transform: uppercase;
    line-height: 1.1;
    margin-bottom: 12px;
  }
  .service-list-card p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #555;
    flex: 1;
  }
  .service-list-link {
    margin-top: 16px;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--dark);
  }
  @media (max-width: 768px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
