---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import FinalCTA from '@/components/FinalCTA.astro';

const orderMap = {
  'abct-framework': 1,
  'score-framework': 2,
  'compound-growth-system': 3,
  'plot-framework': 4,
  'ai-blueprint': 5,
  'gtm-template': 6,
};
const guides = (await getCollection('guides')).sort((a, b) => {
  const slugA = a.id.replace(/\.(md|mdx)$/, '');
  const slugB = b.id.replace(/\.(md|mdx)$/, '');
  return (orderMap[slugA] || 99) - (orderMap[slugB] || 99);
});
---

<BaseLayout title="Marketing Frameworks & Guides" description="Proprietary marketing frameworks and playbooks for startups — SCORE®, ABCT®, Compound Growth System®, and more. Free downloads built from a decade of growth leadership at Amazon, Twitch, and Pandora.">
  <Header slot="header" />

  <!-- HERO (cream bg) -->
  <section class="gdlp-hero section">
    <div class="gdlp-hero-inner">
      <span class="eyebrow">— Frameworks & Guides</span>
      <h1>Proprietary <span class="hl-green">Playbooks</span></h1>
      <div class="gdlp-hero-divider"></div>
      <p class="gdlp-hero-sub">Built from a decade of scaling marketing functions at Amazon, Twitch, Pandora, and Hard Rock. Download them. Use them. Win.</p>
    </div>
  </section>

  <!-- GUIDE CARDS (white bg) -->
  <section class="gdlp-cards section">
    <div class="gdlp-cards-inner">
      <div class="gdlp-grid">
        {guides.map((guide) => {
          const slug = guide.id.replace(/\.(md|mdx)$/, '');
          return (
            <a href={`/guides/${slug}/`} class="gdlp-card">
              <div class="gdlp-card-header">
                <span>{guide.data.framework || 'Guide'}</span>
                {guide.data.phases && <span class="gdlp-card-phases">{guide.data.phases}</span>}
              </div>
              <div class="gdlp-card-body">
                <h3>{guide.data.title}</h3>
                <p>{guide.data.description}</p>
              </div>
              <div class="gdlp-card-footer">
                <div class="gdlp-card-tags">
                  {guide.data.readTime && <span class="gdlp-tag">{guide.data.readTime}</span>}
                  {guide.data.gated && <span class="gdlp-tag">Free Download</span>}
                </div>
                <span class="gdlp-card-link">{guide.data.gated ? 'Get the Guide →' : 'Read Now →'}</span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <FinalCTA />

  <Footer slot="footer" />
</BaseLayout>
