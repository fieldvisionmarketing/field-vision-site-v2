---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

export async function getStaticPaths() {
  const guides = await getCollection("guides");
  return guides.map((guide) => ({
    params: { slug: guide.id.replace(/\.mdx?$/, '') },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
const guideSlug = guide.id.replace(/\.mdx?$/, '');
---

<BaseLayout
  title={guide.data.title}
  description={guide.data.description}
  ogImage={guide.data.ogImage}
>
  <Header slot="header" />

  <article class="guide-page">

    <!-- ======== HERO ======== -->
    <section class="guide-hero">
      <div class="hero-inner">
        {guide.data.framework && (
          <span class="hero-badge">Framework Guide</span>
        )}
        <h1>{guide.data.title}</h1>
        <p class="hero-subtitle">{guide.data.description}</p>
        <div class="hero-meta">
          <span class="meta-pill"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> {guide.data.readTime}</span>
          <span class="meta-pill"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg> {guide.data.phases}</span>
          {guide.data.downloadUrl && (
            <span class="meta-pill"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg> {guide.data.downloadLabel || "PDF"} Available</span>
          )}
        </div>
      </div>
    </section>

    <!-- ======== CONTENT WITH SIDEBAR ======== -->
    {guide.data.gated ? (
      <div class="guide-gate" data-guide-slug={guideSlug} data-download-url={guide.data.downloadUrl} data-guide-framework={guide.data.framework} data-download-label={guide.data.downloadLabel || "PDF"}>
        <div class="guide-preview">
          <div class="guide-layout">
            <div class="guide-main">
              <div class="guide-content" id="guide-content">
                <Content />
              </div>
            </div>
            <aside class="guide-sidebar">
              <div class="sidebar-inner" id="guide-toc">
                <div class="toc-label">In This Guide</div>
                <nav>
                  <ul id="toc-list"></ul>
                </nav>
              </div>
              {guide.data.downloadUrl && (
                <div class="toc-download">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A5DB5D" stroke-width="2" style="margin-bottom:8px"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                  <p class="toc-download-text">Download the full guide as a {guide.data.downloadLabel || "PDF"}</p>
                  <a href={guide.data.downloadUrl} target="_blank" rel="noopener noreferrer" class="toc-download-btn">Download {guide.data.downloadLabel || "PDF"} &rarr;</a>
                </div>
              )}
            </aside>
          </div>
        </div>
        <div class="guide-gate-overlay"></div>
        <div class="guide-gate-form">
          <div class="gate-card">
            <div class="gate-icon">ð</div>
            <h3 class="gate-title">Get the Full Guide</h3>
            <p class="gate-desc">Enter your email to unlock the complete {guide.data.framework} framework guide, including implementation steps, templates, and real examples.</p>
            <form class="guide-gate-submit">
              <input type="text" name="name" placeholder="First name" class="gate-input" />
              <input type="email" name="email" placeholder="Work email" class="gate-input" required />
              <button type="submit" class="gate-btn">Get Instant Access &rarr;</button>
            </form>
            <p class="gate-fine-print">No spam. Instant access.</p>
          </div>
        </div>
      </div>
    ) : (
      <div class="guide-layout">
        <div class="guide-main">
          <div class="guide-content" id="guide-content">
            <Content />
          </div>
        </div>
        <aside class="guide-sidebar">
          <div class="sidebar-inner" id="guide-toc">
            <div class="toc-label">In This Guide</div>
            <nav>
              <ul id="toc-list"></ul>
            </nav>
          </div>
          {guide.data.downloadUrl && (
            <div class="toc-download">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A5DB5D" stroke-width="2" style="margin-bottom:8px"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
              <p class="toc-download-text">Download the full guide as a {guide.data.downloadLabel || "PDF"}</p>
              <a href={guide.data.downloadUrl} target="_blank" rel="noopener noreferrer" class="toc-download-btn">Download {guide.data.downloadLabel || "PDF"} &rarr;</a>
            </div>
          )}
        </aside>
      </div>
    )}

    <!-- ======== CTA FOOTER ======== -->
    <section class="guide-cta-footer">
      <h2>Ready to Put This Into Action?</h2>
      <p>Book a free strategy call and find out where your marketing stands, and what to fix first.</p>
      <a href="/contact" class="cta-btn">Book a Call &rarr;</a>
    </section>

    {guide.data.schemaJson && (
      <Fragment set:html={`<script type="application/ld+json">${guide.data.schemaJson}</script>`} />
    )}

  </article>

  <Footer slot="footer" />
</BaseLayout>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // Preview bypass: ?preview=true skips the email gate
    if (new URLSearchParams(window.location.search).get('preview') === 'true') {
      document.querySelectorAll('.guide-gate-overlay').forEach(el => (el as HTMLElement).style.display = 'none');
      document.querySelectorAll('.guide-gate-form').forEach(el => el.remove());
      const preview = document.querySelector('.guide-preview') as HTMLElement;
      if (preview) { preview.style.maxHeight = 'none'; preview.style.overflow = 'visible'; }
      const content = document.getElementById('guide-content') || document.querySelector('.guide-content');
      if (content) { (content as HTMLElement).style.display = 'block'; (content as HTMLElement).style.opacity = '1'; (content as HTMLElement).style.maxHeight = 'none'; (content as HTMLElement).style.overflow = 'visible'; }

      // Add preview banner
      const gate = document.querySelector('.guide-gate');
      if (gate) {
        const banner = document.createElement('div');
        banner.className = 'preview-banner';
        banner.innerHTML = '<span>Full Preview Mode</span>, Email gate is hidden';
        gate.parentElement?.insertBefore(banner, gate);
      }
    }


  // ---- Build TOC from H2/H3 headings ----
  const content = document.getElementById('guide-content');
  const tocList = document.getElementById('toc-list');
  if (content && tocList) {
    const headings = content.querySelectorAll('h2, h3');
    headings.forEach((h, i) => {
      if (!h.id) h.id = 'section-' + i;
      const li = document.createElement('li');
      li.className = h.tagName === 'H3' ? 'toc-item toc-sub' : 'toc-item';
      const a = document.createElement('a');
      a.href = '#' + h.id;
      a.textContent = h.textContent || '';
      a.addEventListener('click', (e) => {
        e.preventDefault();
        h.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
      li.appendChild(a);
      tocList.appendChild(li);
    });

    // Scroll-spy with IntersectionObserver
    const tocLinks = tocList.querySelectorAll('a');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          tocLinks.forEach(link => link.classList.remove('active'));
          const active = tocList.querySelector('a[href="#' + entry.target.id + '"]');
          if (active) active.classList.add('active');
        }
      });
    }, { rootMargin: '-80px 0px -70% 0px', threshold: 0 });

    headings.forEach(h => observer.observe(h));
  }

  // ---- Gate unlock logic ----
  document.querySelectorAll('.guide-gate').forEach((gate) => {
    const slug = (gate as HTMLElement).dataset.guideSlug;
    const downloadUrl = (gate as HTMLElement).dataset.downloadUrl;
    const framework = (gate as HTMLElement).dataset.guideFramework;

    if (slug && localStorage.getItem('guide_unlocked_' + slug)) {
      const preview = gate.querySelector('.guide-preview') as HTMLElement;
      const overlay = gate.querySelector('.guide-gate-overlay') as HTMLElement;
      const formSection = gate.querySelector('.guide-gate-form') as HTMLElement;

      if (preview) preview.style.maxHeight = 'none';
      if (overlay) overlay.style.display = 'none';
      if (formSection) {
        const dlLink = downloadUrl ? '<a href="' + downloadUrl + '" class="download-btn" download>Download ' + (gate.dataset.downloadLabel || 'PDF') + ' Now</a>' : '';
        formSection.innerHTML = '<div class="gate-card" style="text-align:center;padding:48px 32px">' +
          '<div style="font-size:3rem;margin-bottom:16px">&#10003;</div>' +
          '<h3 class="gate-title" style="margin-bottom:12px">You have access!</h3>' +
          dlLink +
          '<p class="gate-desc" style="margin-bottom:20px">Enjoy the full ' + (framework || '') + ' guide below.</p>' +
          '</div>';
      }
    }
  });

  // ---- Handle form submissions ----
  document.querySelectorAll('.guide-gate-submit').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const formEl = form as HTMLFormElement;
      const gate = formEl.closest('.guide-gate') as HTMLElement;
      const slug = gate?.dataset.guideSlug || '';
      const btn = formEl.querySelector('.gate-btn') as HTMLButtonElement;
      const nameInput = formEl.querySelector('input[name="name"]') as HTMLInputElement;
      const emailInput = formEl.querySelector('input[name="email"]') as HTMLInputElement;
      const name = nameInput?.value || '';
      const email = emailInput?.value || '';

      if (!email) return;

      btn.textContent = 'Unlocking...';
      btn.disabled = true;

      fetch('https://script.google.com/macros/s/AKfycbwLa1iVkHLxu15OjmvM2kcj08RXGEpsx-j6Q82-U6M6Knayj6ZT1775Hl__J_Ctwzs-Kw/exec', {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, guide: slug })
      }).then(() => {
        localStorage.setItem('guide_unlocked_' + slug, 'true');
        window.location.reload();
      }).catch(() => {
        localStorage.setItem('guide_unlocked_' + slug, 'true');
        window.location.reload();
      });
    });
  });

});
</script>

<style>
/* ========================================
   FIELD VISION GUIDE PAGE â MOCKUP DESIGN
   Phase badges Â· GOAL/OUTPUT cards Â· Stats bar Â· Rich typography
   ======================================== */

.guide-page {
  width: 100%;
  overflow: hidden;
}

/* ---- HERO ---- */
.guide-hero {
  background: #213621;
  padding: 80px 48px 64px;
  text-align: center;
}
.hero-inner {
  max-width: 800px;
  margin: 0 auto;
}
.hero-badge {
  display: inline-block;
  background: rgba(165, 219, 93, 0.12);
  border: 1px solid rgba(165, 219, 93, 0.25);
  color: #A5DB5D;
  font-family: 'Satoshi', sans-serif;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  padding: 6px 18px;
  border-radius: 20px;
  margin-bottom: 28px;
}
.guide-hero h1 {
  font-family: 'Anton', sans-serif;
  font-weight: 400;
  font-size: clamp(40px, 5.5vw, 64px);
  color: #F5F0E8;
  text-transform: uppercase;
  letter-spacing: -0.5px;
  line-height: 1.05;
  margin-bottom: 20px;
}
.hero-subtitle {
  font-family: 'Satoshi', sans-serif;
  font-size: 17px;
  color: rgba(245, 240, 232, 0.55);
  max-width: 580px;
  margin: 0 auto 28px;
  line-height: 1.7;
}
.hero-meta {
  display: flex;
  justify-content: center;
  gap: 12px;
  flex-wrap: wrap;
}
.meta-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.1);
  color: rgba(245, 240, 232, 0.5);
  font-family: 'Satoshi', sans-serif;
  font-size: 13px;
  padding: 7px 16px;
  border-radius: 20px;
}

/* ---- LAYOUT: CONTENT + SIDEBAR ---- */
.guide-layout {
  display: grid;
  grid-template-columns: 1fr 280px;
  gap: 56px;
  max-width: 1120px;
  margin: 0 auto;
  padding: 56px 32px 80px;
  align-items: start;
}
.guide-main {
  min-width: 0;
}

/* ---- SIDEBAR / TOC ---- */
.guide-sidebar {
  position: sticky;
  top: 90px;
  max-height: calc(100vh - 110px);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.guide-sidebar .sidebar-inner {
  overflow-y: auto;
  flex: 1;
  min-height: 0;
}

.guide-sidebar .toc-download {
  flex-shrink: 0;
}
.sidebar-inner {
  background: #fff;
  border: 1px solid rgba(33,54,33,0.08);
  border-radius: 14px;
  padding: 28px 24px;
  box-shadow: 0 2px 16px rgba(33,54,33,0.04);
}
.toc-label {
  font-family: 'Satoshi', sans-serif;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.5px;
  color: #213621;
  margin-bottom: 18px;
  padding-bottom: 14px;
  border-bottom: 1px solid rgba(33,54,33,0.08);
}
#toc-list {
  list-style: none;
  padding: 0;
  margin: 0;
}
:global(.toc-item) {
  margin-bottom: 2px;
}
:global(.toc-item a) {
  display: block;
  font-family: 'Satoshi', sans-serif;
  font-size: 13.5px;
  color: rgba(33, 54, 33, 0.5);
  text-decoration: none;
  padding: 7px 14px;
  border-radius: 8px;
  border-left: 2px solid transparent;
  transition: all 0.2s ease;
  line-height: 1.4;
}
:global(.toc-item a:hover) {
  color: #213621;
  background: rgba(165,219,93,0.06);
}
:global(.toc-item a.active) {
  color: #213621;
  font-weight: 600;
  border-left-color: #A5DB5D;
  background: rgba(165,219,93,0.08);
}
:global(.toc-sub a) {
  padding-left: 28px;
  font-size: 13px;
}

/* ---- TOC Download Card ---- */
.toc-download {
  margin-top: 18px;
  background: #213621;
  border-radius: 14px;
  padding: 24px 20px;
  text-align: center;
}
.toc-download-text {
  font-family: 'Satoshi', sans-serif;
  font-size: 13px;
  color: rgba(245, 240, 232, 0.55);
  margin-bottom: 14px;
  line-height: 1.5;
}
.toc-download-btn {
  display: block;
  background: #A5DB5D;
  color: #213621;
  padding: 11px 16px;
  border-radius: 10px;
  font-family: 'Satoshi', sans-serif;
  font-size: 13px;
  font-weight: 700;
  text-decoration: none;
  letter-spacing: 0.3px;
  transition: opacity 0.2s;
}
.toc-download-btn:hover {
  opacity: 0.9;
}

/* ========================================
   GUIDE CONTENT â RICH TYPOGRAPHY & CARDS
   ======================================== */

/* --- H2 â Major section headers --- */
.guide-content :global(h2) {
  font-family: 'Anton', sans-serif;
  font-size: 1.5rem;
  font-weight: 400;
  color: #213621;
  text-transform: uppercase;
  margin-top: 64px;
  margin-bottom: 24px;
  padding-bottom: 14px;
  border-bottom: 2px solid rgba(165,219,93,0.25);
  letter-spacing: 0.5px;
  line-height: 1.15;
}
.guide-content :global(h2:first-child) {
  margin-top: 0;
}

/* --- H3 â Phase headings (styled as phase cards) --- */
.guide-content :global(h3) {
  font-family: 'Anton', sans-serif;
  font-size: 1.35rem;
  font-weight: 400;
  color: #213621;
  text-transform: uppercase;
  margin-top: 48px;
  margin-bottom: 8px;
  letter-spacing: 0.5px;
  line-height: 1.2;
}

/* --- H4 â Subsection labels (GOAL, OUTPUT, etc.) --- */
.guide-content :global(h4) {
  font-family: 'Satoshi', sans-serif;
  font-size: 12px;
  font-weight: 700;
  color: #8B9A7E;
  text-transform: uppercase;
  letter-spacing: 2px;
  margin-top: 32px;
  margin-bottom: 12px;
}

/* --- Paragraphs --- */
.guide-content :global(p) {
  font-family: 'Satoshi', sans-serif;
  font-size: 17px;
  line-height: 1.75;
  color: rgba(33, 54, 33, 0.7);
  margin-bottom: 20px;
}

/* --- Emphasis text (subtitle under phase headings) --- */
.guide-content :global(h3 + p em:first-child),
.guide-content :global(h3 + p > em:only-child) {
  display: block;
  font-family: 'Satoshi', sans-serif;
  font-style: italic;
  color: rgba(33, 54, 33, 0.5);
  font-size: 15px;
  margin-bottom: 24px;
}

/* --- Strong text --- */
.guide-content :global(strong) {
  color: #213621;
  font-weight: 600;
}

/* --- Links --- */
.guide-content :global(a) {
  color: #4A8C3F;
  text-decoration: underline;
  text-underline-offset: 3px;
}
.guide-content :global(a:hover) {
  color: #213621;
}

/* --- Unordered Lists --- */
.guide-content :global(ul) {
  list-style: none;
  padding-left: 0;
  margin-bottom: 20px;
}
.guide-content :global(ul li) {
  position: relative;
  padding-left: 24px;
  margin-bottom: 10px;
  line-height: 1.7;
  color: rgba(33, 54, 33, 0.7);
  font-family: 'Satoshi', sans-serif;
  font-size: 16px;
}
.guide-content :global(ul li::before) {
  content: '';
  position: absolute;
  left: 4px;
  top: 11px;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #A5DB5D;
}

/* --- Ordered Lists --- */
.guide-content :global(ol) {
  margin-bottom: 20px;
  padding-left: 0;
  counter-reset: guide-counter;
  list-style: none;
}
.guide-content :global(ol li) {
  position: relative;
  padding-left: 36px;
  margin-bottom: 12px;
  line-height: 1.7;
  color: rgba(33, 54, 33, 0.7);
  font-family: 'Satoshi', sans-serif;
  font-size: 16px;
  counter-increment: guide-counter;
}
.guide-content :global(ol li::before) {
  content: counter(guide-counter);
  position: absolute;
  left: 0;
  top: 3px;
  width: 24px;
  height: 24px;
  background: #213621;
  color: #A5DB5D;
  border-radius: 50%;
  font-size: 12px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* --- Blockquotes â KEY PRINCIPLE callout --- */
.guide-content :global(blockquote) {
  background: rgba(165,219,93,0.06);
  border-left: 4px solid #A5DB5D;
  border-radius: 0 12px 12px 0;
  padding: 24px 28px;
  margin: 28px 0;
}
.guide-content :global(blockquote p) {
  color: #213621;
  font-style: italic;
  font-size: 16px;
  line-height: 1.7;
  margin-bottom: 0;
}
.guide-content :global(blockquote strong) {
  font-style: normal;
  display: block;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 2px;
  color: #8B9A7E;
  margin-bottom: 8px;
}

/* --- Horizontal Rules --- */
.guide-content :global(hr) {
  border: none;
  border-top: 1px solid rgba(33, 54, 33, 0.08);
  margin: 48px 0;
}

/* --- Tables --- */
.guide-content :global(table) {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  border-radius: 12px;
  overflow: hidden;
  margin: 28px 0;
  box-shadow: 0 1px 8px rgba(33, 54, 33, 0.06);
}
.guide-content :global(thead th) {
  background: #213621;
  color: #F5F0E8;
  padding: 14px 20px;
  font-family: 'Satoshi', sans-serif;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  text-align: left;
}
.guide-content :global(tbody td) {
  padding: 14px 20px;
  font-size: 15px;
  border-bottom: 1px solid rgba(33, 54, 33, 0.06);
  background: #fff;
  font-family: 'Satoshi', sans-serif;
}
.guide-content :global(tbody tr:last-child td) {
  border-bottom: none;
}

/* ========================================
   SPECIAL HTML-IN-MARKDOWN CARD COMPONENTS
   Authors can use these classes in guide markdown
   ======================================== */

/* --- Phase Section with Circle Badge --- */
.guide-content :global(.phase-section) {
  margin-top: 40px;
  padding-top: 40px;
  border-top: 1px solid rgba(33, 54, 33, 0.08);
}
.guide-content :global(.phase-section:first-of-type) {
  border-top: none;
  padding-top: 0;
  margin-top: 32px;
}
.guide-content :global(.phase-header) {
  display: flex;
  align-items: flex-start;
  gap: 20px;
  margin-bottom: 8px;
}
.guide-content :global(.phase-badge) {
  width: 52px;
  height: 52px;
  min-width: 52px;
  background: #A5DB5D;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Anton', sans-serif;
  font-size: 24px;
  color: #213621;
  margin-top: 2px;
}
.guide-content :global(.phase-header h2),
.guide-content :global(.phase-header h3) {
  font-family: 'Anton', sans-serif;
  font-size: 1.6rem;
  color: #213621;
  text-transform: uppercase;
  line-height: 1.15;
  letter-spacing: 0.5px;
  margin: 0;
  padding: 0;
  border: none;
}
.guide-content :global(.phase-title) {
  font-family: 'Anton', sans-serif;
  font-size: 1.6rem;
  color: #213621;
  text-transform: uppercase;
  line-height: 1.15;
  letter-spacing: 0.5px;
  margin: 0;
  border: none;
  padding: 0;
}
.guide-content :global(.phase-subtitle) {
  font-family: 'JetBrains Mono', monospace;
