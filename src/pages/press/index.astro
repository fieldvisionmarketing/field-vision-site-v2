---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const allPress = (await getCollection('press'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const title = "Press & Media, Field Vision | Field Vision";
const description = "Field Vision has been featured as an expert source in the Australian Financial Review, Covers, Daily Express, Birch, and other leading publications. Read his expert commentary on marketing strategy, entertainment, sports, and performance marketing.";
---
<BaseLayout title={title} description={description}>
  <Header slot="header" />
  <section class="press-hero">
    <div class="container">
      <span class="press-hero__label">Press & Media</span>
      <h1 class="press-hero__title">Featured In</h1>
      <p class="press-hero__subtitle">Expert commentary on marketing strategy, entertainment, sports, and performance, featured in leading international publications.</p>
    </div>
  </section>

  <section class="press-grid">
    <div class="container">
      <div class="press-grid__cards">
        {allPress.map((item) => (
          <a href={`/press/${item.slug}/`} class="press-card">
            <div class="press-card__pub">
              <span class="press-card__pub-name">{item.data.publication}</span>
              <time class="press-card__date" datetime={item.data.date.toISOString()}>
                {item.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
              </time>
            </div>
            <h2 class="press-card__title">{item.data.title}</h2>
            <p class="press-card__desc">{item.data.description}</p>
            <div class="press-card__meta">
              <span class="press-card__topic">{item.data.topic}</span>
              <span class="press-card__arrow">&rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>


  <!-- ═══ AWARDS & RECOGNITION ═══ -->
  <section class="awards-section" id="awards">
    <div class="container">
      <span class="awards-section__label">Awards & Recognition</span>
      <h2 class="awards-section__title">8 Clio Awards</h2>
      <p class="awards-section__subtitle">Award-winning marketing programs spanning live music, fan engagement, and brand innovation, recognized by the Clio Awards across two organizations and a decade of work.</p>

      <div class="awards-grid">

        <!-- Amazon Music Live (2026) -->
        <div class="award-card">
          <div class="award-card__year">2026</div>
          <span class="award-card__badge award-card__badge--silver">Silver</span>
          <h3 class="award-card__title">Amazon Music Live</h3>
          <p class="award-card__category">Category: Clio Music &bull; Fan Engagement</p>
          <p class="award-card__role">Role: Oversaw the live stream marketing department responsible for go-to-market activation for the concert series.</p>
          
        </div>

        <!-- Kendrick Lamar's The Pop Out (2026) -->
        <div class="award-card">
          <div class="award-card__year">2026</div>
          <span class="award-card__badge award-card__badge--bronze">Bronze</span>
          <h3 class="award-card__title">Kendrick Lamar's The Pop Out</h3>
          <p class="award-card__category">Category: Clio Music</p>
          <p class="award-card__role">Role: Led the growth marketing campaign that delivered the most viewed live stream in Amazon history.</p>
          
        </div>

        <!-- Alpine F1 Partnership (2026) -->
        <div class="award-card">
          <div class="award-card__year">2026</div>
          <span class="award-card__badge award-card__badge--bronze">Bronze</span>
          <h3 class="award-card__title">Alpine F1 Partnership</h3>
          <p class="award-card__category">Category: Clio Music</p>
          <p class="award-card__role">Role: Led go-to-market activation for the partnership through the live stream marketing department.</p>
          
        </div>

        <!-- TWICE (2026) -->
        <div class="award-card">
          <div class="award-card__year">2026</div>
          <span class="award-card__badge award-card__badge--bronze">Bronze</span>
          <h3 class="award-card__title">TWICE</h3>
          <p class="award-card__category">Category: Clio Music</p>
          <p class="award-card__role">Role: Led go-to-market activation for the campaign through the live stream marketing department.</p>
          
        </div>

        <!-- Amazon Music Live Season Two (2025) -->
        <div class="award-card">
          <div class="award-card__year">2025</div>
          <span class="award-card__badge award-card__badge--silver">Silver</span>
          <h3 class="award-card__title">Amazon Music Live Season Two</h3>
          <p class="award-card__category">Category: Clio Music &bull; Fan Engagement</p>
          <p class="award-card__role">Role: Oversaw the live stream marketing department responsible for go-to-market activation for each episode.</p>
          
        </div>

        <!-- Amazon Music Live Season One (2024) -->
        <div class="award-card">
          <div class="award-card__year">2024</div>
          <span class="award-card__badge award-card__badge--bronze">Bronze</span>
          <h3 class="award-card__title">Amazon Music Live Season One</h3>
          <p class="award-card__category">Category: Clio Music &bull; Fan Engagement</p>
          <p class="award-card__role">Role: Oversaw the live stream marketing department responsible for go-to-market activation for the concert series.</p>
          
        </div>

        <!-- Thumb Moments Silver (2015) -->
        <div class="award-card">
          <div class="award-card__year">2015</div>
          <span class="award-card__badge award-card__badge--silver">Silver</span>
          <h3 class="award-card__title">Thumb Moments</h3>
          <p class="award-card__category">Category: Clio Music &bull; Digital/Social, Brand</p>
          <p class="award-card__role">Role: Managed the customer-facing marketing channel strategy for the campaign, partnering between industry, brand, and product to execute at scale.</p>
          
        </div>

        <!-- Thumb Moments Bronze (2015) -->
        <div class="award-card">
          <div class="award-card__year">2015</div>
          <span class="award-card__badge award-card__badge--bronze">Bronze</span>
          <h3 class="award-card__title">Thumb Moments</h3>
          <p class="award-card__category">Category: Clio Music &bull; Audio/Radio</p>
          <p class="award-card__role">Role: Managed the customer-facing marketing channel strategy for the campaign, partnering between industry, brand, and product.</p>
          
        </div>

      </div>
    </div>
  </section>

  <!-- Schema.org structured data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Press & Media Features, Field Vision",
    "description": "Expert commentary and interviews featuring Field Vision in leading publications",
    "numberOfItems": allPress.length,
    "itemListElement": allPress.map((item, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "url": `https://fieldvisiongroup.com/press/${item.slug}`,
      "name": item.data.title
    }))
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Press & Media, Field Vision",
    "description": description,
    "url": "https://fieldvisiongroup.com/press",
    "isPartOf": {
      "@type": "WebSite",
      "name": "Field Vision",
      "url": "https://fieldvisiongroup.com"
    },
    "about": {
      "@type": "Person",
      "name": "Field Vision",
      "jobTitle": "Managing Director",
      "worksFor": {
        "@type": "Organization",
        "name": "Field Vision"
      }
    }
  })} />
    <Footer slot="footer" />
</BaseLayout>

<style>
  /* ── Press Hero ── */
  .press-hero {
    padding: clamp(6rem, 12vw, 10rem) 0 clamp(3rem, 6vw, 5rem);
    background: var(--offwhite);
    text-align: center;
  }

  .press-hero__label {
    display: inline-block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 1rem;
  }

  .press-hero__title {
    font-family: 'Anton', sans-serif;
    font-size: clamp(2.5rem, 6vw, 5rem);
    text-transform: uppercase;
    color: var(--ink);
    line-height: 1;
    margin: 0 0 1.25rem;
  }

  .press-hero__subtitle {
    font-family: 'Satoshi', sans-serif;
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    color: var(--muted);
    max-width: 640px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* ── Press Grid ── */
  .press-grid {
    padding: clamp(3rem, 6vw, 5rem) 0;
    background: var(--paper);
  }

  .press-grid__cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 380px), 1fr));
    gap: 2rem;
  }

  /* ── Press Card ── */
  .press-card {
    display: flex;
    flex-direction: column;
    padding: 2rem;
    border: 4px solid var(--ink);
    border-radius: 0;
    background: var(--paper);
    box-shadow: 6px 6px 0 var(--ink);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.3s ease, transform 0.3s ease, background 0.3s ease;
  }

  .press-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 8px 8px 0 var(--ink);
    background: var(--paper);
  }

  .press-card__pub {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .press-card__pub-name {
    font-family: 'Satoshi', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--green-dk);
  }

  .press-card__date {
    font-family: 'Satoshi', sans-serif;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .press-card__title {
    font-family: 'Anton', sans-serif;
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    text-transform: uppercase;
    color: var(--ink);
    line-height: 1.15;
    margin: 0 0 0.75rem;
  }

  .press-card__desc {
    font-family: 'Satoshi', sans-serif;
    font-size: 0.95rem;
    color: var(--muted);
    line-height: 1.6;
    flex-grow: 1;
    margin: 0 0 1.25rem;
  }

  .press-card__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 2px solid var(--ink);
  }

  .press-card__topic {
    font-family: 'Satoshi', sans-serif;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .press-card__arrow {
    font-size: 1.25rem;
    color: var(--green-dk);
    transition: transform 0.3s ease;
  }

  .press-card:hover .press-card__arrow {
    transform: translateX(4px);
  }

  /* ── Container ── */
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(1rem, 3vw, 2rem);
  }

  /* ── Awards & Recognition Section ── */
  .awards-section {
    padding: clamp(4rem, 8vw, 7rem) 0;
    background: var(--warm-gray);
    border-top: none;
  }

  .awards-section__label {
    display: inline-block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 1rem;
  }

  .awards-section__title {
    font-family: 'Anton', sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    text-transform: uppercase;
    color: var(--ink);
    line-height: 1.05;
    margin: 0.5rem 0 1rem;
  }

  .awards-section__subtitle {
    font-family: 'Satoshi', sans-serif;
    font-size: clamp(0.95rem, 1.2vw, 1.1rem);
    color: var(--muted);
    max-width: 640px;
    line-height: 1.6;
    margin-bottom: 3rem;
  }

  .awards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .award-card {
    padding: 1.5rem;
    border: 4px solid var(--ink);
    border-radius: 0;
    background: var(--paper);
    box-shadow: 6px 6px 0 var(--ink);
  }


  .award-card__year {
    font-family: 'Satoshi', sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }

  .award-card__badge {
    display: inline-block;
    font-family: 'Satoshi', sans-serif;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 3px 10px;
    border-radius: 0;
    margin-bottom: 0.75rem;
  }

  .award-card__badge--silver {
    background: var(--green-pale);
    color: var(--ink);
    border: 2px solid var(--ink);
  }

  .award-card__badge--bronze {
    background: var(--offwhite);
    color: var(--ink);
    border: 2px solid var(--ink);
  }

  .award-card__title {
    font-family: 'Anton', sans-serif;
    font-size: 1.1rem;
    text-transform: uppercase;
    color: var(--ink);
    line-height: 1.15;
    margin: 0 0 0.35rem;
  }

  .award-card__category {
    font-family: 'Satoshi', sans-serif;
    font-size: 0.75rem;
    color: var(--green-dk);
    margin-bottom: 0.75rem;
    line-height: 1.4;
  }

  .award-card__role {
    font-family: 'Satoshi', sans-serif;
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 1.55;
    margin-bottom: 0.75rem;
  }

  @media (max-width: 768px) {
    .awards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
