---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SocialProof from '@/components/SocialProof.astro';

/* ════════════════════════════════════════════════════════════
   WORK WITH ME — lead magnet landing page (v2)
   Route: /work-with-me
   Two free founder sessions: The Launch Audit + The Post-Mortem
   ════════════════════════════════════════════════════════════ */
const CTA_AUDIT = "/contact/?offer=launch-audit";
const CTA_POST = "/contact/?offer=post-mortem";
---

<BaseLayout
  title="Work With Me — Two Free Founder Sessions"
  description="Two free 1:1 sessions with a fractional CMO who's run growth at Twitch, Amazon, Pandora, and Hard Rock. The Launch Audit for a pre-launch read on your go-to-market, or The Post-Mortem to pinpoint what went wrong. Free for founders."
  ogImage="https://fieldvisiongroup.com/og-teardown.jpg"
>
  <Header slot="header" />

  <!-- ═══ HERO ═══ -->
  <section class="lm-hero">
    <div class="lm-hero-inner">
      <span class="lm-hero-pill">Free for founders</span>
      <h1 class="lm-title">Get a Free, <span class="hl-green">CMO-Level</span> Read on Your Marketing.</h1>
      <p class="lm-sub">Two free 1:1 sessions with a fractional CMO who's run growth at <strong>Twitch</strong>, <strong>Amazon</strong>, <strong>Pandora</strong>, and <strong>Hard Rock</strong>.</p>
      <p class="lm-pickline">Pick the one you need.</p>
      <p class="lm-scarcity">Only a <strong>handful of free sessions</strong> open each month.</p>
      <a href="#offers" class="lm-chevron" aria-label="Jump to the offers">↓</a>
    </div>
  </section>

  <!-- ═══ OFFERS ═══ -->
  <section class="lm-offers" id="offers">
    <div class="lm-offers-inner">
      <div class="lm-offers-head">
        <h2>Two ways in. Both on the house.</h2>
        <p>A free sample of what working together looks like. No pitch, no catch.</p>
      </div>
      <div class="lm-grid">

        <!-- Card 1 — The Launch Audit -->
        <a class="lm-card" href={CTA_AUDIT}>
          <div class="lm-card-head">
            <span class="lm-pill">Get it free</span>
            <span class="lm-kicker">Before the launch</span>
            <div class="lm-card-title">The Launch Audit</div>
            <p class="lm-freehint">A free sample of the work.</p>
          </div>
          <div class="lm-card-body">
            <p class="lm-oneliner">A pre-launch read on your go-to-market, so you <strong>land it, not fumble it.</strong></p>
            <div class="lm-forrow">
              <span class="lm-forlabel">For</span>
              <span class="lm-fortext">Founders with an important launch coming up who need a plan to land it.</span>
            </div>
            <p class="wyg-label">What you get</p>
            <ul class="wyg-list">
              <li class="wyg-item"><span class="wyg-check">✓</span>Strategy</li>
              <li class="wyg-item"><span class="wyg-check">✓</span>Tool stack</li>
              <li class="wyg-item"><span class="wyg-check">✓</span>Tracking &amp; measurement</li>
              <li class="wyg-item"><span class="wyg-check">✓</span>Blind spots</li>
            </ul>
          </div>
          <div class="lm-card-foot"><span class="lm-card-cta">Claim the Launch Audit →</span></div>
        </a>

        <!-- Card 2 — The Post-Mortem -->
        <a class="lm-card" href={CTA_POST}>
          <div class="lm-card-head">
            <span class="lm-pill">Get it free</span>
            <span class="lm-kicker">After the launch</span>
            <div class="lm-card-title">The Post-Mortem</div>
            <p class="lm-freehint">A free sample of the work.</p>
          </div>
          <div class="lm-card-body">
            <p class="lm-oneliner">A seasoned second pair of eyes to pinpoint the mistake and your next move. <strong>Your secret's safe.</strong></p>
            <div class="lm-forrow">
              <span class="lm-forlabel">For</span>
              <span class="lm-fortext">Founders who took a marketing "L," a bad hire, AI leading you astray, or something else.</span>
            </div>
            <p class="wyg-label">What you get</p>
            <ul class="wyg-list">
              <li class="wyg-item"><span class="wyg-check">✓</span>The exact mistake</li>
              <li class="wyg-item"><span class="wyg-check">✓</span>How to avoid it next time</li>
              <li class="wyg-item"><span class="wyg-check">✓</span>What to do next</li>
            </ul>
          </div>
          <div class="lm-card-foot"><span class="lm-card-cta">Claim the Post-Mortem →</span></div>
        </a>

      </div>
    </div>
  </section>

  <!-- ═══ HOW IT WORKS ═══ -->
  <section class="lm-how">
    <div class="lm-how-inner">
      <div class="lm-how-head">
        <span class="eyebrow">Fifteen minutes, zero fluff</span>
        <h2>How it works</h2>
      </div>
      <div class="lm-how-grid">
        <div class="lm-step">
          <div class="lm-step-num">01</div>
          <div class="lm-step-title">Book your session</div>
          <p class="lm-step-desc">Pick the audit or the post-mortem and grab a free 1:1 slot. One founder per slot.</p>
        </div>
        <div class="lm-step">
          <div class="lm-step-num">02</div>
          <div class="lm-step-title">We dig into it</div>
          <p class="lm-step-desc">Bring your launch or your loss. We go straight at what's working, what isn't, and why.</p>
        </div>
        <div class="lm-step">
          <div class="lm-step-num">03</div>
          <div class="lm-step-title">You leave with a plan</div>
          <p class="lm-step-desc">Walk away with the one or two moves that actually change the outcome. Yours to keep.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ TRUSTED BY (reused homepage band) ═══ -->
  <SocialProof />

  <!-- ═══ ABOUT DAVID ═══ -->
  <section class="lm-about">
    <div class="lm-about-inner">
      <img class="lm-about-img" src="/headshot-david-hampian.jpg" alt="David Hampian, founder of Field Vision" width="260" height="260" />
      <div class="lm-about-text">
        <span class="eyebrow">About David Hampian</span>
        <h2 class="lm-about-name">A marketing exec who's run growth at the biggest names in media.</h2>
        <p class="lm-about-bio">Over a decade of senior marketing leadership at <strong>Twitch</strong>, <strong>Amazon</strong>, <strong>Pandora</strong>, and <strong>Hard Rock International</strong>. Built and scaled growth, lifecycle, content, and integrated marketing for products serving hundreds of millions of people. Now the founder of Field Vision.</p>
        <p class="lm-about-bio">Sit down for a session and get an honest read on your marketing. What's working, what's not, and the one or two plays that move the needle next.</p>
        <div class="lm-creds">
          <span class="lm-cred">Ex-Twitch</span>
          <span class="lm-cred">Ex-Amazon</span>
          <span class="lm-cred">Ex-Pandora</span>
          <span class="lm-cred">Ex-Hard Rock</span>
          <span class="lm-cred">8 Clio Awards</span>
          <span class="lm-cred">UC Berkeley Haas Lecturer</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ ABOUT FIELD VISION ═══ -->
  <section class="lm-fv section-dark">
    <div class="lm-fv-inner">
      <div>
        <span class="eyebrow">About Field Vision</span>
        <h2 class="lm-fv-title">Growth Without <span class="hl-green">Guesswork.</span></h2>
        <p class="lm-fv-copy">Field Vision is the fractional CMO firm for startups in <strong>digital media, streaming, entertainment, and the creator economy.</strong> Senior marketing leadership embedded in your team, without the full-time hire.</p>
        <p class="lm-fv-copy">Every engagement runs on <strong>ABCT</strong>, our proprietary model. We build systems that outlast the engagement, then hand you the keys.</p>
      </div>
      <div class="lm-abct">
        <p class="lm-abct-label">The ABCT Framework</p>
        <div class="lm-abct-row"><span class="lm-abct-letter">A</span><div><div class="lm-abct-word">Audit</div><div class="lm-abct-desc">Diagnose what's really going on.</div></div></div>
        <div class="lm-abct-row"><span class="lm-abct-letter">B</span><div><div class="lm-abct-word">Blueprint</div><div class="lm-abct-desc">Strategy, positioning, and the plan.</div></div></div>
        <div class="lm-abct-row"><span class="lm-abct-letter">C</span><div><div class="lm-abct-word">Construct</div><div class="lm-abct-desc">Build the systems and the team.</div></div></div>
        <div class="lm-abct-row"><span class="lm-abct-letter">T</span><div><div class="lm-abct-word">Transfer</div><div class="lm-abct-desc">Clean handoff. You run it from here.</div></div></div>
      </div>
    </div>
  </section>

  <!-- ═══ FINAL CTA ═══ -->
  <section class="lm-final">
    <span class="eyebrow">Free for founders</span>
    <h2 class="lm-final-title">Pick your <span class="hl-green">session.</span></h2>
    <p class="lm-final-sub">Before the launch or after the loss. Either way, you leave with a plan. A few free slots open each month.</p>
    <div class="lm-final-btns">
      <a href={CTA_AUDIT} class="btn-brutal">The Launch Audit →</a>
      <a href={CTA_POST} class="btn-brutal">The Post-Mortem →</a>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* ── HERO ── */
  .lm-hero { background: var(--paper); padding: 132px 24px 48px; text-align: center; border-bottom: 4px solid var(--ink); }
  .lm-hero-inner { max-width: 900px; margin: 0 auto; }
  .lm-hero-pill {
    display: inline-block; font-family: 'JetBrains Mono', monospace;
    font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em;
    color: var(--ink); background: var(--green-lt); border: 3px solid var(--ink);
    box-shadow: 4px 4px 0 var(--ink); padding: 7px 16px 8px; margin-bottom: 26px; transform: rotate(-1.5deg);
  }
  .lm-title {
    font-family: 'Anton', sans-serif; font-size: clamp(44px, 7.2vw, 96px);
    line-height: 0.96; text-transform: uppercase; color: var(--ink); letter-spacing: 0.01em;
  }
  .lm-title .hl-green { transform: rotate(-1.6deg); }
  .lm-sub {
    font-family: 'Satoshi', sans-serif; font-weight: 500;
    font-size: clamp(17px, 2vw, 22px); color: var(--muted);
    max-width: 620px; margin: 30px auto 0; line-height: 1.5;
  }
  .lm-sub strong { color: var(--ink); }
  .lm-pickline {
    font-family: 'Anton', sans-serif; font-size: clamp(20px, 2.6vw, 30px);
    text-transform: uppercase; color: var(--ink); margin-top: 26px; letter-spacing: 0.02em;
  }
  .lm-scarcity {
    margin-top: 20px; font-family: 'JetBrains Mono', monospace; font-size: 12.5px;
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted);
  }
  .lm-scarcity strong { color: var(--green-dk); }
  .lm-chevron {
    display: inline-block; font-family: 'JetBrains Mono', monospace; font-size: 24px;
    color: var(--muted); margin-top: 30px; animation: lm-bounce 1.8s ease-in-out infinite;
  }
  @keyframes lm-bounce { 0%,100% { transform: translateY(0); opacity: .4; } 50% { transform: translateY(8px); opacity: 1; } }

  /* ── OFFERS ── */
  .lm-offers { background: var(--warm-gray); padding: 72px 24px 80px; }
  .lm-offers-inner { max-width: 1080px; margin: 0 auto; }
  .lm-offers-head { text-align: center; margin-bottom: 44px; }
  .lm-offers-head h2 { font-family: 'Anton', sans-serif; font-size: clamp(28px, 3.6vw, 46px); text-transform: uppercase; color: var(--ink); line-height: 1.04; }
  .lm-offers-head p { color: var(--muted); font-size: 17px; margin-top: 12px; }
  .lm-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
  .lm-card {
    display: flex; flex-direction: column; background: var(--paper);
    border: 4px solid var(--ink); box-shadow: 8px 8px 0 var(--ink);
    transition: transform .18s, box-shadow .18s; overflow: hidden;
  }
  .lm-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 11px 11px 0 var(--ink), 0 0 30px rgba(165,219,93,.55), 0 0 60px rgba(165,219,93,.2);
  }
  .lm-card-head { background: var(--ink); padding: 26px 28px 30px; position: relative; }
  .lm-kicker { font-family: 'Roboto', sans-serif; font-size: 13px; font-weight: 600; color: var(--green-lt); margin-bottom: 14px; display: block; }
  .lm-pill {
    position: absolute; top: 24px; right: 26px;
    font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;
    background: var(--green-lt); color: var(--ink); border: 3px solid var(--offwhite);
    box-shadow: 3px 3px 0 rgba(0,0,0,.35); padding: 6px 12px 7px; transform: rotate(2deg);
  }
  .lm-card-title {
    font-family: 'Anton', sans-serif; font-size: clamp(38px, 4.6vw, 60px);
    line-height: 0.94; text-transform: uppercase; color: var(--offwhite); letter-spacing: 0.01em;
  }
  .lm-freehint { margin-top: 12px; font-family: 'Permanent Marker', cursive; font-size: 16px; color: var(--green-lt); }
  .lm-card-body { padding: 26px 28px 8px; flex: 1; display: flex; flex-direction: column; }
  .lm-oneliner { font-size: 17px; color: var(--muted); line-height: 1.55; font-weight: 500; }
  .lm-oneliner strong { color: var(--ink); }
  .lm-forrow { display: flex; gap: 12px; align-items: baseline; margin: 22px 0 8px; padding-top: 20px; border-top: 2px solid rgba(33,54,33,.12); }
  .lm-forlabel { font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--green-dk); flex-shrink: 0; }
  .lm-fortext { font-size: 14.5px; color: var(--muted); line-height: 1.5; }
  .wyg-label { font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--green-dk); margin: 20px 0 14px; }
  .wyg-list { display: flex; flex-direction: column; gap: 11px; list-style: none; }
  .wyg-item { display: flex; align-items: center; gap: 12px; font-size: 16px; font-weight: 600; color: var(--ink); }
  .wyg-check { flex-shrink: 0; width: 26px; height: 26px; background: var(--green-lt); border: 3px solid var(--ink); display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 900; color: var(--ink); box-shadow: 2px 2px 0 var(--ink); }
  .lm-card-foot { margin-top: auto; padding: 22px 28px 26px; border-top: 4px solid var(--ink); }
  .lm-card-cta { font-family: 'JetBrains Mono', monospace; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink); display: inline-flex; align-items: center; gap: 8px; }
  .lm-card:hover .lm-card-cta { color: var(--green-dk); }

  /* ── HOW IT WORKS ── */
  .lm-how { background: var(--paper); padding: 72px 24px; border-top: 4px solid var(--ink); }
  .lm-how-inner { max-width: 1040px; margin: 0 auto; }
  .lm-how-head { text-align: center; margin-bottom: 40px; }
  .lm-how-head h2 { font-family: 'Anton', sans-serif; font-size: clamp(28px, 3.6vw, 46px); text-transform: uppercase; color: var(--ink); }
  .lm-how-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .lm-step { background: var(--offwhite); border: 4px solid var(--ink); box-shadow: 8px 8px 0 var(--ink); padding: 26px 24px; }
  .lm-step-num { font-family: 'Anton', sans-serif; font-size: 40px; line-height: 1; color: var(--green-dk); }
  .lm-step-title { font-family: 'Anton', sans-serif; font-size: 22px; text-transform: uppercase; color: var(--ink); margin: 10px 0 8px; line-height: 1.05; }
  .lm-step-desc { font-size: 15px; color: var(--muted); line-height: 1.55; }

  /* ── ABOUT DAVID ── */
  .lm-about { background: var(--paper); padding: 84px 24px; }
  .lm-about-inner { max-width: 1000px; margin: 0 auto; display: grid; grid-template-columns: 260px 1fr; gap: 48px; align-items: center; }
  .lm-about-img { width: 260px; height: 260px; object-fit: cover; border: 4px solid var(--ink); box-shadow: 10px 10px 0 var(--green-lt); }
  .lm-about-name { font-family: 'Anton', sans-serif; font-size: clamp(26px, 3.4vw, 40px); text-transform: uppercase; color: var(--ink); line-height: 1.05; margin: 6px 0 18px; }
  .lm-about-bio { font-size: clamp(15px, 1.7vw, 18px); color: var(--muted); line-height: 1.6; margin-bottom: 14px; }
  .lm-about-bio strong { color: var(--ink); }
  .lm-creds { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 22px; }
  .lm-cred { font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink); background: var(--offwhite); border: 3px solid var(--ink); box-shadow: 3px 3px 0 var(--ink); padding: 7px 12px; }

  /* ── ABOUT FIELD VISION ── */
  .lm-fv { padding: 84px 24px; }
  .lm-fv-inner { max-width: 1000px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
  .lm-fv-title { font-family: 'Anton', sans-serif; font-size: clamp(30px, 4vw, 50px); text-transform: uppercase; color: var(--paper); line-height: 1.02; margin: 6px 0 20px; }
  .lm-fv-title .hl-green { color: var(--ink); }
  .lm-fv-copy { font-size: clamp(15px, 1.7vw, 18px); color: rgba(255,255,255,.82); line-height: 1.65; margin-bottom: 16px; }
  .lm-fv-copy strong { color: var(--offwhite); }
  .lm-abct { border: 4px solid var(--offwhite); box-shadow: 8px 8px 0 rgba(165,219,93,.5); padding: 28px 26px; background: rgba(255,255,255,.03); }
  .lm-abct-label { font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--green-lt); margin-bottom: 16px; }
  .lm-abct-row { display: flex; gap: 14px; align-items: baseline; padding: 12px 0; border-bottom: 1px solid rgba(255,255,255,.12); }
  .lm-abct-row:last-child { border-bottom: none; }
  .lm-abct-letter { font-family: 'Anton', sans-serif; font-size: 30px; color: var(--green-lt); width: 34px; flex-shrink: 0; line-height: 1; }
  .lm-abct-word { font-family: 'Anton', sans-serif; font-size: 17px; text-transform: uppercase; color: var(--paper); letter-spacing: 0.02em; }
  .lm-abct-desc { font-size: 13.5px; color: rgba(255,255,255,.7); margin-top: 2px; }

  /* ── FINAL CTA ── */
  .lm-final { background: var(--offwhite); padding: 88px 24px; text-align: center; border-top: 4px solid var(--ink); }
  .lm-final-title { font-family: 'Anton', sans-serif; font-size: clamp(38px, 6vw, 74px); text-transform: uppercase; color: var(--ink); line-height: 0.98; }
  .lm-final-sub { margin: 18px auto 0; max-width: 560px; font-size: clamp(15px, 1.8vw, 18px); color: var(--muted); line-height: 1.55; }
  .lm-final-btns { display: flex; gap: 18px; justify-content: center; flex-wrap: wrap; margin-top: 34px; }

  /* ── RESPONSIVE ── */
  @media (max-width: 860px) {
    .lm-grid { grid-template-columns: 1fr; }
    .lm-how-grid { grid-template-columns: 1fr; }
    .lm-about-inner { grid-template-columns: 1fr; justify-items: center; text-align: center; }
    .lm-creds { justify-content: center; }
    .lm-fv-inner { grid-template-columns: 1fr; }
    .lm-pill { position: static; display: inline-block; margin-bottom: 14px; transform: rotate(-1.5deg); }
  }
</style>
