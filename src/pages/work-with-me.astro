---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import SocialProof from '@/components/SocialProof.astro';

/* ════════════════════════════════════════════════════════════
   WORK WITH ME — lead magnet landing page (v2)
   Route: /work-with-me
   Two free founder sessions: The Launch Audit + The Post-Mortem
   ════════════════════════════════════════════════════════════ */
const CTA_AUDIT = "/contact/?offer=launch-audit";
const CTA_POST = "/contact/?offer=post-mortem";
---

<BaseLayout
  title="Work With Me — Two Free Founder Sessions"
  description="Two free 1:1 sessions with a fractional CMO who built the first marketing teams at Twitch, Pandora, and Amazon. The Launch Audit for a pre-launch read on your go-to-market, or The Post-Mortem to pinpoint what went wrong. Free for founders."
  ogImage="https://fieldvisiongroup.com/og-teardown.jpg"
>
  <Header slot="header" />

  <!-- ═══ HERO ═══ -->
  <section class="lm-hero">
    <div class="lm-hero-inner">
      <span class="lm-hero-pill">Free for founders</span>
      <h1 class="lm-title">Get a <span class="hl-green">Free</span> CMO-Level Read on Your Marketing.</h1>
      <p class="lm-sub">Two free 1:1 sessions with the guy who built the first marketing teams at <strong>Twitch</strong>, <strong>Pandora</strong>, <strong>Amazon</strong>, and your other favorite start-ups.</p>
      <p class="lm-pickline">Pick the one you need.</p>
      <a href="#offers" class="lm-chevron" aria-label="Jump to the offers">↓</a>
    </div>
  </section>

  <!-- ═══ OFFERS ═══ -->
  <section class="lm-offers" id="offers">
    <div class="lm-offers-inner">
      <div class="lm-grid">

        <!-- Card 1 — The Launch Audit -->
        <a class="lm-card" href={CTA_AUDIT}>
          <div class="lm-card-head">
            <div class="lm-card-title">The Launch Audit</div>
          </div>
          <div class="lm-card-body">
            <div class="lm-block">
              <span class="lm-block-label">For</span>
              <p class="lm-block-text">Founders who have an important upcoming launch and need a marketing plan to land it.</p>
            </div>
            <div class="lm-block">
              <span class="lm-block-label">What</span>
              <p class="lm-block-text">I'll tell you what pieces are in place and where the gaps are. <strong>Strategy, tool stack, tracking and measurement, and potential blind spots.</strong></p>
            </div>
            <div class="lm-block">
              <span class="lm-block-label">Why me</span>
              <p class="lm-block-text">I've run high-stakes GTM at both start-ups and Fortune 500 brands. Amazon's first AI launch. Hard Rock Bet's national GTM. Thursday Night Football, and more.</p>
            </div>
          </div>
          <div class="lm-card-foot"><span class="lm-card-cta">Claim the Launch Audit →</span></div>
        </a>

        <!-- Card 2 — The Post-Mortem -->
        <a class="lm-card" href={CTA_POST}>
          <div class="lm-card-head">
            <div class="lm-card-title">The Post-Mortem</div>
          </div>
          <div class="lm-card-body">
            <div class="lm-block">
              <span class="lm-block-label">For</span>
              <p class="lm-block-text">Founders who know their marketing went sideways. A bad hire. AI leading you astray. Or something else (your secret is safe).</p>
            </div>
            <div class="lm-block">
              <span class="lm-block-label">What</span>
              <p class="lm-block-text">I'll be your seasoned, second pair of eyes. We'll pinpoint the exact mistake, how to avoid it moving forward, and what you should do next.</p>
            </div>
            <div class="lm-block">
              <span class="lm-block-label">Why me</span>
              <p class="lm-block-text">I built the first marketing teams at Pandora, Twitch, Amazon Entertainment, and more. There isn't a mistake I haven't encountered and had to fix, fast.</p>
            </div>
          </div>
          <div class="lm-card-foot"><span class="lm-card-cta">Claim the Post-Mortem →</span></div>
        </a>

      </div>
    </div>
  </section>

  <!-- ═══ TRUSTED BY (reused homepage band) ═══ -->
  <SocialProof />

  <!-- ═══ ABOUT DAVID (Field Vision woven in) ═══ -->
  <section class="lm-about">
    <div class="lm-about-inner">
      <img class="lm-about-img" src="/headshot-david-hampian.jpg" alt="David Hampian, founder of Field Vision" width="260" height="260" />
      <div class="lm-about-text">
        <h2 class="lm-about-name">A CMO Who Turns Start-Ups Into Household Names.</h2>
        <p class="lm-about-bio">I've spent over a decade leading marketing at <strong>Twitch</strong>, <strong>Amazon</strong>, <strong>Pandora</strong>, and <strong>Hard Rock</strong>, building and scaling the first marketing teams behind products used by hundreds of millions of people.</p>
        <p class="lm-about-bio">Today I run <strong>Field Vision</strong>, the fractional CMO firm for startups in digital media, streaming, entertainment, and the creator economy. You get senior marketing leadership embedded in your team, without the full-time hire.</p>
      </div>
    </div>
  </section>

  <!-- ═══ HOW IT WORKS ═══ -->
  <section class="lm-how section-dark">
    <div class="lm-how-inner">
      <div class="lm-how-head">
        <h2>How it works</h2>
      </div>
      <div class="lm-how-grid">
        <div class="lm-step">
          <div class="lm-step-num">01</div>
          <div class="lm-step-title">Book your session</div>
          <p class="lm-step-desc">Pick the audit or the post-mortem and grab a free 1:1 slot. One founder per slot.</p>
        </div>
        <div class="lm-step">
          <div class="lm-step-num">02</div>
          <div class="lm-step-title">We dig into it</div>
          <p class="lm-step-desc">Bring your launch or your challenge. We go straight at what's working, what isn't, and why.</p>
        </div>
        <div class="lm-step">
          <div class="lm-step-num">03</div>
          <div class="lm-step-title">You leave with a plan</div>
          <p class="lm-step-desc">Walk away with the one or two moves that actually change the outcome. Yours to keep.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ FINAL CTA ═══ -->
  <section class="lm-final">
    <h2 class="lm-final-title">Book Your <span class="hl-green">Free</span> Session.</h2>
    <p class="lm-final-sub">Before a big launch or after something went sideways, you leave with a plan.</p>
    <div class="lm-final-btns">
      <a href={CTA_AUDIT} class="btn-brutal">The Launch Audit →</a>
      <a href={CTA_POST} class="btn-brutal">The Post-Mortem →</a>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* ── HERO ── */
  .lm-hero { background: var(--paper); padding: 132px 24px 52px; text-align: center; border-bottom: 4px solid var(--ink); }
  .lm-hero-inner { max-width: 900px; margin: 0 auto; }
  .lm-hero-pill {
    display: inline-block; font-family: 'JetBrains Mono', monospace;
    font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em;
    color: var(--ink); background: var(--green-lt); border: 3px solid var(--ink);
    box-shadow: 4px 4px 0 var(--ink); padding: 7px 16px 8px; margin-bottom: 30px; transform: rotate(-1.5deg);
  }
  .lm-title {
    font-family: 'Anton', sans-serif; font-size: clamp(42px, 6.2vw, 80px);
    line-height: 1.14; text-transform: uppercase; color: var(--ink); letter-spacing: 0.01em;
    max-width: 860px; margin: 0 auto;
  }
  .lm-title .hl-green { transform: rotate(-1.6deg); margin: 0 6px; }
  .lm-sub {
    font-family: 'Satoshi', sans-serif; font-weight: 500;
    font-size: clamp(17px, 2vw, 22px); color: var(--muted);
    max-width: 640px; margin: 32px auto 0; line-height: 1.55;
  }
  .lm-sub strong { color: var(--ink); }
  .lm-pickline {
    font-family: 'Anton', sans-serif; font-size: clamp(20px, 2.6vw, 30px);
    text-transform: uppercase; color: var(--ink); margin-top: 28px; letter-spacing: 0.02em;
  }
  .lm-chevron {
    display: inline-block; font-family: 'JetBrains Mono', monospace; font-size: 24px;
    color: var(--muted); margin-top: 30px; animation: lm-bounce 1.8s ease-in-out infinite;
  }
  @keyframes lm-bounce { 0%,100% { transform: translateY(0); opacity: .4; } 50% { transform: translateY(8px); opacity: 1; } }

  /* ── OFFERS ── */
  .lm-offers { background: var(--warm-gray); padding: 72px 24px 80px; }
  .lm-offers-inner { max-width: 1080px; margin: 0 auto; }
  .lm-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
  .lm-card {
    display: flex; flex-direction: column; background: var(--paper);
    border: 4px solid var(--ink); box-shadow: 8px 8px 0 var(--ink);
    transition: transform .18s, box-shadow .18s; overflow: hidden;
  }
  .lm-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 11px 11px 0 var(--ink), 0 0 30px rgba(165,219,93,.55), 0 0 60px rgba(165,219,93,.2);
  }
  .lm-card-head { background: var(--ink); padding: 26px 28px 30px; }
  .lm-card-title {
    font-family: 'Anton', sans-serif; font-size: clamp(38px, 4.6vw, 58px);
    line-height: 0.94; text-transform: uppercase; color: var(--offwhite); letter-spacing: 0.01em;
  }
  .lm-card-body { padding: 26px 28px 8px; flex: 1; }
  .lm-block { margin-bottom: 22px; }
  .lm-block:last-child { margin-bottom: 0; }
  .lm-block-label { display: block; font-family: 'JetBrains Mono', monospace; font-size: 12px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink); margin-bottom: 7px; }
  .lm-block-text { font-size: 15px; color: var(--muted); line-height: 1.55; }
  .lm-block-text strong { color: var(--ink); font-weight: 700; }
  .lm-card-foot { margin-top: auto; padding: 24px 28px 28px; border-top: 4px solid var(--ink); }
  .lm-card-cta {
    display: inline-block; font-family: 'Anton', sans-serif; font-size: 14px;
    text-transform: uppercase; letter-spacing: 0.03em; padding: 13px 22px;
    background: var(--green-lt); color: var(--ink); border: 4px solid var(--ink);
    box-shadow: 6px 6px 0 var(--ink); transition: transform .15s, box-shadow .15s;
  }
  .lm-card:hover .lm-card-cta { transform: translate(-2px, -2px); box-shadow: 8px 8px 0 var(--ink); }

  /* ── ABOUT DAVID ── */
  .lm-about { background: var(--paper); padding: 84px 24px; border-top: 4px solid var(--ink); }
  .lm-about-inner { max-width: 1000px; margin: 0 auto; display: grid; grid-template-columns: 260px 1fr; gap: 48px; align-items: center; }
  .lm-about-img { width: 260px; height: 260px; object-fit: cover; border: 4px solid var(--ink); box-shadow: 10px 10px 0 var(--green-lt); }
  .lm-about-name { font-family: 'Anton', sans-serif; font-size: clamp(28px, 3.6vw, 44px); text-transform: uppercase; color: var(--ink); line-height: 1.04; margin: 0 0 20px; }
  .lm-about-bio { font-size: clamp(15px, 1.7vw, 18px); color: var(--muted); line-height: 1.6; margin-bottom: 14px; }
  .lm-about-bio strong { color: var(--ink); }

  /* ── HOW IT WORKS (dark) ── */
  .lm-how { padding: 80px 24px; border-top: 4px solid var(--ink); }
  .lm-how-inner { max-width: 1040px; margin: 0 auto; }
  .lm-how-head { text-align: center; margin-bottom: 44px; }
  .lm-how-head h2 { font-family: 'Anton', sans-serif; font-size: clamp(28px, 3.6vw, 46px); text-transform: uppercase; color: var(--paper); }
  .lm-how-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .lm-step { background: var(--paper); border: 4px solid var(--ink); box-shadow: 8px 8px 0 var(--green-lt); padding: 26px 24px; }
  .lm-step-num { font-family: 'Anton', sans-serif; font-size: 42px; line-height: 1; color: var(--green-dk); }
  .lm-step-title { font-family: 'Anton', sans-serif; font-size: 22px; text-transform: uppercase; color: var(--ink); margin: 10px 0 8px; line-height: 1.05; }
  .lm-step-desc { font-size: 15px; color: var(--muted); line-height: 1.55; }

  /* ── FINAL CTA ── */
  .lm-final { background: var(--offwhite); padding: 88px 24px; text-align: center; border-top: 4px solid var(--ink); }
  .lm-final-title { font-family: 'Anton', sans-serif; font-size: clamp(38px, 6vw, 74px); text-transform: uppercase; color: var(--ink); line-height: 1.06; }
  .lm-final-title .hl-green { margin: 0 6px; }
  .lm-final-sub { margin: 18px auto 0; max-width: 560px; font-size: clamp(15px, 1.8vw, 18px); color: var(--muted); line-height: 1.55; }
  .lm-final-btns { display: flex; gap: 18px; justify-content: center; flex-wrap: wrap; margin-top: 34px; }

  /* ── RESPONSIVE ── */
  @media (max-width: 860px) {
    .lm-grid { grid-template-columns: 1fr; }
    .lm-how-grid { grid-template-columns: 1fr; }
    .lm-about-inner { grid-template-columns: 1fr; justify-items: center; text-align: center; }
  }
</style>
